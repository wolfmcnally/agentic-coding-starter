#!/usr/bin/env bash
# Canonical repository build-gate entry point.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_root="$repo_root/project"

usage() {
  cat <<'EOF'
Usage: ./bin/check [all|lint|format|test|policy]

Run the repository's authoritative build gates. The default mode is "all".
EOF
}

if [[ $# -gt 1 ]]; then
  usage >&2
  exit 2
fi

gate_mode="${1:-all}"
case "$gate_mode" in
  all|lint|format|test|policy) ;;
  --help|-h)
    usage
    exit 0
    ;;
  *)
    echo "CHECK ERROR unknown mode: $gate_mode" >&2
    usage >&2
    exit 2
    ;;
esac

toolchain_helper="$repo_root/bin/_python-toolchain"
if [[ ! -r "$toolchain_helper" ]]; then
  echo "CHECK ERROR missing required file: bin/_python-toolchain" >&2
  exit 1
fi
source "$toolchain_helper"
python_toolchain_init CHECK

if [[ ! -x "$repo_root/bin/test" ]]; then
  echo "CHECK ERROR missing required executable: bin/test" >&2
  exit 1
fi

for evidence_executable in \
  kickoff-tree-id kickoff-evidence kickoff-config execution-telemetry \
  check-execution-dashboards check-harness-parity check-toolchain-callers \
  lessons check-catalogs check-shell-syntax new-name; do
  if [[ ! -x "$repo_root/bin/$evidence_executable" ]]; then
    echo "CHECK ERROR missing required executable: bin/$evidence_executable" >&2
    exit 1
  fi
done

run_gate() {
  local gate_name="$1"
  shift
  echo "CHECK $gate_name START"
  if "$@"; then
    echo "CHECK $gate_name PASS"
  else
    local command_exit=$?
    echo "CHECK $gate_name FAIL (exit $command_exit)" >&2
    return "$command_exit"
  fi
}

run_lint() {
  (
    cd "$project_root"
    run_gate lint uv run --locked "${python_toolchain_uv_args[@]}" ruff check \
      example tests ../lib ../bin/kickoff-config ../bin/kickoff-evidence \
      ../bin/kickoff-tree-id ../bin/execution-telemetry \
      ../bin/check-execution-dashboards ../bin/check-harness-parity \
      ../bin/check-toolchain-callers ../bin/lessons ../bin/check-catalogs \
      ../bin/check-shell-syntax ../bin/new-name \
      ../tests
  )
}

run_format() {
  (
    cd "$project_root"
    run_gate format uv run --locked "${python_toolchain_uv_args[@]}" ruff format --check \
      example tests ../lib ../bin/kickoff-config ../bin/kickoff-evidence \
      ../bin/kickoff-tree-id ../bin/execution-telemetry \
      ../bin/check-execution-dashboards ../bin/check-harness-parity \
      ../bin/check-toolchain-callers ../bin/lessons ../bin/check-catalogs \
      ../bin/check-shell-syntax ../bin/new-name \
      ../tests
  )
}

run_test() {
  run_gate test "$repo_root/bin/test"
}

run_policy() {
  (
    cd "$repo_root"
    run_gate policy-harness-parity ./bin/check-harness-parity
    run_gate policy-toolchain-callers ./bin/check-toolchain-callers
    run_gate policy-execution-dashboards ./bin/check-execution-dashboards
    run_gate policy-config ./bin/kickoff-config show
    run_gate policy-catalogs ./bin/check-catalogs
    run_gate policy-lessons ./bin/lessons validate
    run_gate policy-shell-syntax ./bin/check-shell-syntax
    run_gate policy-anonymization ./bin/check-anonymization.sh
    echo "CHECK policy PASS"
  )
}

cd "$repo_root"
python_toolchain_probe

case "$gate_mode" in
  lint) run_lint ;;
  format) run_format ;;
  test) run_test ;;
  policy) run_policy ;;
  all)
    run_lint
    run_format
    run_test
    run_policy
    echo "CHECK ALL PASS"
    ;;
esac
