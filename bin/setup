#!/usr/bin/env bash
# Provision the repository's locked development environment.

set -euo pipefail

entrypoint_path="${BASH_SOURCE[0]}"
while [[ -L "$entrypoint_path" ]]; do
  entrypoint_dir="$(cd "$(dirname "$entrypoint_path")" && pwd)"
  entrypoint_path="$(readlink "$entrypoint_path")"
  [[ "$entrypoint_path" == /* ]] || entrypoint_path="$entrypoint_dir/$entrypoint_path"
done
repo_root="$(cd "$(dirname "$entrypoint_path")/.." && pwd)"
project_root="$repo_root/project"

usage() {
  cat <<'EOF'
Usage: ./bin/setup

Provision the repository's pinned, locked development environment.
EOF
}

if [[ $# -gt 0 ]]; then
  case "${1:-}" in
    --help|-h)
      if [[ $# -eq 1 ]]; then
        usage
        exit 0
      fi
      ;;
  esac
  usage >&2
  exit 2
fi

toolchain_helper="$repo_root/bin/_python-toolchain"
if [[ ! -r "$toolchain_helper" ]]; then
  echo "SETUP ERROR missing required file: bin/_python-toolchain" >&2
  exit 1
fi
source "$toolchain_helper"
python_toolchain_init SETUP

echo "SETUP START"
cd "$repo_root"
if uv sync --project "$project_root" --locked "${python_toolchain_uv_args[@]}"; then
  if python_toolchain_probe; then
    echo "SETUP PASS"
  else
    command_exit=$?
    echo "SETUP FAIL (exit $command_exit)" >&2
    exit "$command_exit"
  fi
else
  command_exit=$?
  echo "SETUP FAIL (exit $command_exit)" >&2
  exit "$command_exit"
fi
