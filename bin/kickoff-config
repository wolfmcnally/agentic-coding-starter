SEARCH_CAPABLE_ROLES = frozenset({"planner", "reviewer"})
# The roles that emit a Finding Evidence document, and the review kind each one
# reviews. Only these dispatches carry a structured-output schema; the planner
# and coder emit different artifacts entirely.
