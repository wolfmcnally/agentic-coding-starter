#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["ruamel.yaml>=0.18,<0.19"]
# ///
"""Validate, edit, and enforce the human-editable kickoff configuration.

  bin/kickoff-config show [all|models|timeouts]
  bin/kickoff-config set-models [<harness>] <role>.model=<model> [<role>.effort=<effort>] ...
  bin/kickoff-config reset models|timeouts|all
  bin/kickoff-config preflight
  bin/kickoff-config watch [routing/telemetry options] --prompt-file <path>
  bin/kickoff-config render-command [routing options] --prompt-file <path>
  bin/kickoff-config recommend-timeouts

Section updates use ruamel.yaml round-trip mode: comments, ordering, quoting,
and data under `extensions` survive. Known schemas are strict. All writes
validate first and use atomic replacement. `watch` returns the child status,
65 on an unrecoverable protocol failure, 66 when a successful child produced
a fresh artifact but its terminal stream is incomplete, or 124 on timeout.

`watch` constructs the delegated `claude -p` / `codex exec` invocation itself
from its routing metadata; no caller hands it a command line. That is
deliberate: for as long as the recipe lived in prose, every orchestrator
rebuilt it by hand, and each hand-built copy was free to omit a flag whose
absence is silent — a missing `--json` costs the session id, a missing
`UV_NO_SYNC=1` costs the delegated coder every build gate it claims to have
run. `render-command` prints the exact argv without spawning anything, so the
recipe stays inspectable without being re-typed.
"""

from __future__ import annotations

import argparse
