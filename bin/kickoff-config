DEFAULT_TELEMETRY = ".kickoff/role-timings.jsonl"
TIMEOUT_EXIT = 124
PROTOCOL_EXIT = 65
RECOVERABLE_PROTOCOL_EXIT = 66
PREFLIGHT_SENTINEL = "KICKOFF_PREFLIGHT_OK"
PREFLIGHT_TIMEOUT_SECONDS = 120

# The canonical reviewer/coder tool stances, by access mode. On the Codex venue
# `-s read-only` enforces the stance at the sandbox; on the Claude venue
# `--allowedTools` is a strong hint the persona still self-polices
# (`policies/role-models.md`).
CLAUDE_TOOLS = {
    "read-only": "Read,Grep,Glob",
    "workspace-write": "Read,Grep,Glob,Write,Edit,Bash",
}
# The one write-enabled cross-harness role. Single-writer is satisfied by
# serialization: kickoff runs the coder stage with no concurrent native writer.
WRITE_ENABLED_ROLES = frozenset({"coder"})
# The roles that emit a Finding Evidence document, and the review kind each one
# reviews. Only these dispatches carry a structured-output schema; the planner
# and coder emit different artifacts entirely.
REVIEW_ROLE_KINDS = {"reviewer": "plan", "critic": "code"}

HARNESSES = ("default", "claude", "codex")
ROLES = ("planner", "reviewer", "coder", "critic")
MODELS = ("default", "claude", "codex", "opus", "fable", "sol", "terra", "luna")
CODEX_MODELS = {
    "codex": None,
    "sol": "gpt-5.6-sol",
    "terra": "gpt-5.6-terra",
    "luna": "gpt-5.6-luna",
}
CLAUDE_MODELS = {"claude": None, "opus": "opus", "fable": "fable"}
CODEX_EFFORTS = ("low", "medium", "high", "xhigh")
CLAUDE_EFFORTS = ("low", "medium", "high", "xhigh", "max")
ROLE_OPERATIONS = {
    "planner": "role.plan",
    "reviewer": "role.plan-review",
    "coder": "role.implement",
    "critic": "role.code-review",
}

SHIPPED_MODELS: dict[str, dict[str, dict[str, str]]] = {
    "default": {
        "planner": {"model": "default"},
        "reviewer": {"model": "default"},
        "coder": {"model": "default"},
        "critic": {"model": "default"},
    },
    "claude": {"reviewer": {"model": "codex"}, "critic": {"model": "codex"}},
    "codex": {
        "reviewer": {"model": "opus", "effort": "high"},
        "critic": {"model": "opus", "effort": "high"},
    },
}

SHIPPED_TIMEOUTS: dict[str, Any] = {
    "first_event_timeout_seconds": 120,
    "minimum_samples_for_recalibration": 30,
    "recalibration_multiplier": 2.0,
    "roles": {
        "planner": {
            "hard_timeout_seconds": 1800,
            "idle_timeout_seconds": 600,
            "claude_max_turns": 50,
            "hard_floor_seconds": 1800,
