        "coder": {
            "hard_timeout_seconds": 7200,
            "idle_timeout_seconds": 1200,
            "claude_max_turns": 200,
            "hard_floor_seconds": 7200,
            "idle_floor_seconds": 1200,
        },
        "critic": {
            "hard_timeout_seconds": 2700,
            "idle_timeout_seconds": 600,
            "claude_max_turns": 50,
            "hard_floor_seconds": 2700,
            "idle_floor_seconds": 600,
        },
    },
}


def yaml_engine() -> YAML:
    engine = YAML()
    engine.preserve_quotes = True
    engine.indent(mapping=2, sequence=4, offset=2)
    engine.width = 100
    return engine


ROLE_ATTEMPT_LEDGER_NAME = "role-attempts.jsonl"


def die(message: str) -> None:
    print(f"kickoff-config: {message}", file=sys.stderr)
    raise SystemExit(2)


def commented(value: Any) -> Any:
    if isinstance(value, dict):
        out = CommentedMap()
        for key, item in value.items():
            out[key] = commented(item)
        return out
    if isinstance(value, list):
        return [commented(item) for item in value]
    return value


def positive_number(value: Any, label: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:
        die(f"{label} must be a positive number")
    return float(value)


def positive_integer(value: Any, label: str) -> int:
    number = positive_number(value, label)
    if not number.is_integer():
        die(f"{label} must be an integer")
    return int(number)


def supported_efforts(model: str) -> tuple[str, ...]:
    if model in CODEX_MODELS:
        return CODEX_EFFORTS
    if model in CLAUDE_MODELS:
        return CLAUDE_EFFORTS
    return ()


def reject_unknown_keys(value: MutableMapping[str, Any], allowed: set[str], label: str) -> None:
    unknown = sorted(str(key) for key in value if key not in allowed)
    if unknown:
        die(
            f"unknown key(s) in {label}: {' '.join(unknown)}; "
            "put project-specific data under the top-level extensions mapping"
        )


def validate_model_fields(value: Any, label: str) -> tuple[str, str | None]:
    if not isinstance(value, MutableMapping):
        die(f"{label} must be a mapping with a model field")
    reject_unknown_keys(value, {"model", "effort"}, label)
    model = str(value.get("model", "")).lower()
    effort_value = value.get("effort")
    effort = str(effort_value).lower() if effort_value is not None else None
    if model not in MODELS:
        die(f"unknown model '{model}' (models: {' '.join(MODELS)})")
    if effort is None:
        return model, None
    if not effort:
        die(f"{label}.effort cannot be empty")
    efforts = supported_efforts(model)
    if not efforts:
        die(f"reasoning effort cannot be overridden for '{model}'")
    if effort not in efforts:
        die(f"unknown reasoning effort '{effort}' for '{model}' (efforts: {' '.join(efforts)})")
    return model, effort


def validate_models(section: Any) -> MutableMapping[str, Any]:
    if not isinstance(section, MutableMapping):
        die("role_models must be a mapping")
    for harness, values in section.items():
        if not isinstance(values, MutableMapping):
            die(f"role_models.{harness} must be a mapping")
        if harness not in HARNESSES:
            die(f"unknown harness '{harness}' (harnesses: {' '.join(HARNESSES)})")
        for role, fields in values.items():
            if role not in ROLES:
                die(f"unknown role '{role}' (roles: {' '.join(ROLES)})")
            validate_model_fields(fields, f"role_models.{harness}.{role}")
    return section


def validate_timeouts(section: Any) -> MutableMapping[str, Any]:
    if not isinstance(section, MutableMapping):
        die("role_timeouts must be a mapping")
    reject_unknown_keys(
        section,
        {
            "first_event_timeout_seconds",
            "minimum_samples_for_recalibration",
            "recalibration_multiplier",
            "roles",
        },
        "role_timeouts",
    )
    positive_integer(
        section.get("first_event_timeout_seconds"),
        "role_timeouts.first_event_timeout_seconds",
    )
    positive_integer(
        section.get("minimum_samples_for_recalibration"),
        "role_timeouts.minimum_samples_for_recalibration",
    )
    positive_number(
        section.get("recalibration_multiplier"),
        "role_timeouts.recalibration_multiplier",
    )
    roles = section.get("roles")
    if not isinstance(roles, MutableMapping):
        die("role_timeouts.roles must be a mapping")
    reject_unknown_keys(roles, set(ROLES), "role_timeouts.roles")
    for role in ROLES:
        values = roles.get(role)
        if not isinstance(values, MutableMapping):
            die(f"role_timeouts.roles.{role} must be a mapping")
        reject_unknown_keys(
            values,
            {
                "hard_timeout_seconds",
                "idle_timeout_seconds",
                "claude_max_turns",
                "hard_floor_seconds",
                "idle_floor_seconds",
            },
            f"role_timeouts.roles.{role}",
        )
        for field in (
            "hard_timeout_seconds",
            "idle_timeout_seconds",
            "claude_max_turns",
            "hard_floor_seconds",
            "idle_floor_seconds",
        ):
            positive_integer(values.get(field), f"role_timeouts.roles.{role}.{field}")
        if values["idle_timeout_seconds"] > values["hard_timeout_seconds"]:
            die(f"role_timeouts.roles.{role}.idle_timeout_seconds cannot exceed its hard timeout")
    return section


def validate_document(document: Any) -> MutableMapping[str, Any]:
    if not isinstance(document, MutableMapping):
        die(f"{CONFIG} must be a YAML mapping")
    reject_unknown_keys(
        document,
        {"version", "extensions", "role_models", "role_timeouts"},
        str(CONFIG),
    )
    if document.get("version") != 1:
        die(f"{CONFIG} must declare version: 1")
    extensions = document.get("extensions", {})
    if not isinstance(extensions, MutableMapping):
        die(f"{CONFIG}.extensions must be a mapping")
    validate_models(document.get("role_models"))
    validate_timeouts(document.get("role_timeouts"))
    return document


def load_document(*, allow_missing: bool = False) -> MutableMapping[str, Any]:
    if not CONFIG.exists():
        if not allow_missing:
            die(f"{CONFIG} is missing; run ./bin/kickoff-config reset all")
        document = CommentedMap()
        document["version"] = 1
        document["role_models"] = commented(SHIPPED_MODELS)
        document["role_timeouts"] = commented(SHIPPED_TIMEOUTS)
        return document
    try:
        document = yaml_engine().load(CONFIG.read_text())
    except Exception as exc:
        die(f"cannot parse {CONFIG}: {exc}")
    return validate_document(document)


def atomic_dump(document: MutableMapping[str, Any]) -> None:
    validate_document(document)
    mode = stat.S_IMODE(CONFIG.stat().st_mode) if CONFIG.exists() else 0o644
    fd, temporary = tempfile.mkstemp(prefix=f".{CONFIG.name}.", suffix=".tmp", dir=CONFIG.parent)
    try:
        with os.fdopen(fd, "w") as handle:
            yaml_engine().dump(document, handle)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, CONFIG)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def detect_harness() -> str:
    return "claude" if os.environ.get("CLAUDECODE") == "1" else "codex"


def resolve_models(
    section: MutableMapping[str, Any], harness: str
) -> dict[str, tuple[str, str | None]]:
    resolved: dict[str, tuple[str, str | None]] = {}
    harness_values = section.get(harness, {})
    default_values = section.get("default", {})
    for role in ROLES:
        fields = harness_values.get(role) or default_values.get(role) or {"model": "default"}
        resolved[role] = validate_model_fields(fields, f"resolved role {role}")
    return resolved


def describe_model(model: str, effort: str | None) -> str:
    if model == "default":
        description = "native (session model)"
    elif model in CLAUDE_MODELS:
        selected = CLAUDE_MODELS[model]
        description = f"claude --model {selected}" if selected else "claude CLI (default model)"
    else:
        selected = CODEX_MODELS[model]
        description = f"codex --model {selected}" if selected else "codex CLI (default model)"
    if effort:
        if model in CODEX_MODELS:
            description += f" -c 'model_reasoning_effort=\"{effort}\"'"
        else:
            description += f" --effort {effort}"
    return description


def show_models(section: MutableMapping[str, Any]) -> None:
    print(f"Model pins from {CONFIG}:")
    found = False
    for harness in HARNESSES:
        values = section.get(harness)
        if not isinstance(values, MutableMapping):
            continue
        found = True
        print(f"  {harness}:")
        for role in ROLES:
            if role in values:
                model, effort = validate_model_fields(values[role], f"role_models.{harness}.{role}")
                print(f"    {role:<9} model={model:<8} effort={effort or 'default'}")
    if not found:
        print("  (none — every role runs native)")
    harness = detect_harness()
    print(f"\nResolved for this harness ({harness}):")
    for role, (model, effort) in resolve_models(section, harness).items():
        effort_text = effort or "default"
        print(
            f"  {role:<9} model={model:<8} effort={effort_text:<7} "
            f"→ {describe_model(model, effort)}"
        )


def show_timeouts(section: MutableMapping[str, Any]) -> None:
    print(f"Execution budgets from {CONFIG}:")
    print(f"First structured event: {section['first_event_timeout_seconds']}s")
    print("Role       hard    idle   claude turns")
    for role in ROLES:
        values = section["roles"][role]
        print(
            f"{role:<10} {values['hard_timeout_seconds']:>5}s "
            f"{values['idle_timeout_seconds']:>7}s {values['claude_max_turns']:>14}"
        )
    print(
        "Recalibration: at least "
        f"{section['minimum_samples_for_recalibration']} successful samples per "
        "(role, venue, model, effort); recommend max(floor, "
        f"{section['recalibration_multiplier']:g} × p95)."
    )


def show(document: MutableMapping[str, Any], scope: str) -> None:
    if scope in ("all", "models"):
        show_models(document["role_models"])
    if scope == "all":
        print()
    if scope in ("all", "timeouts"):
        show_timeouts(document["role_timeouts"])


def set_models(arguments: list[str]) -> None:
    section_name = "default"
    if arguments and "=" not in arguments[0] and arguments[0].lower() in HARNESSES:
        section_name = arguments.pop(0).lower()
    staged: list[tuple[str, str, str | None]] = []
    for assignment in arguments:
        assignment = assignment.strip().strip(",")
        if not assignment:
            continue
        if "=" not in assignment or "." not in assignment.split("=", 1)[0]:
            die(f"expected role.model=value or role.effort=value, got '{assignment}'")
        path, raw_value = assignment.split("=", 1)
        role, field = path.lower().split(".", 1)
        if role not in ROLES:
            die(f"unknown role '{role}' (roles: {' '.join(ROLES)})")
        if field not in ("model", "effort"):
            die(f"unknown model field '{field}' (fields: model effort)")
        value = raw_value.strip().lower()
        if field == "model" and value not in MODELS:
            die(f"unknown model '{value}' (models: {' '.join(MODELS)})")
        if field == "effort" and value in ("default", "none"):
            staged.append((role, field, None))
        elif field == "effort" and value not in CLAUDE_EFFORTS:
            die(f"unknown reasoning effort '{value}'")
        else:
            staged.append((role, field, value))
    if not staged:
        die("no pins given")
    document = load_document()
    section = document["role_models"]
    if section_name not in section:
        section[section_name] = CommentedMap()
    for role, field, value in staged:
        if role not in section[section_name]:
            section[section_name][role] = CommentedMap({"model": "default"})
        if value is None:
            section[section_name][role].pop(field, None)
        else:
            section[section_name][role][field] = value
    atomic_dump(document)
    show_models(load_document()["role_models"])


def reset(scope: str) -> None:
    document = load_document(allow_missing=True)
    if scope in ("models", "all"):
        document["role_models"] = commented(SHIPPED_MODELS)
    if scope in ("timeouts", "all"):
        document["role_timeouts"] = commented(SHIPPED_TIMEOUTS)
    atomic_dump(document)
    show(load_document(), "all" if scope == "all" else scope)


@dataclass(frozen=True)
class PreflightTarget:
    cli: str
    model: str | None
    effort: str | None
    write_enabled: bool


def preflight_targets(
    section: MutableMapping[str, Any], harness: str
) -> dict[PreflightTarget, list[str]]:
    targets: dict[PreflightTarget, list[str]] = {}
    for role, (model, effort) in resolve_models(section, harness).items():
        if model == "default":
            continue
        write_enabled = role in WRITE_ENABLED_ROLES
        if model in CLAUDE_MODELS:
            target = PreflightTarget("claude", CLAUDE_MODELS[model], effort, write_enabled)
        else:
            target = PreflightTarget("codex", CODEX_MODELS[model], effort, write_enabled)
        targets.setdefault(target, []).append(role)
    return targets


def role_access(role: str) -> str:
    """The access mode a role runs under. Derived, never passed in.

    A reviewer that could be handed `workspace-write` is a reviewer that can
    contend for the working tree, so the mode is a property of the role rather
    than an argument an orchestrator supplies.
    """
    return "workspace-write" if role in WRITE_ENABLED_ROLES else "read-only"


def cli_program(cli: str) -> str:
    """Resolve the venue executable.

    `KICKOFF_CLI_CLAUDE` / `KICKOFF_CLI_CODEX` substitute the *binary* only, for
    tests and diagnostics. The argv around it is still generated here, so a
    substituted binary receives the production recipe rather than a stand-in.
    """
    return os.environ.get(f"KICKOFF_CLI_{cli.upper()}") or cli


def claude_routing_flags(model_slug: str | None, effort: str | None) -> list[str]:
    """Model/effort flags for the Claude CLI, repeated identically on resume."""
    flags: list[str] = []
    if model_slug:
        flags.extend(("--model", model_slug))
    if effort:
        flags.extend(("--effort", effort))
    return flags


def codex_routing_flags(model_slug: str | None, effort: str | None) -> list[str]:
    """Model/effort flags for the Codex CLI, repeated identically on resume."""
    flags: list[str] = []
    if model_slug:
        flags.extend(("--model", model_slug))
    if effort:
        flags.extend(("-c", f'model_reasoning_effort="{effort}"'))
    return flags


def review_kind(role: str) -> str | None:
    """The review kind this role emits findings for, or None if it emits none."""
    return REVIEW_ROLE_KINDS.get(role)


def write_output_schema(artifact: str, kind: str) -> str:
    """Materialize the schema beside the artifact the venue will write.

    Codex takes a schema *file*, so one has to exist on disk. Deriving its path
    from the artifact keeps it inside the directory the caller already owns and
    leaves it there for inspection after a failed dispatch — the schema is
    evidence about what the role was asked for, not scratch.
    """
    path = Path(f"{artifact}.schema.json")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(schema_json(kind) + "\n", encoding="utf-8")
    return str(path)


def build_claude_command(
    *,
    prompt: str,
    model_slug: str | None,
    effort: str | None,
    access: str,
    max_turns: int,
    schema_kind: str | None,
    resume_session: str | None,
) -> list[str]:
    """The production `claude -p` invocation.

    `--output-format stream-json --verbose` is not a preference: it is what
    makes the first-event and idle clocks measure real activity, and it carries
    the `session_id` a revision round resumes from. `--permission-mode dontAsk`
    is the only fully non-interactive mode — `--dangerously-skip-permissions`
    parks on a one-time consent dialog that, with no TTY, never returns.
    """
    command = [cli_program("claude"), "-p", prompt]
    command.extend(claude_routing_flags(model_slug, effort))
    if resume_session:
        command.extend(("--resume", resume_session))
    command.extend(
        (
            "--permission-mode",
            "dontAsk",
            "--allowedTools",
            CLAUDE_TOOLS[access],
            "--output-format",
            "stream-json",
            "--verbose",
            "--max-turns",
            str(max_turns),
        )
    )
    if schema_kind:
        # Claude takes the schema inline; Codex takes a file. The asymmetry is
        # the vendors', not ours.
        command.extend(("--json-schema", schema_json(schema_kind)))
    return command


def build_codex_command(
    *,
    prompt: str,
    model_slug: str | None,
    effort: str | None,
    access: str,
    output_file: str,
    schema_kind: str | None,
    resume_session: str | None,
) -> list[str]:
    """The production `codex exec` invocation.

    `resume` has a different flag surface than `exec`: `-s/--sandbox` and
    `-C/--cd` do not exist on it, so the sandbox travels as a config override
    and the working directory as the inherited cwd (resume filters recorded
    sessions by cwd). A resume that reuses the `exec` flags flag-parse-fails,
    which reads as a venue failure and silently costs the session's context.
    """
    program = cli_program("codex")
    if resume_session:
        command = [
            program,
            "exec",
            "resume",
            resume_session,
            "--json",
            "-c",
            'approval_policy="never"',
            "-c",
            f'sandbox_mode="{access}"',
        ]
    else:
        command = [
            program,
            "exec",
            "--json",
            "-s",
            access,
            "-c",
            'approval_policy="never"',
            "-C",
            str(REPO_ROOT),
        ]
    command.extend(("--output-last-message", output_file))
    if schema_kind:
        command.extend(("--output-schema", write_output_schema(output_file, schema_kind)))
    command.extend(codex_routing_flags(model_slug, effort))
    command.append(prompt)
    return command


def build_watch_command(
    arguments: argparse.Namespace, section: MutableMapping[str, Any]
) -> list[str]:
    """Generate the delegated invocation for one role dispatch."""
    prompt = Path(arguments.prompt_file).read_text(encoding="utf-8")
    if not prompt.strip():
        die(f"prompt file is empty: {arguments.prompt_file}")
    effort = None if arguments.effort == "default" else arguments.effort
    model, effort = validate_model_fields(
        {"model": arguments.model, **({"effort": effort} if effort else {})},
        "watch routing",
    )
    access = role_access(arguments.role)
    schema_kind = review_kind(arguments.role)
    if arguments.venue == "claude":
        if model not in CLAUDE_MODELS:
            die(f"model '{model}' does not route to the claude CLI")
        if not arguments.result_file:
            die("claude venue requires --result-file")
        if arguments.required_output_file:
            die("claude venue extracts its artifact from the stream; use --result-file")
        return build_claude_command(
            prompt=prompt,
            model_slug=CLAUDE_MODELS[model],
            effort=effort,
            access=access,
            max_turns=section["roles"][arguments.role]["claude_max_turns"],
            schema_kind=schema_kind,
            resume_session=arguments.resume_session,
        )
    if model not in CODEX_MODELS:
        die(f"model '{model}' does not route to the codex CLI")
    if not arguments.required_output_file:
        die("codex venue requires --required-output-file")
    if arguments.result_file:
        die("codex venue writes its artifact directly; use --required-output-file")
    return build_codex_command(
        prompt=prompt,
        model_slug=CODEX_MODELS[model],
        effort=effort,
        access=access,
        output_file=arguments.required_output_file,
        schema_kind=schema_kind,
        resume_session=arguments.resume_session,
    )


def scrubbed_env(cli: str) -> dict[str, str]:
    environment = os.environ.copy()
    keys = (
        ("CLAUDECODE", "CLAUDE_CODE_ENTRYPOINT", "ANTHROPIC_API_KEY")
        if cli == "claude"
        else ("OPENAI_API_KEY", "CODEX_API_KEY")
    )
    for key in keys:
        environment.pop(key, None)
    environment["KICKOFF_DELEGATION_DEPTH"] = "1"
    return environment


def diagnostic(process: subprocess.CompletedProcess[str]) -> str:
    raw = (process.stderr or process.stdout or "no diagnostic output").strip()
    return " ".join(raw.split())[-1000:]


def run_claude_preflight(target: PreflightTarget, workdir: str) -> None:
    command = [
        cli_program("claude"),
        "-p",
        f"Reply with exactly: {PREFLIGHT_SENTINEL}",
        "--permission-mode",
        "dontAsk",
        "--allowedTools",
        CLAUDE_TOOLS["workspace-write" if target.write_enabled else "read-only"],
        # A one-shot `json` envelope suffices for a sentinel probe; it cannot
        # support the idle watchdog production work needs.
        "--output-format",
        "json",
        "--max-turns",
        "3",
        *claude_routing_flags(target.model, target.effort),
    ]
    process = subprocess.run(
        command,
        cwd=workdir,
        env=scrubbed_env("claude"),
        stdin=subprocess.DEVNULL,
        capture_output=True,
        text=True,
        timeout=PREFLIGHT_TIMEOUT_SECONDS,
    )
    if process.returncode:
        raise RuntimeError(f"exit {process.returncode}: {diagnostic(process)}")
    try:
        envelope = json.loads(process.stdout)
    except json.JSONDecodeError as exc:
        raise RuntimeError(f"malformed JSON response: {exc}") from exc
    result = str(envelope.get("result", "")).strip()
    if envelope.get("is_error") or result != PREFLIGHT_SENTINEL:
        detail = envelope.get("result") or envelope.get("error") or "sentinel missing"
        raise RuntimeError(f"unsuccessful response: {' '.join(str(detail).split())[-1000:]}")


def run_codex_preflight(target: PreflightTarget, workdir: str) -> None:
    with tempfile.TemporaryDirectory(prefix="kickoff-preflight-") as temporary:
        message_file = os.path.join(temporary, "last-message.txt")
        command = [
            cli_program("codex"),
            "exec",
            "--json",
            # Upstream readiness needs no repository context, and the probe runs
            # in an empty directory; the production checkout call never carries
            # this flag.
            "--skip-git-repo-check",
            "-s",
            "workspace-write" if target.write_enabled else "read-only",
            "-c",
            'approval_policy="never"',
            "-C",
            workdir,
            "--output-last-message",
            message_file,
            *codex_routing_flags(target.model, target.effort),
            f"Reply with exactly: {PREFLIGHT_SENTINEL}",
        ]
        process = subprocess.run(
            command,
            cwd=workdir,
            env=scrubbed_env("codex"),
            stdin=subprocess.DEVNULL,
            capture_output=True,
            text=True,
            timeout=PREFLIGHT_TIMEOUT_SECONDS,
        )
        if process.returncode:
            raise RuntimeError(f"exit {process.returncode}: {diagnostic(process)}")
        try:
            result = Path(message_file).read_text().strip()
        except FileNotFoundError as exc:
            raise RuntimeError("output artifact missing") from exc
        if result != PREFLIGHT_SENTINEL:
            raise RuntimeError(
                f"unsuccessful response: {' '.join(result.split())[-1000:] or 'sentinel missing'}"
            )


def preflight(section: MutableMapping[str, Any]) -> None:
    if os.environ.get("KICKOFF_DELEGATION_DEPTH"):
        print("Role venue preflight: skipped (delegated session; every role runs native)")
        return
    harness = detect_harness()
    targets = preflight_targets(section, harness)
    if not targets:
        print("Role venue preflight: N/A (every role runs native)")
        return
    with tempfile.TemporaryDirectory(prefix="kickoff-preflight-workdir-") as workdir:
        for target, roles in targets.items():
            model = f" --model {target.model}" if target.model else " (default model)"
            effort = f", effort {target.effort}" if target.effort else ""
            access = "write-enabled" if target.write_enabled else "read-only"
            label = f"{target.cli}{model}{effort}, {access}; roles: {', '.join(roles)}"
            if shutil.which(target.cli) is None:
                die(f"preflight failed for {label}: CLI not on PATH")
            print(f"Role venue preflight: validating {label} ...", flush=True)
            try:
                if target.cli == "claude":
                    run_claude_preflight(target, workdir)
                else:
                    run_codex_preflight(target, workdir)
            except subprocess.TimeoutExpired:
                die(f"preflight failed for {label}: timed out after {PREFLIGHT_TIMEOUT_SECONDS}s")
            except (OSError, RuntimeError) as exc:
                die(f"preflight failed for {label}: {exc}")
            print(f"Role venue preflight: OK — {label}")


def utc_now() -> str:
    return datetime.now(UTC).isoformat()


def terminate_group(process: subprocess.Popen[bytes]) -> None:
    group_id = process.pid

    def group_exists() -> bool:
        try:
            os.killpg(group_id, 0)
            return True
        except ProcessLookupError:
            return False
        except PermissionError:
            return True

    def wait_group(seconds: float) -> bool:
        deadline = time.monotonic() + seconds
        while group_exists() and time.monotonic() < deadline:
            if process.poll() is None:
                try:
                    process.wait(timeout=min(0.05, max(0.001, deadline - time.monotonic())))
                except subprocess.TimeoutExpired:
                    pass
            else:
                time.sleep(0.01)
        return not group_exists()

    try:
        os.killpg(group_id, signal.SIGTERM)
    except ProcessLookupError:
        pass
    if not wait_group(5):
        try:
            os.killpg(group_id, signal.SIGKILL)
        except ProcessLookupError:
            pass
        wait_group(2)
    if process.poll() is None:
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


def open_artifact(path: str | None) -> BinaryIO | None:
    if not path:
        return None
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    return target.open("wb")


def prepare_output_path(path: str | None) -> Path | None:
    if not path:
        return None
    target = Path(path)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_bytes(b"")
    return target


def option_value(command: list[str], names: tuple[str, ...]) -> str | None:
    for index, token in enumerate(command):
        for name in names:
            if token == name and index + 1 < len(command):
                return command[index + 1]
            prefix = f"{name}="
            if token.startswith(prefix):
                return token[len(prefix) :]
    return None


def validate_watch_routing(arguments: argparse.Namespace, command: list[str]) -> int:
    """Re-derive the routing contract from the generated argv.

    This began as a guard against hand-built commands. It survives their removal
    as the generator's own proof: the flags the child will actually receive are
    read back and required to match the metadata the telemetry spans record, so
    a builder that drifts from its own routing fields cannot spawn.
    """
    program_index = 0
    actual_venue = Path(command[program_index]).name
    if actual_venue != arguments.venue:
        die(f"watch venue={arguments.venue} but command invokes {actual_venue}")

    effort = None if arguments.effort == "default" else arguments.effort
    model, effort = validate_model_fields(
        {"model": arguments.model, **({"effort": effort} if effort else {})},
        "watch routing",
    )
    family = "claude" if model in CLAUDE_MODELS else "codex" if model in CODEX_MODELS else None
    if family != arguments.venue:
        die(f"model '{model}' routes to {family or 'native'}, not {arguments.venue}")

    cli_arguments = command[program_index + 1 :]
    expected_model = CLAUDE_MODELS[model] if family == "claude" else CODEX_MODELS[model]
    actual_model = option_value(cli_arguments, ("--model", "-m"))
    if expected_model and actual_model != expected_model:
        die(
            f"watch metadata declares model={model}, but command must include "
            f"--model {expected_model}"
        )
    if not expected_model and actual_model:
        die(
            f"watch metadata declares the {model} CLI default model, but command "
            f"overrides it with {actual_model}"
        )

    if effort and family == "claude":
        actual_effort = option_value(cli_arguments, ("--effort",))
        if actual_effort != effort:
            die(
                f"watch metadata declares effort={effort}, but command must include "
                f"--effort {effort}"
            )
    elif effort:
        pattern = re.compile(rf'^model_reasoning_effort=["\']?{re.escape(effort)}["\']?$')
        if not any(pattern.match(token) for token in cli_arguments):
            die(
                f"watch metadata declares effort={effort}, but command must include "
                f"-c 'model_reasoning_effort=\"{effort}\"'"
            )
    return program_index


def _uv_directory(arguments: tuple[str, ...], label: str) -> Path:
    process = subprocess.run(
        ["uv", *arguments],
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode != 0 or not process.stdout.strip():
        detail = process.stderr.strip() or process.stdout.strip() or f"exit {process.returncode}"
        die(f"cannot resolve uv {label}: {detail}")
    return Path(process.stdout.strip()).resolve()


def watched_sandbox(cli_arguments: list[str]) -> str | None:
    """The sandbox the generated command asks for, in either spelling.

    `exec` takes `-s <mode>`; `resume` has no such flag and carries the mode as
    a `sandbox_mode` config override. Reading only the first spelling would let
    a resumed coder run without the uv support its initial call received — the
    same zero-verification failure, one round later.
    """
    direct = option_value(cli_arguments, ("-s", "--sandbox"))
    if direct:
        return direct
    for index, token in enumerate(cli_arguments):
        if index and cli_arguments[index - 1] in {"-c", "--config"}:
            match = re.match(r'^sandbox_mode=["\']?([\w-]+)["\']?$', token)
            if match:
                return match.group(1)
    return None


def prepare_watched_command(
    arguments: argparse.Namespace,
    command: list[str],
    program_index: int,
) -> tuple[list[str], dict[str, str]]:
    environment = scrubbed_env(arguments.venue)
    cli_arguments = command[program_index + 1 :]
    sandbox = watched_sandbox(cli_arguments)
    if arguments.venue != "codex" or sandbox != "workspace-write":
        return command, environment

    injected: list[str] = []
    supplied_no_sync = environment.get("UV_NO_SYNC")
    if supplied_no_sync is None:
        environment["UV_NO_SYNC"] = "1"
        injected.append("UV_NO_SYNC=1")
    elif supplied_no_sync != "1":
        die("codex workspace-write requires UV_NO_SYNC=1")

    writable_roots_key = "sandbox_workspace_write.writable_roots"
    has_writable_roots = any(
        token.startswith(f"{writable_roots_key}=")
        for index, token in enumerate(cli_arguments)
        if index > 0 and cli_arguments[index - 1] in {"-c", "--config"}
    )
    if not has_writable_roots:
        cache_dir = _uv_directory(("cache", "dir"), "cache directory")
        python_dir = _uv_directory(("python", "dir"), "data directory")
        data_dir = python_dir.parent
        config = f"{writable_roots_key}=" + json.dumps(
            [str(cache_dir), str(data_dir)], separators=(",", ":")
        )
        # Insert after the subcommand chain and any positional session id —
        # before the first flag. Anchoring on `exec` alone would place the
        # override between `exec` and `resume`, where it does not parse.
        flag_offset = next(
            (index for index, token in enumerate(cli_arguments) if token.startswith("-")),
            len(cli_arguments),
        )
        insertion = program_index + 1 + flag_offset
        command = [*command[:insertion], "-c", config, *command[insertion:]]
        injected.append(writable_roots_key)

    # UV_NO_SYNC avoids uv's resolver inside Seatbelt. This is sound only while
    # --locked detects dependency drift and the host has provisioned the venv.
    # Dependency-changing work must sync on the host first or use a native coder.
    if injected:
        print(
            "kickoff-config: injected codex workspace-write support: " + ", ".join(injected),
            file=sys.stderr,
        )
    return command, environment


def numbers_from_usage(value: Any) -> tuple[int | None, int | None]:
    if not isinstance(value, dict):
        return (None, None)
    input_tokens = value.get("input_tokens", value.get("inputTokens"))
    output_tokens = value.get("output_tokens", value.get("outputTokens"))

    def accepted(item: Any) -> int | None:
        return item if isinstance(item, int) and not isinstance(item, bool) and item >= 0 else None

    return (
        accepted(input_tokens),
        accepted(output_tokens),
    )


def event_text(event: dict[str, Any]) -> str | None:
    candidates: list[Any] = [event.get("content")]
    message = event.get("message")
    if isinstance(message, dict):
        candidates.append(message.get("content"))
    for candidate in candidates:
        if isinstance(candidate, str) and candidate.strip():
            return candidate
        if isinstance(candidate, list):
            parts = [
                item.get("text")
                for item in candidate
                if isinstance(item, dict)
                and item.get("type") in {None, "text"}
                and isinstance(item.get("text"), str)
            ]
            text = "\n".join(part for part in parts if part.strip())
            if text.strip():
                return text
    return None


def parse_events(
    data: bytes,
    venue: str | None = None,
) -> tuple[int | None, int | None, int | None, str | None, str | None, set[str]]:
    turns = 0
    input_tokens: int | None = None
    output_tokens: int | None = None
    result: str | None = None
    assistant_text: str | None = None
    event_types: set[str] = set()
    parsed = False
    for raw_line in data.decode("utf-8", errors="replace").splitlines():
        try:
            event = json.loads(raw_line)
        except json.JSONDecodeError:
            continue
        if not isinstance(event, dict):
            continue
        parsed = True
        event_type = str(event.get("type", ""))
        event_types.add(event_type)
        if event_type in {"turn.started", "assistant"}:
            turns += 1
        if venue == "claude" and event_type == "result":
            input_tokens, output_tokens = numbers_from_usage(event.get("usage"))
        if event_type == "result" and isinstance(event.get("result"), str):
            result = event["result"]
        if event_type in {"assistant", "item.completed"}:
            observed_text = event_text(event)
            if observed_text:
                assistant_text = observed_text
    return (
        turns if parsed else None,
        input_tokens if parsed and venue == "claude" else None,
        output_tokens if parsed and venue == "claude" else None,
        result,
        assistant_text,
        event_types,
    )


def append_record(record: dict[str, Any], telemetry_path: str) -> None:
    target = Path(telemetry_path)
    target.parent.mkdir(parents=True, exist_ok=True)
    with target.open("a") as handle:
        json.dump(record, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")


def inject_telemetry_failure(stage: str) -> None:
    configured = {
        item.strip()
        for item in os.environ.get("KICKOFF_TELEMETRY_FAIL", "").split(",")
        if item.strip()
    }
    if stage in configured:
        raise TelemetryError(f"injected {stage} failure")


def validate_telemetry_registration(arguments: argparse.Namespace) -> dict[str, Any] | None:
    supplied = [
        arguments.telemetry_trace_id,
        arguments.telemetry_parent_span_id,
        arguments.telemetry_operation,
        arguments.telemetry_attempt,
        arguments.telemetry_role_registration,
    ]
    if not any(value is not None for value in supplied):
        return None
    if not all(value is not None for value in supplied):
        die("telemetry arguments must be supplied together")
    registration_path = Path(arguments.telemetry_role_registration)
    # The append-only ledger is never a registration. It is JSON Lines, so a
    # ledger holding exactly one record is *also* a valid JSON object and would
    # parse here -- the watcher would run, and the identical argument would then
    # die with "Extra data: line 2 column 1" as soon as a second role registered.
    # An argument that works early and fails later teaches the wrong contract and
    # fails at the worst moment, so refuse it the same way every time, by name,
    # before parsing.
    if registration_path.name == ROLE_ATTEMPT_LEDGER_NAME:
        die(
            f"telemetry role registration must not be the {ROLE_ATTEMPT_LEDGER_NAME} "
            "ledger: pass the per-attempt file written by "
            "`register-role-attempt --output`, which the ledger cross-checks"
        )
    try:
        registration = json.loads(registration_path.read_text())
    except OSError as exc:
        die(f"invalid telemetry role registration: {exc}")
    except json.JSONDecodeError as exc:
        # A JSONL file that is not literally named role-attempts.jsonl reaches
        # here. Name the likely cause rather than surfacing the decoder's offset.
        die(
            f"invalid telemetry role registration: {exc}. A registration is one "
            "JSON object -- the per-attempt file written by "
            "`register-role-attempt --output`, not an append-only JSON Lines ledger"
        )
    expected = {
        "telemetry_trace_id": arguments.telemetry_trace_id,
        "telemetry_root_span_id": arguments.telemetry_parent_span_id,
        "operation": arguments.telemetry_operation,
        "attempt": arguments.telemetry_attempt,
        "role": arguments.role,
        "harness": arguments.venue,
        "model": arguments.model,
        "effort": None if arguments.effort == "default" else arguments.effort,
    }
    if not isinstance(registration, dict) or any(
        registration.get(key) != value for key, value in expected.items()
    ):
        die("telemetry role registration does not match watcher routing")
    try:
        ledger_records = [
            json.loads(line)
            for line in (registration_path.parent / "role-attempts.jsonl").read_text().splitlines()
            if line.strip()
        ]
    except (OSError, json.JSONDecodeError) as exc:
        die(f"invalid role-attempt ledger: {exc}")
    if sum(item == registration for item in ledger_records) != 1:
        die("telemetry role registration is not uniquely present in its ledger")
    if ROLE_OPERATIONS[arguments.role] != arguments.telemetry_operation:
        die("telemetry operation does not match canonical role")
    try:
        context = trace_context(engine_root=REPO_ROOT, trace_id=arguments.telemetry_trace_id)
    except TelemetryError as exc:
        die(f"invalid telemetry trace: {exc}")
    if (
        context["root_span_id"] != arguments.telemetry_parent_span_id
        or context["scope"] != "engine"
        or context["scope_id"] != "engine"
        or context["run_type"] != "kickoff"
        or context["operation"] != f"phase.{arguments.phase}"
        or context["state"] != "open"
    ):
        die("telemetry trace does not own this kickoff role")
    return registration


def record_dispatch_topology(
    arguments: argparse.Namespace,
    *,
    accepted: bool,
    intelligence_span_id: str | None,
    wait_span_id: str | None,
) -> str | None:
    if arguments.telemetry_role_registration is None:
        return None
    registration = Path(arguments.telemetry_role_registration)
    executable = registration.parent / "tools" / "kickoff-evidence"
    command = [
        str(executable),
        "record-role-dispatch",
        "--run-dir",
        str(registration.parent),
        "--registration",
        str(registration),
        "--state",
        "accepted" if accepted else "rejected",
        "--idle-telemetry",
        "available" if accepted else "not-dispatched",
    ]
    if intelligence_span_id is not None:
        command.extend(["--intelligence-span-id", intelligence_span_id])
    if wait_span_id is not None:
        command.extend(["--wait-span-id", wait_span_id])
    environment = os.environ.copy()
    environment["KICKOFF_ENGINE_ROOT"] = str(REPO_ROOT)
    result = subprocess.run(command, capture_output=True, text=True, check=False, env=environment)
    if result.returncode != 0:
        return result.stderr.strip() or "dispatch topology write failed"
    return None


def watch(arguments: argparse.Namespace, section: MutableMapping[str, Any]) -> int:
    if os.environ.get("KICKOFF_DELEGATION_DEPTH"):
        die(
            "KICKOFF_DELEGATION_DEPTH is set: this session is itself a delegated "
            "role and may not delegate again; run the role natively"
        )
    command = build_watch_command(arguments, section)
    program_index = validate_watch_routing(arguments, command)
    command, child_environment = prepare_watched_command(arguments, command, program_index)
    registration = validate_telemetry_registration(arguments)
    intelligence = None
    wait_span = None
    telemetry_complete = registration is not None
    telemetry_errors: list[str] = []
    if registration is not None:
        metadata = {
            "harness": arguments.venue,
            "role": arguments.role,
            "model": arguments.model,
        }
        if arguments.effort != "default":
            metadata["effort"] = arguments.effort
        try:
            inject_telemetry_failure("intelligence-start")
            intelligence = start_span(
                engine_root=REPO_ROOT,
                trace_id=arguments.telemetry_trace_id,
                parent_span_id=arguments.telemetry_parent_span_id,
                category="intelligence",
                operation=arguments.telemetry_operation,
                attempt=arguments.telemetry_attempt,
                **metadata,
            )
        except TelemetryError as exc:
            telemetry_complete = False
            telemetry_errors.append(f"intelligence-start: {exc}")
    role_config = section["roles"][arguments.role]
    first_limit = (
        arguments.first_event_timeout
        if arguments.first_event_timeout is not None
        else section["first_event_timeout_seconds"]
    )
    idle_limit = (
        arguments.idle_timeout
        if arguments.idle_timeout is not None
        else role_config["idle_timeout_seconds"]
    )
    hard_limit = (
        arguments.hard_timeout
        if arguments.hard_timeout is not None
        else role_config["hard_timeout_seconds"]
    )
    for label, limit in (
        ("first-event timeout", first_limit),
        ("idle timeout", idle_limit),
        ("hard timeout", hard_limit),
    ):
        if limit <= 0:
            die(f"{label} must be positive")
    if idle_limit > hard_limit:
        die("idle timeout cannot exceed hard timeout")

    stdout_file = open_artifact(arguments.stdout_file)
    stderr_file = open_artifact(arguments.stderr_file)
    result_path = prepare_output_path(arguments.result_file)
    required_output_path = prepare_output_path(arguments.required_output_file)
    started_iso = utc_now()
    started = time.monotonic()
    last_activity = started
    first_event_at: float | None = None
    longest_idle = 0.0
    stdout_data = bytearray()
    stdout_line_buffer = bytearray()
    timeout_kind: str | None = None
    try:
        process = subprocess.Popen(
            command,
            env=child_environment,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as exc:
        if stdout_file:
            stdout_file.close()
        if stderr_file:
            stderr_file.close()
        if intelligence is not None:
            try:
                finish_span(
                    engine_root=REPO_ROOT,
                    trace_id=intelligence.trace_id,
                    span_id=intelligence.span_id,
                    outcome="error",
                    exit_code=127,
                )
            except TelemetryError as telemetry_exc:
                telemetry_errors.append(f"intelligence-finish: {telemetry_exc}")
        topology_error = record_dispatch_topology(
            arguments,
            accepted=False,
            intelligence_span_id=intelligence.span_id if intelligence else None,
            wait_span_id=None,
        )
        if topology_error:
            print(f"kickoff-config: telemetry incomplete: {topology_error}", file=sys.stderr)
        die(f"could not start {command[0]}: {exc}")
    if intelligence is not None:
        try:
            inject_telemetry_failure("wait-start")
            wait_span = start_span(
                engine_root=REPO_ROOT,
                trace_id=intelligence.trace_id,
                parent_span_id=intelligence.span_id,
                category="wait",
                operation=arguments.telemetry_operation,
                attempt=arguments.telemetry_attempt,
                harness=arguments.venue,
                role=arguments.role,
                model=arguments.model,
                **({"effort": arguments.effort} if arguments.effort != "default" else {}),
            )
        except TelemetryError as exc:
            telemetry_complete = False
            telemetry_errors.append(f"wait-start: {exc}")
    topology_error = record_dispatch_topology(
        arguments,
        accepted=True,
        intelligence_span_id=intelligence.span_id if intelligence else None,
        wait_span_id=wait_span.span_id if wait_span else None,
    )
    if topology_error:
        telemetry_complete = False
        telemetry_errors.append(f"dispatch-topology: {topology_error}")
    selector = selectors.DefaultSelector()
    cancelled_signal: int | None = None
    prior_handlers: dict[int, Any] = {}

    def cancel_handler(signum: int, _frame: Any) -> None:
        nonlocal cancelled_signal
        cancelled_signal = signum

    for signum in (signal.SIGINT, signal.SIGTERM):
        prior_handlers[signum] = signal.getsignal(signum)
        signal.signal(signum, cancel_handler)
    assert process.stdout is not None and process.stderr is not None
    selector.register(process.stdout, selectors.EVENT_READ, ("stdout", stdout_file))
    selector.register(process.stderr, selectors.EVENT_READ, ("stderr", stderr_file))
    try:
        while True:
            if cancelled_signal is not None:
                terminate_group(process)
                break
            now = time.monotonic()
            if now - started >= hard_limit:
                timeout_kind = "hard"
                break
            if first_event_at is None and now - started >= first_limit:
                timeout_kind = "first-event"
                break
            if first_event_at is not None and now - last_activity >= idle_limit:
                timeout_kind = "idle"
                break
            remaining = min(
                hard_limit - (now - started),
                (first_limit - (now - started))
                if first_event_at is None
                else (idle_limit - (now - last_activity)),
                1.0,
            )
            wait_for = max(0.05, remaining)
            if not selector.get_map():
                if process.poll() is not None:
                    break
                time.sleep(min(0.1, wait_for))
                continue
            events = selector.select(wait_for)
            for key, _ in events:
                stream_name, artifact = key.data
                chunk = os.read(key.fileobj.fileno(), 65536)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                observed = time.monotonic()
                longest_idle = max(longest_idle, observed - last_activity)
                last_activity = observed
                if stream_name == "stdout":
                    stdout_data.extend(chunk)
                    stdout_line_buffer.extend(chunk)
                    while b"\n" in stdout_line_buffer:
                        line, _, remainder = stdout_line_buffer.partition(b"\n")
                        stdout_line_buffer = bytearray(remainder)
                        try:
                            structured_event = json.loads(line.decode("utf-8", errors="replace"))
                        except json.JSONDecodeError:
                            structured_event = None
                        if first_event_at is None and isinstance(structured_event, dict):
                            first_event_at = observed
                    if first_event_at is None and stdout_line_buffer:
                        try:
                            trailing_event = json.loads(
                                stdout_line_buffer.decode("utf-8", errors="replace")
                            )
                        except json.JSONDecodeError:
                            trailing_event = None
                        if isinstance(trailing_event, dict):
                            first_event_at = observed
                    sys.stdout.buffer.write(chunk)
                    sys.stdout.buffer.flush()
                else:
                    sys.stderr.buffer.write(chunk)
                    sys.stderr.buffer.flush()
                if artifact:
                    artifact.write(chunk)
                    artifact.flush()
        if cancelled_signal is not None:
            return_code = 128 + cancelled_signal
        elif timeout_kind:
            terminate_group(process)
            return_code = TIMEOUT_EXIT
        else:
            return_code = process.wait()
    finally:
        selector.close()
        if stdout_file:
            stdout_file.close()
        if stderr_file:
            stderr_file.close()
        for signum, prior in prior_handlers.items():
            signal.signal(signum, prior)

    ended = time.monotonic()
    longest_idle = max(longest_idle, max(0.0, ended - last_activity))
    child_exit_code = None if timeout_kind or cancelled_signal is not None else return_code
    child_interrupted = child_exit_code is not None and child_exit_code < 0
    if child_exit_code is not None and child_exit_code < 0:
        child_exit_code = 128 + abs(child_exit_code)
        return_code = child_exit_code
    turns, input_tokens, output_tokens, result, assistant_text, event_types = parse_events(
        bytes(stdout_data), arguments.venue
    )
    protocol_errors: list[str] = []
    artifact_requested = result_path is not None or required_output_path is not None
    artifact_status = "not-requested"
    if result_path is not None:
        artifact = result if result and result.strip() else assistant_text
        if artifact and artifact.strip():
            result_path.write_text(artifact)
            artifact_status = "fresh"
        else:
            artifact_status = "missing"
    if required_output_path is not None:
        artifact_status = (
            "fresh"
            if required_output_path.exists() and required_output_path.stat().st_size > 0
            else "missing"
        )
    if arguments.venue == "claude":
        stream_complete = "result" in event_types and bool(result and result.strip())
    else:
        stream_complete = "turn.completed" in event_types
    stream_status = "complete" if stream_complete else "incomplete"
    if not timeout_kind and first_event_at is None:
        protocol_errors.append("no structured stdout event")
    if artifact_requested and artifact_status != "fresh":
        protocol_errors.append("required output artifact missing or empty")
    if not stream_complete:
        protocol_errors.append("terminal stream event missing or empty")

    if cancelled_signal is not None:
        return_code = 128 + cancelled_signal
        outcome = "cancelled"
    elif timeout_kind:
        return_code = TIMEOUT_EXIT
        outcome = "timeout"
    elif child_interrupted:
        return_code = child_exit_code
        outcome = "interrupted"
    elif child_exit_code != 0:
        return_code = child_exit_code
        outcome = "error"
    elif artifact_status == "fresh" and not stream_complete:
        return_code = RECOVERABLE_PROTOCOL_EXIT
        outcome = "completed_unverified_protocol"
    elif protocol_errors:
        return_code = PROTOCOL_EXIT
        outcome = "error"
    else:
        return_code = 0
        outcome = "success"
    telemetry_outcome = (
        "interrupted"
        if child_interrupted
        else "error"
        if outcome == "completed_unverified_protocol"
        else outcome
    )
    timeout_ns = (
        int(
            {"first-event": first_limit, "idle": idle_limit, "hard": hard_limit}[timeout_kind]
            * 1_000_000_000
        )
        if timeout_kind
        else None
    )
    for handle in (wait_span, intelligence):
        if handle is None:
            continue
        try:
            inject_telemetry_failure(
                "wait-finish" if handle is wait_span else "intelligence-finish"
            )
            finish_span(
                engine_root=REPO_ROOT,
                trace_id=handle.trace_id,
                span_id=handle.span_id,
                outcome=telemetry_outcome,
                exit_code=return_code,
                timeout_kind=timeout_kind,
                timeout_ns=timeout_ns,
            )
        except TelemetryError as exc:
            telemetry_complete = False
            telemetry_errors.append(f"span-finish: {exc}")
    duration_ns = None
    if intelligence is not None:
        try:
            inject_telemetry_failure("span-read")
            duration_ns = closed_span(
                engine_root=REPO_ROOT,
                trace_id=intelligence.trace_id,
                span_id=intelligence.span_id,
            )["duration_ns"]
        except TelemetryError as exc:
            telemetry_complete = False
            telemetry_errors.append(f"span-read: {exc}")
    diagnostic = {
        "schema_version": 3,
        "phase": arguments.phase,
        "role": arguments.role,
        "venue": arguments.venue,
        "model": arguments.model,
        "effort": arguments.effort,
        "started_at": started_iso,
        "ended_at": utc_now(),
        "trace_id": arguments.telemetry_trace_id,
        "span_id": intelligence.span_id if intelligence else None,
        "wait_span_id": wait_span.span_id if wait_span else None,
        "duration_ns": duration_ns,
        "first_event_seconds": (
            round(first_event_at - started, 3) if first_event_at is not None else None
        ),
        "longest_idle_seconds": round(longest_idle, 3),
        "turns": turns,
        "usage_scope": (
            "invocation" if input_tokens is not None or output_tokens is not None else "unavailable"
        ),
        "outcome": outcome,
        "timeout_kind": timeout_kind,
        "protocol_error": "; ".join(protocol_errors) if protocol_errors else None,
        "exit_code": return_code,
        "child_exit_code": child_exit_code,
        "artifact_status": artifact_status,
        "stream_status": stream_status,
        "program": Path(command[program_index]).name,
        "telemetry_complete": telemetry_complete,
        "telemetry_error": "; ".join(telemetry_errors) if telemetry_errors else None,
    }
    if input_tokens is not None:
        diagnostic["input_tokens"] = input_tokens
    if output_tokens is not None:
        diagnostic["output_tokens"] = output_tokens
    try:
        append_record(diagnostic, os.environ.get("KICKOFF_TIMING_LOG", DEFAULT_TELEMETRY))
    except OSError as exc:
        print(f"kickoff-config: local timing diagnostic write failed: {exc}", file=sys.stderr)
    if telemetry_errors:
        print(
            f"kickoff-config: telemetry incomplete: {'; '.join(telemetry_errors)}",
            file=sys.stderr,
        )
    if timeout_kind:
        print(
            f"kickoff-config: {arguments.role} timed out ({timeout_kind}) after "
            f"{ended - started:.1f}s",
            file=sys.stderr,
        )
    elif outcome == "completed_unverified_protocol":
        print(
            f"kickoff-config: {arguments.role} produced a fresh artifact but its "
            "terminal stream event is incomplete; explicit artifact verification required",
            file=sys.stderr,
        )
    elif protocol_errors:
        print(
            f"kickoff-config: {arguments.role} protocol error: {'; '.join(protocol_errors)}",
            file=sys.stderr,
        )
    return return_code


def percentile95(values: list[float]) -> float:
    ordered = sorted(values)
    return ordered[max(0, math.ceil(0.95 * len(ordered)) - 1)]


def recommend_timeouts(section: MutableMapping[str, Any]) -> None:
    telemetry_path = Path(os.environ.get("KICKOFF_TIMING_LOG", DEFAULT_TELEMETRY))
    if not telemetry_path.exists():
        print(f"No telemetry at {telemetry_path}.")
        return
    groups: dict[tuple[str, str, str, str], list[dict[str, Any]]] = {}
    lines = telemetry_path.read_text().splitlines()
    for line_number, line in enumerate(lines, 1):
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            print(f"Ignoring malformed telemetry line {line_number}.", file=sys.stderr)
            continue
        if record.get("schema_version") != 3:
            print(
                f"Ignoring non-schema-3 telemetry line {line_number}.",
                file=sys.stderr,
            )
            continue
        complete_sample = (
            record.get("outcome") == "success"
            and record.get("role") in ROLES
            and record.get("telemetry_complete") is True
            and isinstance(record.get("duration_ns"), int)
            and not isinstance(record.get("duration_ns"), bool)
            and record["duration_ns"] >= 0
            and isinstance(record.get("longest_idle_seconds"), (int, float))
            and not isinstance(record.get("longest_idle_seconds"), bool)
            and math.isfinite(float(record["longest_idle_seconds"]))
            and record["longest_idle_seconds"] >= 0
        )
        if record.get("outcome") == "success" and not complete_sample:
            print(
                f"Ignoring incomplete/malformed schema-3 telemetry line {line_number}.",
                file=sys.stderr,
            )
            continue
        if not complete_sample:
            continue
        key = tuple(
            str(record.get(field) or "default") for field in ("role", "venue", "model", "effort")
        )
        groups.setdefault(key, []).append(record)
    minimum = section["minimum_samples_for_recalibration"]
    multiplier = float(section["recalibration_multiplier"])
    printed = False
    for key, records in sorted(groups.items()):
        if len(records) < minimum:
            continue
        role = key[0]
        durations = [int(item["duration_ns"]) / 1_000_000_000 for item in records]
        gaps = [float(item["longest_idle_seconds"]) for item in records]
        role_config = section["roles"][role]
        hard = max(
            role_config["hard_floor_seconds"],
            math.ceil(multiplier * percentile95(durations)),
        )
        idle = max(
            role_config["idle_floor_seconds"],
            math.ceil(multiplier * percentile95(gaps)),
        )
        print(
            f"{role}/{key[1]} model={key[2]} effort={key[3]} n={len(records)}: "
            f"hard={hard}s idle={idle}s "
            f"(p95 duration={percentile95(durations):.1f}s, "
            f"p95 gap={percentile95(gaps):.1f}s)"
        )
        printed = True
    if not printed:
        print(f"No group has the required {minimum} successful samples yet.")
    timeout_count = sum(1 for line in lines if '"outcome":"timeout"' in line.replace(" ", ""))
    if timeout_count:
        print(
            f"Review {timeout_count} censored timeout record(s) separately before changing policy."
        )


def build_parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    subparsers = root.add_subparsers(dest="action", required=True)

    show_parser = subparsers.add_parser("show")
    show_parser.add_argument(
        "scope", nargs="?", choices=("all", "models", "timeouts"), default="all"
    )

    set_parser = subparsers.add_parser("set-models")
    set_parser.add_argument("arguments", nargs=argparse.REMAINDER)

    reset_parser = subparsers.add_parser("reset")
    reset_parser.add_argument("scope", choices=("models", "timeouts", "all"))

    subparsers.add_parser("preflight")
    subparsers.add_parser("recommend-timeouts")

    def add_routing_arguments(parser: argparse.ArgumentParser) -> None:
        parser.add_argument("--role", required=True, choices=ROLES)
        parser.add_argument("--venue", required=True, choices=("claude", "codex"))
        parser.add_argument("--model", required=True, choices=MODELS)
        parser.add_argument("--effort", default="default", choices=("default", *CLAUDE_EFFORTS))
        parser.add_argument("--prompt-file", required=True)
        parser.add_argument("--result-file")
        parser.add_argument("--required-output-file")
        parser.add_argument(
            "--resume-session",
            help="provider session id; produces the venue's resume invocation",
        )

    watch_parser = subparsers.add_parser(
        "watch",
        description=(
            "Generate and watch one delegated role invocation. The claude/codex "
            "command line is built here from the routing metadata, never supplied "
            "by the caller. Codex workspace-write dispatches receive UV_NO_SYNC=1 "
            "and runtime-resolved uv writable roots. UV_NO_SYNC skips virtualenv "
            "synchronization; this is sound only because --locked still rejects "
            "lock/pyproject drift and the host provisions the venv. "
            "Dependency-changing work must sync on the host first or use a native coder."
        ),
    )
    add_routing_arguments(watch_parser)
    watch_parser.add_argument("--phase", required=True)
    watch_parser.add_argument("--stdout-file")
    watch_parser.add_argument("--stderr-file")
    watch_parser.add_argument("--first-event-timeout", type=float)
    watch_parser.add_argument("--idle-timeout", type=float)
    watch_parser.add_argument("--hard-timeout", type=float)
    watch_parser.add_argument("--telemetry-trace-id")
    watch_parser.add_argument("--telemetry-parent-span-id")
    watch_parser.add_argument("--telemetry-operation")
    watch_parser.add_argument("--telemetry-attempt", type=int)
    watch_parser.add_argument("--telemetry-role-registration")

    render_parser = subparsers.add_parser(
        "render-command",
        description=(
            "Print the exact delegated invocation watch would spawn, without "
            "spawning it. The inspection path for the generated recipe."
        ),
    )
    add_routing_arguments(render_parser)
    render_parser.add_argument("--json", action="store_true", help="emit the argv as a JSON array")
    return root


def main() -> None:
    # REPO_ROOT is already resolved from the script's own location (or, for a
    # pinned bundle, from KICKOFF_ENGINE_ROOT). Asking git for the toplevel
    # instead made this tool require a repository it never reads: inside a
    # Gate 9 worker copy, which carries no `.git`, every invocation died on a
    # CalledProcessError traceback before parsing a single argument.
    os.chdir(REPO_ROOT)
    arguments = build_parser().parse_args()
    if arguments.action == "reset":
        reset(arguments.scope)
        return
    document = load_document()
    if arguments.action == "show":
        show(document, arguments.scope)
    elif arguments.action == "set-models":
        set_models(arguments.arguments)
    elif arguments.action == "preflight":
        preflight(document["role_models"])
    elif arguments.action == "watch":
        raise SystemExit(watch(arguments, document["role_timeouts"]))
    elif arguments.action == "render-command":
        command = build_watch_command(arguments, document["role_timeouts"])
        validate_watch_routing(arguments, command)
        if arguments.json:
            print(json.dumps(command))
        else:
            print("\n".join(command))
    else:
        recommend_timeouts(document["role_timeouts"])


if __name__ == "__main__":
    main()
