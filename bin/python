#!/usr/bin/env bash
# Run the repository-selected Python interpreter.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_root="$repo_root/project"

toolchain_helper="$repo_root/bin/_python-toolchain"
if [[ ! -r "$toolchain_helper" ]]; then
  echo "PYTHON ERROR missing required file: bin/_python-toolchain" >&2
  exit 1
fi
source "$toolchain_helper"
python_toolchain_init PYTHON

cd "$repo_root"
python_toolchain_probe
exec uv run --project "$project_root" --locked "${python_toolchain_uv_args[@]}" python "$@"
