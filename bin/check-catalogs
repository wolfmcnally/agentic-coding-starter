#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Fail closed when durable-document catalogs, links, or citations drift.

Covers catalog/file sync, the phase-ledger state machine, tracked internal
link targets *and* their `#fragment` anchors, the one-way citation
direction between briefs, policies, and the plan, and the `docs/` contract:
every pinned third-party document is cataloged in `docs/README.md`, and no
file under `docs/` links outside `docs/`.
"""

from __future__ import annotations

import argparse
import re
import subprocess
from collections.abc import Iterable
from pathlib import Path
from urllib.parse import unquote

ROOT = Path(__file__).resolve().parents[1]
DRIFT: list[str] = []
ANCHOR_CACHE: dict[Path, frozenset[str] | None] = {}

CATALOGED_DIRECTORIES = ("policies", "briefs")
# policies/briefs-and-policies.md contract item 1: a policy or a plan file may
# cite a brief, and a brief never cites a policy or a plan file. The thinking
# predates the rule derived from it, so the citation runs one way only.
CITATION_SOURCE_DIRECTORY = "briefs"
CITATION_FORBIDDEN_DIRECTORIES = ("policies", "plan")
# policies/docs.md: pinned third-party material never references the project.
# Every top-level entry under docs/ is linked from docs/README.md, and no file
# under docs/ (other than that project-owned catalog) links outside docs/.
DOCS_DIRECTORY = "docs"
DOCS_CATALOG = "README.md"
PHASE_STATUSES = ("⏳", "⬅️", "🚧", "✅")
NEXT_MARKER = "⬅️"
IN_PROGRESS_MARKER = "🚧"
NOT_STARTED_MARKER = "⏳"
FENCE_PATTERN = re.compile(r"^ {0,3}(`{3,}|~{3,})")
# An inline code span is quotation, not prose: a link inside backticks is a
# quoted edit target, not a live link, so it is exempt the same way fenced
# blocks are. The pattern honors CommonMark's equal-length backtick delimiters.
CODE_SPAN_PATTERN = re.compile(r"(?<!`)(`+)(?!`)(?:.+?)(?<!`)\1(?!`)")
INLINE_LINK_PATTERN = re.compile(r"!?\[[^\]\n]*\]\((?P<destination>[^)\n]+)\)")
REFERENCE_LINK_PATTERN = re.compile(r"^ {0,3}\[[^\]\n]+\]:\s*(?P<destination><[^>\n]+>|\S+)")
URI_SCHEME_PATTERN = re.compile(r"^[A-Za-z][A-Za-z0-9+.-]*:")
ATX_HEADING_PATTERN = re.compile(r"^ {0,3}#{1,6}\s+(?P<text>\S.*?)(?:\s+#+)?\s*$")
# A heading's anchor is derived from its *rendered* text, so inline markup is
# removed before slugging: link syntax collapses to its label, and code-span,
# emphasis, and strong markers drop out.
HEADING_LINK_PATTERN = re.compile(r"!?\[(?P<label>[^\]\n]*)\]\([^)\n]*\)")
HEADING_MARKUP_PATTERN = re.compile(r"[`*]")
ANCHOR_DISALLOWED_PATTERN = re.compile(r"[^\w\- ]")
PLACEHOLDER_PATTERN = re.compile(r"<[^>]+>|\{[^}]+\}")
FRONTMATTER_STATUS_PATTERN = re.compile(r"^status\s*:", re.IGNORECASE)
STATUS_DECLARATION_PATTERN = re.compile(
    r"^ {0,3}\*{0,2}status\*{0,2}\s*:\s*(⏳|⬅️|🚧|✅|not started|next|in progress|completed)",
    re.IGNORECASE,
)


def report(surface: str, relative: str, reason: str) -> None:
    DRIFT.append(f"ERROR\t{surface}\t{relative}\t{reason}")


def check_catalog(directory: str, instructions: str) -> None:
    base = ROOT / directory
    on_disk = {item.name for item in base.glob("*.md")}
    referenced = set(re.findall(rf"{directory}/([A-Za-z0-9._-]+\.md)", instructions))
    for name in sorted(on_disk - referenced):
        report(directory, f"{directory}/{name}", "file is not indexed in CLAUDE.md")
    for name in sorted(referenced - on_disk):
        report(directory, f"{directory}/{name}", "CLAUDE.md references a missing file")


def check_instruction_delivery(instructions: str) -> None:
    """Check the declared instruction form, not the meaning or model adherence."""
    entry_relative = ".claude/skills/kickoff/SKILL.md"
    entry = ROOT / entry_relative
    try:
        entry_text = entry.read_bytes().decode("utf-8")
    except (OSError, UnicodeError) as exc:
        report("instructions", entry_relative, f"required entry is unreadable: {exc}")
        entry_text = ""
    for relative, text, ceiling in (
        ("CLAUDE.md", instructions, 16384),
        (entry_relative, entry_text, 8192),
    ):
        size = len(text.encode("utf-8"))
        if size > ceiling:
            report("instructions", relative, f"UTF-8 size {size} exceeds {ceiling} bytes")

    markers = [
        f"<!-- {name} -->"
        for name in (
            "PROJECT_CONTEXT_START",
            "PROJECT_CONTEXT_END",
            "METHODOLOGY_CONTRACT_START",
            "METHODOLOGY_CONTRACT_END",
        )
    ]
    if any(instructions.count(marker) != 1 for marker in markers):
        report("instructions", "CLAUDE.md", "zone markers must each occur exactly once")
    elif [instructions.index(marker) for marker in markers] != sorted(
        instructions.index(marker) for marker in markers
    ):
        report("instructions", "CLAUDE.md", "zone markers must occur in declared order")

    # Only rows of the declared table can discharge a resource's loading duty.
    # A navigation link, quoted example, or instruction elsewhere cannot do so.
    rows: dict[str, list[str]] = {}
    in_table = False
    separator_pending = False
    operative_text = re.sub(r"<!--.*?-->", "", entry_text, flags=re.DOTALL)
    for _, line in markdown_prose_lines(operative_text):
        if not re.match(r"^ {0,3}\|", line):
            in_table = False
            separator_pending = False
            continue
        cells = [cell.strip() for cell in line.strip().strip("|").split("|")]
        if cells == ["Execution condition", "Direct resource", "Load requirement"]:
            separator_pending = True
            in_table = False
            continue
        if separator_pending:
            in_table = len(cells) == 3 and all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells)
            separator_pending = False
            continue
        if not in_table or len(cells) != 3:
            continue
        condition, resource, requirement = cells
        direct = re.fullmatch(r"\[[^\]\n]+\]\(([^)\n]+)\)", resource)
        if direct is None or not CODE_SPAN_PATTERN.sub("", condition).strip():
            continue
        destination = link_destination(direct.group(1))
        if destination is not None:
            rows.setdefault(destination, []).append(requirement)

    for name in (
        "preflight.md",
        "dispatch.md",
        "planning.md",
        "implementation.md",
        "acceptance.md",
        "close.md",
        "recovery.md",
    ):
        relative = entry.parent.relative_to(ROOT) / name
        try:
            (ROOT / relative).read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            report("instructions", relative.as_posix(), f"required resource is unreadable: {exc}")
        requirements = rows.get(name, [])
        if len(requirements) != 1:
            report(
                "instructions",
                entry_relative,
                f"{name}: expected one operative row with a direct resource link",
            )
        elif not re.fullmatch(r"Read before \S.*", CODE_SPAN_PATTERN.sub("", requirements[0])):
            report("instructions", entry_relative, f"{name}: row must declare Read before use")


def phase_rows(lines: list[str]) -> list[str]:
    in_phase_table = False
    table_started = False
    raw_rows: list[str] = []
    for line in lines:
        if line.strip().casefold() == "## phase table":
            in_phase_table = True
            continue
        if in_phase_table and line.startswith("## "):
            break
        if not in_phase_table:
            continue
        if line.lstrip().startswith("|"):
            table_started = True
            raw_rows.append(line)
        elif table_started and line.strip():
            break

    rows: list[str] = []
    for row in raw_rows:
        cells = [cell.strip() for cell in row.strip().strip("|").split("|")]
        if not cells or cells[0].casefold() == "phase":
            continue
        if all(re.fullmatch(r":?-{3,}:?", cell) for cell in cells):
            continue
        rows.append(row)
    return rows


def check_phase_ledger() -> None:
    index = ROOT / "plan" / "INDEX.md"
    try:
        lines = index.read_text(encoding="utf-8").splitlines()
    except OSError as exc:
        report("plan", "plan/INDEX.md", str(exc))
        return

    rows = phase_rows(lines)
    if not rows:
        report("plan", "plan/INDEX.md", "phase table has no data rows")
        return

    row_markers: list[str | None] = []
    for position, row in enumerate(rows, start=1):
        markers = [marker for marker in PHASE_STATUSES if marker in row]
        if len(markers) != 1:
            report(
                "plan",
                "plan/INDEX.md",
                f"phase row {position} must carry exactly one status marker; found {len(markers)}",
            )
            row_markers.append(None)
        else:
            row_markers.append(markers[0])

    next_count = row_markers.count(NEXT_MARKER)
    in_progress_count = row_markers.count(IN_PROGRESS_MARKER)
    not_started_count = row_markers.count(NOT_STARTED_MARKER)
    if next_count > 1:
        report(
            "plan",
            "plan/INDEX.md",
            f"phase table may carry at most one {NEXT_MARKER} marker; found {next_count}",
        )
    elif next_count == 0 and in_progress_count == 0 and not_started_count > 0:
        report(
            "plan",
            "plan/INDEX.md",
            f"idle incomplete phase table must carry exactly one {NEXT_MARKER} marker; found 0",
        )


def check_closing_phase(phase: str) -> None:
    """A completed child cannot leave its parent with no truthful continuation."""
    if "." not in phase:
        return
    index = ROOT / "plan" / "INDEX.md"
    try:
        rows = phase_rows(index.read_text(encoding="utf-8").splitlines())
    except OSError as exc:
        report("plan-close", "plan/INDEX.md", str(exc))
        return
    entries: dict[str, tuple[str | None, str]] = {}
    for row in rows:
        match = re.search(r"\bPhase\s+([0-9]+(?:\.[0-9]+)*)\b", row)
        if match:
            markers = [marker for marker in PHASE_STATUSES if marker in row]
            entries[match.group(1)] = (markers[0] if len(markers) == 1 else None, row)
    current = entries.get(phase)
    if current is None or current[0] != "✅":
        report(
            "plan-close",
            "plan/INDEX.md",
            f"closing child Phase {phase} must exist and be marked ✅",
        )
        return
    parent = phase.rsplit(".", 1)[0]
    parent_entry = entries.get(parent)
    if parent_entry is None:
        report("plan-close", "plan/INDEX.md", f"Phase {phase} has no parent Phase {parent}")
        return
    if parent_entry[0] == "✅":
        return
    siblings = [
        child
        for child, (marker, _) in entries.items()
        if child != phase
        and child.rsplit(".", 1)[0] == parent
        and marker in {"⏳", "⬅️", "🚧"}
        and (ROOT / "plan" / f"phase-{child}.md").is_file()
    ]
    if parent_entry[0] != "🚧" or not siblings:
        report(
            "plan-close",
            "plan/INDEX.md",
            f"closing child Phase {phase} must close parent Phase {parent} or leave it 🚧 "
            "with another drafted incomplete direct child",
        )


def frontmatter_lines(text: str) -> list[tuple[int, str]]:
    lines = text.splitlines()
    if not lines or lines[0].strip() != "---":
        return []
    block: list[tuple[int, str]] = []
    for line_number, line in enumerate(lines[1:], start=2):
        if line.strip() in ("---", "..."):
            return block
        block.append((line_number, line))
    return []


def check_phase_files() -> None:
    """Status lives only in plan/INDEX.md's phase table (policies/phase-status.md).

    Narrative mentions of the status emojis in prose are fine; the failure mode
    is a *declaration* — a frontmatter `status:` key or a `Status: ✅`-shaped
    line — which creates a second source of truth.
    """
    for phase_file in sorted((ROOT / "plan").glob("phase-*.md")):
        relative = phase_file.relative_to(ROOT).as_posix()
        try:
            text = phase_file.read_text(encoding="utf-8")
        except OSError as exc:
            report("plan", relative, str(exc))
            continue
        frontmatter = frontmatter_lines(text)
        for line_number, line in frontmatter:
            if FRONTMATTER_STATUS_PATTERN.match(line):
                report(
                    "plan",
                    relative,
                    f"line {line_number}: frontmatter must not carry a status field",
                )
        frontmatter_numbers = {line_number for line_number, _ in frontmatter}
        for line_number, line in markdown_prose_lines(text):
            if line_number in frontmatter_numbers:
                continue
            if STATUS_DECLARATION_PATTERN.match(CODE_SPAN_PATTERN.sub("", line)):
                report(
                    "plan",
                    relative,
                    f"line {line_number}: status declaration outside plan/INDEX.md's phase table",
                )


def candidate_markdown_files() -> list[Path]:
    result = subprocess.run(
        [
            "git",
            "-C",
            str(ROOT),
            "ls-files",
            "-z",
            "--cached",
            "--others",
            "--exclude-standard",
            "--",
            "*.md",
        ],
        capture_output=True,
        check=False,
    )
    if result.returncode != 0:
        message = result.stderr.decode("utf-8", errors="replace").strip()
        report("links", ".", f"git ls-files failed (exit {result.returncode}): {message}")
        return []
    candidates = [ROOT / item.decode("utf-8") for item in result.stdout.split(b"\0") if item]
    return [path for path in candidates if path.is_file()]


def markdown_prose_lines(text: str) -> Iterable[tuple[int, str]]:
    fence_character: str | None = None
    fence_length = 0
    for line_number, line in enumerate(text.splitlines(), start=1):
        match = FENCE_PATTERN.match(line)
        if match:
            marker = match.group(1)
            if fence_character is None:
                fence_character = marker[0]
                fence_length = len(marker)
            elif marker[0] == fence_character and len(marker) >= fence_length:
                fence_character = None
                fence_length = 0
            continue
        if fence_character is None:
            yield line_number, line


def link_destination(raw_destination: str) -> str | None:
    raw = raw_destination.strip()
    if not raw:
        return None
    if raw.startswith("<"):
        closing = raw.find(">")
        if closing == -1:
            return None
        suffix = raw[closing + 1 :].strip()
        if suffix and not suffix.startswith(('"', "'", "(")):
            return None
        destination = raw[1:closing]
    else:
        destination = raw.split(maxsplit=1)[0]
    return unquote(destination.replace("\\(", "(").replace("\\)", ")"))


def heading_slug(text: str) -> str:
    """Slugify heading text the way Markdown hosts derive a heading anchor."""
    rendered = HEADING_LINK_PATTERN.sub(lambda match: match.group("label"), text)
    rendered = HEADING_MARKUP_PATTERN.sub("", rendered)
    return ANCHOR_DISALLOWED_PATTERN.sub("", rendered.strip().lower()).replace(" ", "-")


def document_anchors(path: Path) -> frozenset[str] | None:
    """Anchors a Markdown document defines, or None when they cannot be derived.

    Only Markdown targets have a mechanically derivable anchor set. A fragment
    into any other file kind is skipped rather than guessed at — a declared
    blind spot, not a silent pass for Markdown.
    """
    key = path.resolve(strict=False)
    if key in ANCHOR_CACHE:
        return ANCHOR_CACHE[key]

    anchors: frozenset[str] | None = None
    if path.suffix.lower() == ".md":
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            anchors = None
        else:
            frontmatter_numbers = {line_number for line_number, _ in frontmatter_lines(text)}
            seen: dict[str, int] = {}
            collected: set[str] = set()
            for line_number, line in markdown_prose_lines(text):
                if line_number in frontmatter_numbers:
                    continue
                match = ATX_HEADING_PATTERN.match(line)
                if match is None:
                    continue
                slug = heading_slug(match.group("text"))
                if not slug:
                    continue
                # Repeated heading text disambiguates as slug, slug-1, slug-2…
                occurrence = seen.get(slug, 0)
                seen[slug] = occurrence + 1
                collected.add(slug if occurrence == 0 else f"{slug}-{occurrence}")
            anchors = frozenset(collected)

    ANCHOR_CACHE[key] = anchors
    return anchors


def check_fragment(source: Path, line_number: int, target: Path, fragment: str) -> None:
    anchors = document_anchors(target)
    if anchors is None or fragment in anchors:
        return
    resolved_target = target.resolve(strict=False)
    try:
        shown = resolved_target.relative_to(ROOT.resolve()).as_posix()
    except ValueError:
        shown = resolved_target.as_posix()
    report(
        "links",
        source.relative_to(ROOT).as_posix(),
        f"line {line_number}: missing anchor #{fragment} in {shown}",
    )


def check_citation_direction(
    source: Path, line_number: int, relative_target: Path, destination: str
) -> None:
    """A brief never cites a policy or a plan file (policies/briefs-and-policies.md).

    Direction is judged before the target's existence: citing a policy that does
    not exist inverts the dependency order just the same.
    """
    relative_source = source.relative_to(ROOT)
    if relative_source.parts[:1] != (CITATION_SOURCE_DIRECTORY,):
        return
    if not relative_target.parts or relative_target.parts[0] not in CITATION_FORBIDDEN_DIRECTORIES:
        return
    report(
        "citations",
        relative_source.as_posix(),
        f"line {line_number}: brief cites {relative_target.as_posix()} ({destination}); "
        "state the constraint in the brief's own words and let the policy carry the link back",
    )


def check_docs_containment(
    source: Path, line_number: int, relative_target: Path, destination: str
) -> None:
    """A pinned third-party document never links outside docs/ (policies/docs.md).

    The catalog docs/README.md is project-owned and exempt; it may cite the
    governing policy. Direction is judged before the target's existence.
    """
    relative_source = source.relative_to(ROOT)
    if relative_source.parts[:1] != (DOCS_DIRECTORY,):
        return
    if relative_source == Path(DOCS_DIRECTORY, DOCS_CATALOG):
        return
    if relative_target.parts[:1] == (DOCS_DIRECTORY,):
        return
    report(
        "docs",
        relative_source.as_posix(),
        f"line {line_number}: pinned document links outside {DOCS_DIRECTORY}/ "
        f"({destination}); third-party material never references the project",
    )


def docs_catalog_links(catalog: Path) -> set[str]:
    """Top-level docs/ entry names that catalog rows link to."""
    referenced: set[str] = set()
    try:
        text = catalog.read_text(encoding="utf-8")
    except OSError as exc:
        report("docs", catalog.relative_to(ROOT).as_posix(), str(exc))
        return referenced
    docs_root = (ROOT / DOCS_DIRECTORY).resolve()
    for _line_number, raw_line in markdown_prose_lines(text):
        line = CODE_SPAN_PATTERN.sub("", raw_line)
        destinations = [match.group("destination") for match in INLINE_LINK_PATTERN.finditer(line)]
        reference_match = REFERENCE_LINK_PATTERN.match(line)
        if reference_match:
            destinations.append(reference_match.group("destination"))
        for raw_destination in destinations:
            destination = link_destination(raw_destination)
            if destination is None or URI_SCHEME_PATTERN.match(destination):
                continue
            file_part = destination.partition("#")[0].split("?", 1)[0]
            if not file_part:
                continue
            if file_part.startswith("/"):
                candidate = ROOT / file_part.lstrip("/")
            else:
                candidate = catalog.parent / file_part
            try:
                relative = candidate.resolve(strict=False).relative_to(docs_root)
            except ValueError:
                continue
            if relative.parts:
                referenced.add(relative.parts[0])
    return referenced


def check_docs_catalog() -> None:
    """Every top-level docs/ entry is linked from docs/README.md (policies/docs.md).

    Missing link targets are reported by the ordinary link check; this check
    owns the converse — an entry on disk that no catalog row names — and the
    README's presence whenever the directory holds anything else.
    """
    base = ROOT / DOCS_DIRECTORY
    if not base.is_dir():
        return
    entries = sorted(
        item.name
        for item in base.iterdir()
        if item.name != DOCS_CATALOG and not item.name.startswith(".")
    )
    catalog = base / DOCS_CATALOG
    if not catalog.is_file():
        if entries:
            report(
                "docs",
                f"{DOCS_DIRECTORY}/{DOCS_CATALOG}",
                f"catalog is missing while {DOCS_DIRECTORY}/ holds {len(entries)} entries",
            )
        return
    referenced = docs_catalog_links(catalog)
    for name in entries:
        if name not in referenced:
            report(
                "docs",
                f"{DOCS_DIRECTORY}/{name}",
                f"entry is not linked from any {DOCS_DIRECTORY}/{DOCS_CATALOG} catalog row",
            )


def check_link(source: Path, line_number: int, destination: str) -> None:
    if (
        not destination
        or destination.startswith("//")
        or URI_SCHEME_PATTERN.match(destination)
        or PLACEHOLDER_PATTERN.search(destination)
    ):
        return

    file_part, has_fragment, fragment = destination.partition("#")
    fragment = fragment.strip()
    file_destination = file_part.split("?", 1)[0]
    if not file_destination:
        # A same-document link resolves against the source file's own headings.
        if has_fragment and fragment:
            check_fragment(source, line_number, source, fragment)
        return
    if file_destination.startswith("/"):
        candidate = ROOT / file_destination.lstrip("/")
    else:
        candidate = source.parent / file_destination
    resolved_root = ROOT.resolve()
    resolved_candidate = candidate.resolve(strict=False)
    try:
        relative_candidate = resolved_candidate.relative_to(resolved_root)
    except ValueError:
        report(
            "links",
            source.relative_to(ROOT).as_posix(),
            f"line {line_number}: link escapes repository: {destination}",
        )
        return
    check_citation_direction(source, line_number, relative_candidate, destination)
    check_docs_containment(source, line_number, relative_candidate, destination)
    if not candidate.exists():
        report(
            "links",
            source.relative_to(ROOT).as_posix(),
            f"line {line_number}: missing target {relative_candidate.as_posix()}",
        )
        return
    if has_fragment and fragment:
        check_fragment(source, line_number, candidate, fragment)


def check_markdown_links() -> None:
    for source in candidate_markdown_files():
        try:
            text = source.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            report("links", source.relative_to(ROOT).as_posix(), str(exc))
            continue
        for line_number, raw_line in markdown_prose_lines(text):
            line = CODE_SPAN_PATTERN.sub("", raw_line)
            destinations = [
                match.group("destination") for match in INLINE_LINK_PATTERN.finditer(line)
            ]
            reference_match = REFERENCE_LINK_PATTERN.match(line)
            if reference_match:
                destinations.append(reference_match.group("destination"))
            for raw_destination in destinations:
                destination = link_destination(raw_destination)
                if destination is not None:
                    check_link(source, line_number, destination)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--closing-phase")
    arguments = parser.parse_args()
    try:
        instructions = (ROOT / "CLAUDE.md").read_bytes().decode("utf-8")
    except (OSError, UnicodeError) as exc:
        report("instructions", "CLAUDE.md", str(exc))
        instructions = ""
    check_instruction_delivery(instructions)
    if instructions:
        for directory in CATALOGED_DIRECTORIES:
            check_catalog(directory, instructions)
    check_docs_catalog()
    check_phase_ledger()
    if arguments.closing_phase:
        check_closing_phase(arguments.closing_phase)
    check_phase_files()
    check_markdown_links()
    if DRIFT:
        print("\n".join(sorted(DRIFT)))
        return 1
    print("CATALOGS OK")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
