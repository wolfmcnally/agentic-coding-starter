#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Reject operational Python calls that bypass the repository's repository runtime."""

from __future__ import annotations

import argparse
import re
from collections.abc import Iterable
from pathlib import Path

# Surfaces something actually executes: scripts, hooks, skills, procedures, and
# plans an agent follows. `briefs/` is deliberately absent — briefs hold
# rationale and field reports, and a regex cannot tell "run `python foo.py`" (an
# instruction) from "the shebang resolved to the ambient interpreter, which was
# 3.10" (a description of the defect being reported). While the invocation
# recipes still lived in a brief the scan was correct to include it, and the
# consequence was a defect report that could not quote the defect it reported.
# The recipes are now generated by `bin/kickoff-config watch`, so the scan can
# narrow to what runs. Narrowing this *before* that mechanization would have
# left a real hole. See `the generated-invocation contract.
SCAN_ROOTS = (
    "bin",
    ".githooks",
    ".claude/hooks",
    ".codex/hooks",
    ".claude/skills",
    "policies",
    "plan",
    "proposals",
    "lib",
    "infra",
    "web",
)
SCAN_FILES = ("CLAUDE.md",)
EXCLUDED = {
    "bin/_python-toolchain",
    "bin/check-toolchain-callers",
    "bin/python",
    "bin/setup",
    "bin/test",
}
EXCLUDED_DIRECTORY_NAMES = {
    ".git",
    ".venv",
    "__pycache__",
    "dist",
    "node_modules",
}
VERSIONED = re.compile(r"(?<![\w./-])python3(?:\.\d+)?(?=\s|[\"'`])")
AMBIENT = re.compile(r"(?<![\w./-])python(?=\s+(?:-|/|\./|\.\./|bin/|tests/|\$|[\"']))")


def _candidate_files(root: Path) -> Iterable[Path]:
    for relative in SCAN_ROOTS:
        base = root / relative
        if not base.exists():
            continue
        for path in sorted(base.rglob("*")):
            if path.is_file() and not EXCLUDED_DIRECTORY_NAMES.intersection(path.parts):
                yield path
    for relative in SCAN_FILES:
        path = root / relative
        if path.is_file():
            yield path


def _allowed_external_literal(relative: str, line: str) -> bool:
    if "#!/usr/bin/env python3" in line:
        return True
    if "uv run" in line and " python " in line:
        return True
    if "`python3" in line and (
        "assum" in line
        or "runtime executable" in line
        or "versioned `python3" in line
        or (
            relative in {"CLAUDE.md", "policies/build-gates.md"}
            and line.lstrip().startswith("`python3")
        )
    ):
        return True
    # The repo-managed venv interpreter, resolved once inside a tool's own
    # shared `ensure_supported_python` guard. `policies/build-gates.md` sanctions
    # "./bin/python or a once-resolved interpreter"; this is the latter, and it
    # exists precisely so these tools stop binding to an ambient interpreter.
    if '".venv"' in line and '"bin"' in line and '"python3"' in line:
        return True
    if "--runtime python3.12" in line:
        return True
    if "external-platform runtime literals" in line and "`python3.12`" in line:
        return True
    if "ambient `python`" in line and "versioned `python3" in line:
        return True
    return relative.endswith("Dockerfile") and "python -m pip" in line


def violations(root: Path) -> list[str]:
    found: list[str] = []
    for path in _candidate_files(root):
        relative = path.relative_to(root).as_posix()
        if relative in EXCLUDED:
            continue
        try:
            lines = path.read_text(encoding="utf-8").splitlines()
        except (UnicodeDecodeError, OSError):
            continue
        for number, line in enumerate(lines, start=1):
            if number == 1 and line.startswith("#!") and "python" in line:
                continue
            if _allowed_external_literal(relative, line):
                continue
            if VERSIONED.search(line) or AMBIENT.search(line):
                found.append(f"{relative}:{number}: {line.strip()}")
    return found


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--root",
        type=Path,
        default=Path(__file__).resolve().parent.parent,
        help=argparse.SUPPRESS,
    )
    args = parser.parse_args()
    found = violations(args.root.resolve())
    if found:
        print(
            "Ambient Python callers are forbidden; use ./bin/python or a once-resolved interpreter:"
        )
        print("\n".join(found))
        return 1
    print("Toolchain caller policy clean")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
