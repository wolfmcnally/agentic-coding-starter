#!/usr/bin/env bash
# One governed log-policy surface for hooks, command manifests, and full gates.

set -euo pipefail

entrypoint_path="${BASH_SOURCE[0]}"
while [[ -L "$entrypoint_path" ]]; do
  entrypoint_dir="$(cd "$(dirname "$entrypoint_path")" && pwd)"
  entrypoint_path="$(readlink "$entrypoint_path")"
  [[ "$entrypoint_path" == /* ]] || entrypoint_path="$entrypoint_dir/$entrypoint_path"
done
repo_root="$(cd "$(dirname "$entrypoint_path")/.." && pwd)"

arguments=(--root "$repo_root" --require-terminal-lessons)
chronology=(--root "$repo_root")
if [[ "${1:-}" == "--staged" ]]; then
  arguments+=(--staged)
  chronology+=(--staged)
  shift
fi
if [[ $# -ne 0 ]]; then
  echo "Usage: ./bin/check-log [--staged]" >&2
  exit 2
fi

"$repo_root/bin/check-log-prefix" "${arguments[@]}"
"$repo_root/bin/check-log-monotonic" "${chronology[@]}"
