#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# ///
"""Refuse an implementation plan that cites what it never read or defers what it owes.

Mechanistic pre-review over one `phase-planner` artifact, run by `kickoff`
between plan capture and plan review. It catches the defect shapes that a
month of plan-review rejections showed to be both the most frequent and the
most mechanically detectable — none of them needs judgment, all of them cost a
review round when a reviewer finds them instead:

- **A name the planner did not read.** Every backticked identifier the plan
  cites (a function, field, enum member, column, CLI flag) either occurs
  somewhere in the repository tree or is declared in the plan's
  `## Definitions Read` table — as read from a named file, or as *new*.
  Each *read* row is verified against the file it names.
- **A path that does not exist** and is not declared as a new file.
- **A command that cannot run as written**: a repository script that is
  absent, a `--flag` no argparse definition in that script spells, a
  `<placeholder>` token, or a 64-hex candidate id pinned before the
  implementation that will change it.
- **Work deferred to the coder**: `or equivalent`, `verify before coding`,
  `TBD`, and their siblings.

Exit 0 prints `PLAN CONCRETENESS PASS`; exit 1 prints one
`ERROR\\t<check>\\t<line>\\t<message>` row per refusal; exit 2 is a usage or
I/O error. The plan file may live anywhere; `--root` names the repository it
describes (default: the current working tree's Git top level).
"""

from __future__ import annotations

import argparse
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT / "lib"))

from agentic_starter.plan_artifact import (  # noqa: E402
    CODE_SPAN_PATTERN,
    FLAG_PATTERN,
    NEW_MARKERS,
    NODE_ID_PATTERN,
    PATH_SUFFIXES,
    Plan,
    Tree,
    identifier_shape,
    looks_like_path,
    parse_plan,
    path_of,
)

PLACEHOLDER_TOKEN_PATTERN = re.compile(r"<[A-Za-z][^<>\n]*>")
CANDIDATE_ID_PATTERN = re.compile(r"(?<![0-9a-fA-F])[0-9a-f]{64}(?![0-9a-fA-F])")
ARGPARSE_FLAG_PATTERN = re.compile(r"""["'](--[a-z][\w-]*)["']""")
DEFERRAL_PATTERNS: tuple[tuple[str, re.Pattern[str]], ...] = (
    ("or equivalent", re.compile(r"\bor equivalent\b", re.IGNORECASE)),
    ("or similar", re.compile(r"\bor similar\b", re.IGNORECASE)),
    ("TBD", re.compile(r"\bTBD\b")),
    ("TODO", re.compile(r"\bTODO\b")),
    ("to be determined", re.compile(r"\bto be determined\b", re.IGNORECASE)),
    (
        "deferred verification",
        re.compile(
            r"\b(verify|confirm|check|determine|resolve)\b[^.\n]{0,80}"
            r"\b(before|during|at)\s+(coding|implementing|implementation)\b",
            re.IGNORECASE,
        ),
    ),
    (
        "deferred to the coder",
        re.compile(
            r"\bthe (coder|implementer) (should|must|will) (verify|confirm|determine)\b",
            re.IGNORECASE,
        ),
    ),
)
# argparse defines these without being asked.
IMPLICIT_FLAGS = {"--help"}
# Not checkable against this tree: external constants and environment
# variables (`O_EXCL`, `GIT_CONFIG_COUNT`) and the tests a plan introduces by
# name, which exist only once the coder writes them.
EXEMPT_IDENTIFIER_PATTERN = re.compile(r"^(?:[A-Z][A-Z0-9_]*|test_\w+)$")


def argparse_flags(script: Path) -> set[str] | None:
    """Flags an argparse-based Python script spells; None when not checkable."""
    try:
        source = script.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return None
    if "add_argument" not in source and "add_parser" not in source:
        return None
    return set(ARGPARSE_FLAG_PATTERN.findall(source))


def check_commands(plan: Plan, tree: Tree, errors: list[tuple[str, int, str]]) -> None:
    for number, line in plan.commands:
        stripped = line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        for token in PLACEHOLDER_TOKEN_PATTERN.findall(stripped):
            errors.append(
                ("command-placeholder", number, f"placeholder token {token} in a command")
            )
        if CANDIDATE_ID_PATTERN.search(stripped):
            errors.append(
                (
                    "command-candidate-pinned",
                    number,
                    "a 64-hex candidate id is pinned in a command; the implementation "
                    "will change the candidate, so name the gate's candidate by role",
                )
            )
        tokens = stripped.lstrip("$ ").split()
        while tokens and re.match(r"^[A-Z_][A-Z0-9_]*=", tokens[0]):
            tokens.pop(0)
        if not tokens:
            continue
        head = tokens[0]
        if not (
            head.startswith("./bin/")
            or head.startswith("bin/")
            or head.startswith("./tests/")
            or head.startswith("tests/")
        ):
            continue
        relative = head[2:] if head.startswith("./") else head
        if not tree.has_path(relative):
            errors.append(("command-script-missing", number, f"{head} does not exist in the tree"))
            continue
        flags = argparse_flags(tree.root / relative)
        if flags is None:
            continue
        for token in tokens[1:]:
            flag = token.split("=", 1)[0]
            if FLAG_PATTERN.match(flag) and flag not in flags and flag not in IMPLICIT_FLAGS:
                errors.append(("command-flag-unknown", number, f"{head} defines no {flag} flag"))


def check_deferrals(plan: Plan, errors: list[tuple[str, int, str]]) -> None:
    for number, line in plan.prose:
        bare = CODE_SPAN_PATTERN.sub("", line)
        for label, pattern in DEFERRAL_PATTERNS:
            if pattern.search(bare):
                errors.append(("deferral", number, f"{label}: {line.strip()[:120]}"))
                break


def check_definitions(plan: Plan, tree: Tree, errors: list[tuple[str, int, str]]) -> set[str]:
    declared: set[str] = set()
    if not plan.has_definitions_table:
        errors.append(
            (
                "definitions-missing",
                0,
                "no `## Definitions Read` table: every cited identifier must name the "
                "file and line that defines it, or be declared new",
            )
        )
        return declared
    for number, identifier, location in plan.definitions:
        declared.add(identifier)
        clean = location.strip("`").strip()
        if clean.lower().startswith(NEW_MARKERS):
            continue
        target = clean.split()[0].strip("`") if clean else ""
        line_number: int | None = None
        match = re.search(r"^(.*?):(\d+)(?:-\d+)?$", target)
        if match:
            target, line_number = match.group(1), int(match.group(2))
        target = target[2:] if target.startswith("./") else target
        if not target or not tree.has_path(target):
            errors.append(
                (
                    "definition-file-missing",
                    number,
                    f"`{identifier}` cites {clean or '(nothing)'}, which is not in the tree",
                )
            )
            continue
        file_path = tree.root / target
        if not file_path.is_file():
            continue
        text = file_path.read_text(encoding="utf-8", errors="replace")
        needle = identifier.split(".")[-1] if not identifier.startswith("--") else identifier
        needle_pattern = re.compile(rf"(?<![\w]){re.escape(needle)}(?![\w])")
        if line_number is not None:
            lines = text.splitlines()
            window = lines[max(0, line_number - 2) : line_number + 1]
            if not any(needle_pattern.search(item) for item in window):
                errors.append(
                    (
                        "definition-line-mismatch",
                        number,
                        f"`{identifier}` is not defined at {target}:{line_number}",
                    )
                )
        elif not needle_pattern.search(text):
            errors.append(
                ("definition-not-in-file", number, f"`{identifier}` does not occur in {target}")
            )
    return declared


def check_citations(
    plan: Plan, tree: Tree, declared: set[str], errors: list[tuple[str, int, str]]
) -> None:
    seen: set[str] = set()
    for number, line in plan.prose:
        for span in CODE_SPAN_PATTERN.findall(line):
            span = span.strip()
            if not span or span in seen:
                continue
            seen.add(span)
            if looks_like_path(span, tree):
                relative = path_of(span)
                if (
                    relative
                    and not tree.has_path(relative)
                    and relative not in plan.new_paths
                    and span not in declared
                    and relative not in declared
                ):
                    errors.append(
                        (
                            "path-missing",
                            number,
                            f"`{span}` is not in the tree and not declared as a new file",
                        )
                    )
                    continue
                # `tests/test_x.py::test_name` cites a member of that file.
                node = NODE_ID_PATTERN.match(span)
                if node and (tree.root / relative).is_file():
                    member = node.group("member")
                    if (
                        member not in declared
                        and member not in plan.introduced
                        and not EXEMPT_IDENTIFIER_PATTERN.match(member)
                        and not re.search(
                            rf"(?<!\w){re.escape(member.split('.')[-1])}(?!\w)",
                            (tree.root / relative).read_text(encoding="utf-8", errors="replace"),
                        )
                    ):
                        errors.append(
                            (
                                "member-missing",
                                number,
                                f"`{span}`: {relative} defines no {member}",
                            )
                        )
                continue
            if (
                not identifier_shape(span)
                or EXEMPT_IDENTIFIER_PATTERN.match(span)
                or span.endswith(PATH_SUFFIXES)
            ):
                continue
            if span in declared or span in plan.introduced or tree.contains(span):
                continue
            tail = span.split(".")[-1]
            # `document.provenance.records` is cited through its last member.
            # A short tail such as `Mode.FS` matches too much to prove anything;
            # the Definitions Read row for the dotted name is what verifies it.
            if "." in span and len(tail) >= 3 and re.search(rf"\b{re.escape(tail)}\b", tree.text):
                continue
            errors.append(
                (
                    "identifier-unread",
                    number,
                    f"`{span}` occurs nowhere in the tree and is not declared in Definitions Read",
                )
            )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--plan", type=Path, required=True, help="plan artifact to check")
    parser.add_argument(
        "--root", type=Path, default=Path.cwd(), help="repository the plan describes"
    )
    arguments = parser.parse_args()
    try:
        text = arguments.plan.read_text(encoding="utf-8")
    except OSError as exc:
        print(f"check-plan-concreteness: cannot read plan: {exc}", file=sys.stderr)
        return 2
    root = arguments.root.resolve()
    tree = Tree(root, arguments.plan.resolve())
    plan = parse_plan(text)
    errors: list[tuple[str, int, str]] = []
    declared = check_definitions(plan, tree, errors)
    check_citations(plan, tree, declared, errors)
    check_commands(plan, tree, errors)
    check_deferrals(plan, errors)
    if not errors:
        print("PLAN CONCRETENESS PASS")
        return 0
    for check, number, message in sorted(errors, key=lambda item: (item[1], item[0])):
        print(f"ERROR\t{check}\t{number}\t{message}")
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
