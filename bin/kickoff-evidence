class EvidenceError(ValueError):
    """A fail-closed evidence validation error."""


class FindingValidationError(EvidenceError):
    """A finding refusal that carries one typed code beside each message.

    The codes are what let `attach-derived-metrics` establish *which* rule
    refused a batch as a machine-checkable fact rather than trusting an
    operator's account of it. `str()` remains the joined messages, so every
    diagnostic this tool has ever emitted is unchanged.
    """

    def __init__(self, errors: list[tuple[str, str]]) -> None:
        self.errors = errors
        super().__init__("\n".join(message for _, message in errors))


def now() -> str:
    return datetime.now(UTC).isoformat()


def atomic_json(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False) + "\n")
    temporary.replace(path)


def append_jsonl(path: Path, value: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a") as handle:
        json.dump(value, handle, sort_keys=True, separators=(",", ":"))
        handle.write("\n")


def load_json(path: Path) -> Any:
    try:
        return json.loads(path.read_text())
    except FileNotFoundError as exc:
        raise EvidenceError(f"missing evidence file: {path.name}") from exc
    except json.JSONDecodeError as exc:
        raise EvidenceError(f"invalid JSON in {path.name}: {exc}") from exc


def extract_json_block(path: Path, heading: str) -> Any:
    try:
        text = path.read_text()
    except FileNotFoundError as exc:
        raise EvidenceError(f"missing role artifact: {path}") from exc
    heading_pattern = re.compile(rf"^{re.escape(heading)}[ \t]*$", re.MULTILINE)
    headings = list(heading_pattern.finditer(text))
    if not headings:
        raise EvidenceError(f"no {heading} fenced JSON block found in {path.name}")
    pattern = re.compile(
        rf"^{re.escape(heading)}[ \t]*\n\s*```json[ \t]*\n(.*?)\n```[ \t]*$",
        re.MULTILINE | re.DOTALL,
    )
    matches = list(pattern.finditer(text))
    if len(matches) != 1:
        if len(matches) > 1:
            raise EvidenceError(f"multiple {heading} fenced JSON blocks found in {path.name}")
        line = text.count("\n", 0, headings[0].start()) + 1
        raise EvidenceError(
            f"{heading} block found at {path.name}:{line} but malformed; "
            "expected one fenced JSON object"
        )
    try:
        return json.loads(matches[0].group(1))
    except json.JSONDecodeError as exc:
        line = text.count("\n", 0, matches[0].start()) + 1
        raise EvidenceError(
            f"{heading} block found at {path.name}:{line} but malformed JSON: {exc}"
        ) from exc


def read_role_artifact(path: Path) -> Any:
    """Read a review artifact in either shape the venues produce.

    A schema-constrained venue returns the whole document as JSON, so there is
    no markdown envelope to find. A native subagent runs without a schema and
    still emits the fenced `## Finding Evidence` block. Accepting both here is
    what keeps the orchestrator from branching on venue — which would put the
    invocation shape back in the caller's hands.

    Bare JSON is tried first and only when it is an object carrying `findings`;
    anything else falls through to the markdown reader, so a malformed
    structured artifact still gets the fenced reader's specific diagnostic
    rather than a generic parse error.
    """
    try:
        text = path.read_text()
    except FileNotFoundError as exc:
        raise EvidenceError(f"missing role artifact: {path}") from exc
    try:
        document = json.loads(text)
    except json.JSONDecodeError:
        document = None
    if isinstance(document, dict) and isinstance(document.get("findings"), list):
        return document
    return extract_json_block(path, "## Finding Evidence")


def command_schema(arguments: argparse.Namespace) -> None:
    """Emit the review-artifact schema derived from the closed sets."""
    document = review_artifact_schema(arguments.kind)
    rendered = json.dumps(document, indent=2, sort_keys=False) + "\n"
    if arguments.output:
        arguments.output.parent.mkdir(parents=True, exist_ok=True)
        arguments.output.write_text(rendered, encoding="utf-8")
        print(str(arguments.output))
        return
    sys.stdout.write(rendered)


def git_root(start: Path) -> Path:
    process = subprocess.run(
        ["git", "-C", str(start), "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode != 0:
        raise EvidenceError(process.stderr.strip() or "not inside a Git repository")
    return Path(process.stdout.strip()).resolve()


def tree_manifest(root: Path) -> dict[str, Any]:
    executable = TOOL_ROOT / "kickoff-tree-id"
    process = subprocess.run(
        [str(executable), "--root", str(root), "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode != 0:
        raise EvidenceError(process.stderr.strip() or "candidate identification failed")
    value = json.loads(process.stdout)
    validate_candidate_manifest(value)
    return value


def product_manifest(root: Path) -> dict[str, Any]:
    executable = TOOL_ROOT / "kickoff-tree-id"
    process = subprocess.run(
        [str(executable), "--root", str(root), "--product", "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode != 0:
        raise EvidenceError(process.stderr.strip() or "product identification failed")
    value = json.loads(process.stdout)
    validate_candidate_manifest(value)
    return value


def validate_candidate_id(value: Any, label: str) -> str:
    if not isinstance(value, str) or not CANDIDATE_ID.fullmatch(value):
        raise EvidenceError(f"{label} must be a lowercase SHA-256 identifier")
    return value


def validate_string_list(value: Any, label: str) -> list[str]:
    if not isinstance(value, list) or not all(
        isinstance(item, str) and item.strip() for item in value
    ):
        raise EvidenceError(f"{label} must be a string array")
    return value


GATE_STATUSES = {"green", "red", "not-run"}


def validate_falsifiers(value: Any) -> list[dict[str, str]]:
    """`[{test, mutation}]` — the one change that reds each new or changed test.

    A test whose falsifier the coder cannot name is a proxy for the property it
    claims to check; the critic reads this list instead of guessing.
    """
    if not isinstance(value, list):
        raise EvidenceError("change metadata falsifiers must be a list")
    result: list[dict[str, str]] = []
    for index, item in enumerate(value):
        if not isinstance(item, dict) or set(item) != {"test", "mutation"}:
            raise EvidenceError(
                f"change metadata falsifiers[{index}] must be an object with exactly test, mutation"
            )
        test = item["test"]
        mutation = item["mutation"]
        if not isinstance(test, str) or not test.strip():
            raise EvidenceError(f"change metadata falsifiers[{index}].test must be nonempty text")
        if not isinstance(mutation, str) or not mutation.strip():
            raise EvidenceError(
                f"change metadata falsifiers[{index}].mutation must be nonempty text"
            )
        result.append({"test": test.strip(), "mutation": mutation.strip()})
    return sorted(result, key=lambda item: (item["test"], item["mutation"]))


def validate_gate_status(value: Any) -> dict[str, str]:
    """`{focused: green|red|not-run, reason}`; `not-run` must say why.

    The orchestrator reads this before dispatching the critic: code whose
    focused gate never ran is gated natively first, never reviewed unverified.
    """
    if not isinstance(value, dict) or set(value) != {"focused", "reason"}:
        raise EvidenceError(
            "change metadata gate_status must be an object with exactly focused, reason"
        )
    focused = value["focused"]
    reason = value["reason"]
    if focused not in GATE_STATUSES:
        raise EvidenceError(
            "change metadata gate_status.focused must be one of " + ", ".join(sorted(GATE_STATUSES))
        )
    if not isinstance(reason, str):
        raise EvidenceError("change metadata gate_status.reason must be a string")
    if focused == "not-run" and not reason.strip():
        raise EvidenceError(
            "change metadata gate_status.reason must be nonempty when focused is not-run"
        )
    return {"focused": focused, "reason": reason.strip()}


def validate_relative_paths(value: Any, label: str) -> list[str]:
    paths = validate_string_list(value, label)
    if any(Path(item).is_absolute() or ".." in Path(item).parts for item in paths):
        raise EvidenceError(f"{label} must contain repository-relative paths")
    return paths


def validate_candidate_manifest(value: Any) -> None:
    if not isinstance(value, dict) or value.get("schema_version") != CANDIDATE_SCHEMA_VERSION:
        raise EvidenceError("invalid candidate manifest schema")
    validate_candidate_id(value.get("candidate_id"), "candidate_id")
    entries = value.get("entries")
    if not isinstance(entries, list) or value.get("path_count") != len(entries):
        raise EvidenceError("candidate manifest path count does not match entries")
    prior: bytes | None = None
    digest = hashlib.sha256(CANDIDATE_NAMESPACE)
    for entry in entries:
        if not isinstance(entry, dict):
            raise EvidenceError("candidate entry must be an object")
        path = entry.get("path")
        if (
            not isinstance(path, str)
            or not path
            or Path(path).is_absolute()
            or ".." in Path(path).parts
        ):
            raise EvidenceError("candidate entry path must be repository-relative")
        encoded = os.fsencode(path)
        if prior is not None and encoded <= prior:
            raise EvidenceError("candidate entries are not uniquely bytewise ordered")
        prior = encoded
        mode = entry.get("mode")
        if mode not in {"missing", "100644", "100755", "120000", "160000"}:
            raise EvidenceError(f"candidate entry {path} has invalid mode")
        content_hash = validate_candidate_id(
            entry.get("content_sha256"), f"content hash for {path}"
        )
        digest.update(len(encoded).to_bytes(8, "big"))
        digest.update(encoded)
        digest.update(mode.encode("ascii") + b"\0")
        digest.update(bytes.fromhex(content_hash))
    if digest.hexdigest() != value["candidate_id"]:
        raise EvidenceError("candidate manifest identifier does not match its entries")


def validate_run_dir(run_dir: Path) -> dict[str, Any]:
    run = load_json(run_dir / "run.json")
    if not isinstance(run, dict) or run.get("schema_version") != SCHEMA_VERSION:
        raise EvidenceError("invalid run metadata schema")
    root = Path(str(run.get("repository_root", "")))
    if not root.is_absolute() or not (root / ".git").exists():
        raise EvidenceError("run metadata has no valid repository root")
    validate_candidate_id(run.get("initial_candidate_id"), "initial_candidate_id")
    validate_candidate_id(run.get("initial_product_candidate_id"), "initial_product_candidate_id")
    required = {
        "schema_version",
        "phase",
        "repository_root",
        "created_at",
        "initial_candidate_id",
        "initial_product_candidate_id",
        "telemetry_trace_id",
        "telemetry_root_span_id",
        "review_lane",
        "evidence_lane",
        "follow_up_route",
        "required_initial_role_operations",
        "required_orchestration_operations",
        "initial_orchestration_span_id",
        "tool_bundle",
    }
    if set(run) != required:
        raise EvidenceError("run metadata has unknown or missing fields")
    if run.get("review_lane") not in REVIEW_LANES:
        raise EvidenceError("run metadata has an unknown review lane")
    if run.get("evidence_lane") not in EVIDENCE_LANES:
        raise EvidenceError("run metadata has an unknown evidence lane")
    pinned = (run_dir / "tools" / "kickoff-evidence").resolve()
    if SCRIPT_PATH != pinned:
        raise EvidenceError(f"active run must use pinned tool: {pinned}")
    bundle = run.get("tool_bundle")
    if (
        not isinstance(bundle, dict)
        or set(bundle) != {"schema_version", "manifest_sha256"}
        or bundle["schema_version"] != 1
    ):
        raise EvidenceError("invalid pinned tool-bundle metadata")
    manifest_path = run_dir / "tools" / "manifest.json"
    if hashlib.sha256(manifest_path.read_bytes()).hexdigest() != bundle["manifest_sha256"]:
        raise EvidenceError("pinned tool-bundle manifest changed")
    manifest = load_json(manifest_path)
    if (
        not isinstance(manifest, dict)
        or manifest.get("schema_version") != 1
        or not isinstance(manifest.get("files"), list)
    ):
        raise EvidenceError("invalid pinned tool-bundle manifest")
    for item in manifest["files"]:
        if not isinstance(item, dict) or set(item) != {"path", "sha256"}:
            raise EvidenceError("invalid pinned tool-bundle entry")
        relative = Path(str(item["path"]))
        if relative.is_absolute() or ".." in relative.parts:
            raise EvidenceError("pinned tool-bundle path escapes bundle")
        target = run_dir / "tools" / relative
        if (
            not target.is_file()
            or hashlib.sha256(target.read_bytes()).hexdigest() != item["sha256"]
        ):
            raise EvidenceError(f"pinned tool changed: {relative.as_posix()}")
    return run


def install_tool_bundle(run_dir: Path) -> dict[str, Any]:
    """Pin the mechanics that must remain readable after the live tree changes."""
    bundle = run_dir / "tools"
    sources = {
        "kickoff-evidence": SCRIPT_PATH,
        "kickoff-tree-id": REPO_ROOT / "bin" / "kickoff-tree-id",
        "execution-telemetry": REPO_ROOT / "bin" / "execution-telemetry",
        "kickoff-config": REPO_ROOT / "bin" / "kickoff-config",
        "kickoff.yaml": REPO_ROOT / "kickoff.yaml",
        "lib/agentic_starter/__init__.py": REPO_ROOT / "lib" / "agentic_starter" / "__init__.py",
        "lib/agentic_starter/finding_schema.py": (
            REPO_ROOT / "lib" / "agentic_starter" / "finding_schema.py"
        ),
        "lib/agentic_starter/execution_telemetry.py": (
            REPO_ROOT / "lib" / "agentic_starter" / "execution_telemetry.py"
        ),
        "lib/agentic_starter/execution_dashboard.py": (
            REPO_ROOT / "lib" / "agentic_starter" / "execution_dashboard.py"
        ),
        "lib/agentic_starter/candidate_boundaries.py": (
            REPO_ROOT / "lib" / "agentic_starter" / "candidate_boundaries.py"
        ),
        "lib/agentic_starter/kickoff_runbook.py": (
            REPO_ROOT / "lib" / "agentic_starter" / "kickoff_runbook.py"
        ),
        "kickoff-command-zero": REPO_ROOT / "bin" / "kickoff-command-zero",
    }
    manifest: list[dict[str, str]] = []
    for relative, source in sources.items():
        if not source.is_file():
            raise EvidenceError(f"cannot pin missing kickoff tool: {relative}")
        destination = bundle / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(source, destination)
        manifest.append(
            {
                "path": relative,
                "sha256": hashlib.sha256(destination.read_bytes()).hexdigest(),
            }
        )
    atomic_json(
        bundle / "manifest.json",
        {"schema_version": 1, "files": manifest},
    )
    return {
        "schema_version": 1,
        "manifest_sha256": hashlib.sha256((bundle / "manifest.json").read_bytes()).hexdigest(),
    }


GATE_MANIFEST_ACTIVATION_FIELDS = {
    "schema_version",
    "activated_at",
    "manifest_sha256",
    "supersedes",
}


def active_gate_manifest(run_dir: Path) -> tuple[dict[str, Any], str] | None:
    journal = run_dir / "gate-manifests.jsonl"
    if not journal.exists() or not journal.read_text(encoding="utf-8").strip():
        return None
    previous: str | None = None
    active: tuple[dict[str, Any], str] | None = None
    for line_number, row in enumerate(load_jsonl(journal), 1):
        if (
            set(row) != GATE_MANIFEST_ACTIVATION_FIELDS
            or row.get("schema_version") != SCHEMA_VERSION
        ):
            raise EvidenceError(f"invalid gate-manifests.jsonl line {line_number} schema")
        try:
            digest = kickoff_runbook.validate_digest(
                row.get("manifest_sha256"),
                f"gate-manifests.jsonl line {line_number} digest",
            )
        except kickoff_runbook.RunbookError as exc:
            raise EvidenceError(str(exc)) from exc
        if row.get("supersedes") != previous:
            raise EvidenceError(
                f"gate-manifests.jsonl line {line_number} does not supersede the active manifest"
            )
        artifact = run_dir / "gate-manifests" / f"{digest}.json"
        try:
            document, _, observed = kickoff_runbook.load(artifact)
        except (OSError, kickoff_runbook.RunbookError) as exc:
            raise EvidenceError(f"invalid activated gate manifest: {exc}") from exc
        if observed != digest:
            raise EvidenceError("activated gate-manifest bytes changed")
        previous = digest
        active = (document, digest)
    return active


def command_activate_gate_manifest(arguments: argparse.Namespace) -> None:
    validate_run_dir(arguments.run_dir)
    try:
        document, raw, digest = kickoff_runbook.load(arguments.manifest)
    except (OSError, kickoff_runbook.RunbookError) as exc:
        raise EvidenceError(f"cannot activate gate manifest: {exc}") from exc
    current = active_gate_manifest(arguments.run_dir)
    predecessor = current[1] if current else None
    if arguments.supersedes != predecessor:
        if predecessor is None:
            raise EvidenceError("first gate-manifest activation must omit --supersedes")
        raise EvidenceError(f"successor gate manifest must pass --supersedes {predecessor}")
    destination = arguments.run_dir / "gate-manifests" / f"{digest}.json"
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if destination.read_bytes() != raw:
            raise EvidenceError("gate-manifest digest collision or changed artifact")
    else:
        descriptor = os.open(destination, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
    loaded, _, observed = kickoff_runbook.load(destination)
    if loaded != document or observed != digest:
        raise EvidenceError("stored gate manifest failed post-write validation")
    append_jsonl(
        arguments.run_dir / "gate-manifests.jsonl",
        {
            "schema_version": SCHEMA_VERSION,
            "activated_at": now(),
            "manifest_sha256": digest,
            "supersedes": predecessor,
        },
    )
    active = active_gate_manifest(arguments.run_dir)
    if active is None or active[1] != digest:
        raise EvidenceError("gate-manifest activation did not become current")
    print(digest)


def validate_role_preflight_receipt(run_dir: Path, root: Path) -> None:
    receipt = run_dir / "role-preflight.json"
    if not receipt.is_file():
        raise EvidenceError("run has no role-venue preflight receipt")
    process = subprocess.run(
        [
            str(run_dir / "tools" / "kickoff-config"),
            "verify-preflight-receipt",
            "--receipt",
            str(receipt),
        ],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    if process.returncode:
        raise EvidenceError(process.stderr.strip() or "role-venue preflight receipt is invalid")


def command_validate_preflight(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    if run["evidence_lane"] == "full" and active_gate_manifest(arguments.run_dir) is None:
        raise EvidenceError("full evidence lane requires an active gate manifest")
    validate_role_preflight_receipt(arguments.run_dir, root)
    validate_preacceptance_topology(run, arguments.run_dir, root)
    print("PREFLIGHT VALID")


def required_initial_roles(review_lane: str, route: str) -> list[str]:
    if review_lane not in REVIEW_LANES or route not in FOLLOW_UP_ROUTES:
        raise EvidenceError("invalid review lane or follow-up route")
    if route == "direct-fix":
        return []
    if route == "coder-only":
        return ["role.implement"]
    if route == "full-cycle":
        return ["role.code-review", "role.implement"]
    if review_lane == "one-shot":
        # Operator-invoked lane: no planner attempt; the phase file is the
        # binding contract and the invocation substitutes for plan review.
        return ["role.code-review", "role.implement"]
    roles = ["role.code-review", "role.implement", "role.plan"]
    if review_lane == "full":
        roles.append("role.plan-review")
    return sorted(roles)


def required_orchestration_operations(route: str, review_lane: str) -> list[str]:
    if route not in FOLLOW_UP_ROUTES or review_lane not in REVIEW_LANES:
        raise EvidenceError("invalid follow-up route or review lane")
    required = {
        "orchestration.setup",
        "orchestration.implementation",
        "orchestration.acceptance",
        "orchestration.close",
    }
    if route == "initial" and review_lane != "one-shot":
        required.add("orchestration.planning")
    return sorted(required)


def validate_kickoff_context(
    root: Path, phase: str, trace_id: str, root_span_id: str, *, open_required: bool
) -> dict[str, Any]:
    try:
        context = trace_context(engine_root=root, trace_id=trace_id)
    except TelemetryError as exc:
        raise EvidenceError(f"invalid kickoff telemetry context: {exc}") from exc
    expected = {
        "root_span_id": root_span_id,
        "scope": "engine",
        "scope_id": "engine",
        "run_type": "kickoff",
        "operation": f"phase.{phase}",
    }
    for field, value in expected.items():
        if context.get(field) != value:
            raise EvidenceError(f"kickoff telemetry {field} does not match")
    if open_required and context["state"] != "open":
        raise EvidenceError("kickoff telemetry root must be open")
    return context


def parse_authority_spec(specification: str, root: Path, priority: int) -> dict[str, Any]:
    path_text, separator, locator = specification.partition("::")
    relative = Path(path_text)
    if relative.is_absolute() or ".." in relative.parts or not path_text:
        raise EvidenceError(f"authority path must be repository-relative: {path_text}")
    target = (root / relative).resolve()
    if not target.is_relative_to(root) or not target.is_file():
        raise EvidenceError(f"authority file does not exist: {path_text}")
    return {
        "path": relative.as_posix(),
        "content_sha256": hashlib.sha256(target.read_bytes()).hexdigest(),
        "locator": locator if separator and locator else None,
        "priority": priority,
    }


def command_init(arguments: argparse.Namespace) -> None:
    root = git_root(arguments.root.resolve())
    run_dir = arguments.run_dir.resolve()
    if run_dir.exists() and any(run_dir.iterdir()):
        raise EvidenceError(f"run directory is not empty: {run_dir}")
    if not arguments.preflight_receipt.is_file():
        raise EvidenceError("init requires a role-venue preflight receipt")
    receipt_check = subprocess.run(
        [
            str(TOOL_ROOT / "kickoff-config"),
            "verify-preflight-receipt",
            "--receipt",
            str(arguments.preflight_receipt),
        ],
        cwd=root,
        capture_output=True,
        text=True,
        check=False,
    )
    if receipt_check.returncode:
        raise EvidenceError(
            receipt_check.stderr.strip() or "role-venue preflight receipt is invalid"
        )
    run_dir.mkdir(parents=True, exist_ok=True)
    tool_bundle = install_tool_bundle(run_dir)
    candidate = tree_manifest(root)
    product = product_manifest(root)
    shutil.copy2(arguments.preflight_receipt, run_dir / "role-preflight.json")
    authorities = [
        parse_authority_spec(specification, root, priority)
        for priority, specification in enumerate(arguments.authority, 1)
    ]
    if not authorities:
        raise EvidenceError("at least one --authority is required")
    created_at = now()
    validate_kickoff_context(
        root,
        arguments.phase,
        arguments.telemetry_trace_id,
        arguments.telemetry_root_span_id,
        open_required=True,
    )
    try:
        setup_span = runtime_span_context(
            engine_root=root,
            trace_id=arguments.telemetry_trace_id,
            span_id=arguments.initial_orchestration_span_id,
        )
    except TelemetryError as exc:
        raise EvidenceError(f"invalid initial orchestration span: {exc}") from exc
    expected_setup = {
        "parent_span_id": arguments.telemetry_root_span_id,
        "category": "reconciliation",
        "operation": "orchestration.setup",
        "attempt": 1,
        "state": "open",
    }
    if any(setup_span.get(key) != value for key, value in expected_setup.items()):
        raise EvidenceError("initial orchestration span does not match setup contract")
    atomic_json(
        run_dir / "run.json",
        {
            "schema_version": SCHEMA_VERSION,
            "phase": arguments.phase,
            "repository_root": str(root),
            "created_at": created_at,
            "initial_candidate_id": candidate["candidate_id"],
            "initial_product_candidate_id": product["candidate_id"],
            "telemetry_trace_id": arguments.telemetry_trace_id,
            "telemetry_root_span_id": arguments.telemetry_root_span_id,
            "review_lane": arguments.review_lane,
            "evidence_lane": arguments.evidence_lane,
            "follow_up_route": arguments.follow_up_route,
            "required_initial_role_operations": required_initial_roles(
                arguments.review_lane, arguments.follow_up_route
            ),
            "required_orchestration_operations": required_orchestration_operations(
                arguments.follow_up_route, arguments.review_lane
            ),
            "initial_orchestration_span_id": arguments.initial_orchestration_span_id,
            "tool_bundle": tool_bundle,
        },
    )
    atomic_json(
        run_dir / "authority.json",
        {
            "schema_version": SCHEMA_VERSION,
            "captured_at": created_at,
            "authorities": authorities,
        },
    )
    atomic_json(run_dir / "reviewed-candidate.json", candidate)
    atomic_json(run_dir / "reviewed-product-candidate.json", product)
    atomic_json(
        run_dir / "findings.json",
        {
            "schema_version": SCHEMA_VERSION,
            "updated_at": created_at,
            "reopened_count": 0,
            "findings": [],
        },
    )
    (run_dir / "gates.jsonl").touch()
    (run_dir / "role-attempts.jsonl").touch()
    (run_dir / "role-dispatch.jsonl").touch()
    (run_dir / "dispatch-open-omitted.jsonl").touch()
    (run_dir / "packets.jsonl").touch()
    (run_dir / "gate-manifests.jsonl").touch()
    (run_dir / "lineage.jsonl").touch()
    record_lineage(run_dir, candidate, "init")
    print(candidate["candidate_id"])


def candidate_store_path(run_dir: Path, candidate_id: str) -> Path:
    return run_dir / "candidates" / f"{candidate_id}.json"


def store_candidate_manifest(run_dir: Path, manifest: dict[str, Any]) -> None:
    """Persist a candidate's full manifest, content-addressed and write-once.

    Only two manifests were ever kept per run — `candidate.json` and
    `reviewed-candidate.json`, both overwritten in place — so by the time a
    batch was refused, the manifest the role had been dispatched against was
    already gone and the drift was unclassifiable. A file whose name is its own
    digest cannot legitimately change, so the many observations that share a
    candidate deduplicate and nothing is ever rewritten.
    """
    path = candidate_store_path(run_dir, manifest["candidate_id"])
    if path.exists():
        return
    atomic_json(path, manifest)


def stored_candidate_manifest(run_dir: Path, candidate_id: str, *, label: str) -> dict[str, Any]:
    """One stored manifest, still present and still hashing to its own name."""
    path = candidate_store_path(run_dir, candidate_id)
    if not path.is_file():
        raise EvidenceError(
            f"no stored candidate manifest for the {label} candidate "
            f"{candidate_id[:12]}…: a drift cannot be classified from ids alone, "
            "and an unclassifiable drift is never assumed disjoint"
        )
    manifest = load_json(path)
    validate_candidate_manifest(manifest)
    if manifest["candidate_id"] != candidate_id:
        raise EvidenceError(
            f"stored candidate manifest {candidate_id[:12]}… names a different candidate"
        )
    return manifest


def record_lineage(run_dir: Path, manifest: dict[str, Any], reason: str) -> bool:
    """Record a candidate in this run's lineage and store its manifest.

    Returns True when the candidate is new to the lineage.

    The lineage is what makes a finding's `introduced_in` checkable against
    something other than the head of the tree. A run's candidate changes for
    reasons that have nothing to do with the code under review — the status
    marker and the START log block are both tracked files — so "the id the tree
    has right now" is the wrong question to ask of a reviewer that observed the
    tree minutes ago.

    The manifest travels with the id rather than beside it: `lineage.jsonl`
    carries ids only, and an id alone cannot say which paths moved.
    """
    candidate_id = manifest["candidate_id"]
    store_candidate_manifest(run_dir, manifest)
    path = run_dir / "lineage.jsonl"
    known = {item["candidate_id"] for item in load_jsonl(path)}
    if candidate_id in known:
        return False
    with path.open("a", encoding="utf-8") as handle:
        handle.write(
            json.dumps(
                {
                    "schema_version": SCHEMA_VERSION,
                    "candidate_id": candidate_id,
                    "observed_at": now(),
                    "reason": reason,
                },
                separators=(",", ":"),
            )
            + "\n"
        )
    return True


def lineage_candidates(run_dir: Path) -> list[str]:
    """Every candidate this run has recorded, oldest first."""
    return [item["candidate_id"] for item in load_jsonl(run_dir / "lineage.jsonl")]


def command_current_candidate(arguments: argparse.Namespace) -> None:
    """Recompute the candidate now and record it, so nobody caches the old one.

    `init` prints a candidate, and the very next orchestration steps — the
    `plan/INDEX.md` marker flip and the START log block — change it. An
    orchestrator that carried the init-time value into a role prompt handed
    every role a value that was stale by construction, and the reviewer's
    honestly-stamped findings were then rejected wholesale. Calling this
    immediately before a dispatch is the mechanical answer.
    """
    run = validate_run_dir(arguments.run_dir)
    current = tree_manifest(Path(run["repository_root"]))
    candidate_id = current["candidate_id"]
    if record_lineage(arguments.run_dir, current, arguments.reason):
        print(
            f"kickoff-evidence: candidate advanced to {candidate_id[:12]}… ({arguments.reason})",
            file=sys.stderr,
        )
    print(candidate_id)


def load_jsonl(file_path: Path) -> list[dict[str, Any]]:
    records: list[dict[str, Any]] = []
    try:
        lines = file_path.read_text().splitlines()
    except FileNotFoundError as exc:
        raise EvidenceError(f"missing evidence file: {file_path.name}") from exc
    for number, line in enumerate(lines, 1):
        if not line.strip():
            continue
        try:
            value = json.loads(line)
        except json.JSONDecodeError as exc:
            raise EvidenceError(f"invalid JSON in {file_path.name} line {number}") from exc
        if not isinstance(value, dict):
            raise EvidenceError(f"invalid record in {file_path.name} line {number}")
        records.append(value)
    return records


def validate_dispatch_key(record: dict[str, Any], label: str) -> tuple[str, int]:
    operation = record.get("operation")
    attempt = record.get("attempt")
    if operation not in ROLE_OPERATIONS:
        raise EvidenceError(f"{label} has an invalid role operation")
    if not isinstance(attempt, int) or isinstance(attempt, bool) or attempt < 1:
        raise EvidenceError(f"{label} has an invalid attempt")
    return operation, attempt


def validate_terminal_dispatch(record: dict[str, Any], label: str) -> None:
    validate_dispatch_key(record, label)
    if not isinstance(record.get("accepted"), bool):
        raise EvidenceError(f"{label} has an invalid accepted flag")
    if record.get("idle_telemetry") not in {
        "available",
        "unavailable",
        "not-dispatched",
    }:
        raise EvidenceError(f"{label} has invalid idle telemetry")
    if record["accepted"] and record["idle_telemetry"] == "not-dispatched":
        raise EvidenceError(f"{label} marks an accepted dispatch as not dispatched")
    if not record["accepted"] and record["idle_telemetry"] != "not-dispatched":
        raise EvidenceError(f"{label} gives a rejected dispatch idle telemetry")
    if not record["accepted"] and record.get("wait_span_id") is not None:
        raise EvidenceError(f"{label} gives a rejected dispatch a wait span")
    for field in ("intelligence_span_id", "wait_span_id"):
        if record.get(field) is not None:
            validate_span_identifier(record[field], f"{label} {field}")
    if record.get("dispatch_candidate_id") is not None:
        validate_candidate_id(record["dispatch_candidate_id"], f"{label} dispatch-open candidate")
    validate_candidate_id(record.get("return_candidate_id"), f"{label} return candidate")


def load_dispatch_open_omissions(
    run_dir: Path,
) -> dict[tuple[str, int], dict[str, Any]]:
    path = run_dir / "dispatch-open-omitted.jsonl"
    if not path.exists():
        return {}
    records: dict[tuple[str, int], dict[str, Any]] = {}
    for line_number, record in enumerate(load_jsonl(path), 1):
        label = f"{path.name} line {line_number}"
        if (
            set(record) != DISPATCH_OPEN_OMISSION_FIELDS
            or record.get("schema_version") != SCHEMA_VERSION
            or not isinstance(record.get("recorded_at"), str)
            or not record["recorded_at"].strip()
            or not isinstance(record.get("reason"), str)
            or not record["reason"].strip()
        ):
            raise EvidenceError(f"invalid {label}")
        key = validate_dispatch_key(record, label)
        if key in records:
            raise EvidenceError(f"duplicate dispatch-open omission for {key[0]}#{key[1]}")
        records[key] = record
    return records


def role_dispatch_ledger(
    run_dir: Path,
    *,
    allow_opened: bool = False,
    allow_orphan_omissions: bool = False,
) -> tuple[
    list[dict[str, Any]],
    dict[tuple[str, int], dict[str, Any]],
    dict[tuple[str, int], dict[str, Any]],
]:
    """Fold append-only dispatch lifecycle events into terminal dispatches."""
    path = run_dir / "role-dispatch.jsonl"
    omissions = load_dispatch_open_omissions(run_dir)
    consumed_omissions: set[tuple[str, int]] = set()
    opened: dict[tuple[str, int], tuple[dict[str, Any], int]] = {}
    closed: dict[tuple[str, int], dict[str, Any]] = {}
    for line_number, record in enumerate(load_jsonl(path), 1):
        label = f"{path.name} line {line_number}"
        fields = set(record)
        if fields == LEGACY_ROLE_DISPATCH_FIELDS and record.get("schema_version") == SCHEMA_VERSION:
            validate_terminal_dispatch(record, label)
            key = validate_dispatch_key(record, label)
            if key in opened or key in closed:
                raise EvidenceError(
                    f"duplicate role dispatch record for {key[0]}#{key[1]} at {label}"
                )
            closed[key] = record
            continue
        if (
            fields == OPEN_ROLE_DISPATCH_FIELDS
            and record.get("schema_version") == SCHEMA_VERSION
            and record.get("state") == "opened"
        ):
            key = validate_dispatch_key(record, label)
            if key in opened or key in closed:
                raise EvidenceError(
                    f"duplicate role dispatch opening for {key[0]}#{key[1]} at {label}"
                )
            if not isinstance(record.get("recorded_at"), str) or not record["recorded_at"].strip():
                raise EvidenceError(f"{label} has an invalid opening timestamp")
            if record.get("intelligence_span_id") is not None:
                validate_span_identifier(
                    record["intelligence_span_id"], f"{label} intelligence span id"
                )
            if record.get("dispatch_candidate_id") is not None:
                validate_candidate_id(
                    record["dispatch_candidate_id"],
                    f"{label} dispatch-open candidate",
                )
            opened[key] = (record, line_number)
            continue
        if (
            fields == AMENDED_ROLE_DISPATCH_FIELDS
            and record.get("schema_version") == SCHEMA_VERSION
            and record.get("state") in {"accepted", "rejected"}
        ):
            validate_terminal_dispatch(record, label)
            key = validate_dispatch_key(record, label)
            if record["accepted"] != (record["state"] == "accepted"):
                raise EvidenceError(f"{label} state and accepted flag do not agree")
            if key in closed:
                raise EvidenceError(
                    f"duplicate role dispatch amendment for {key[0]}#{key[1]} at {label}"
                )
            opening = opened.pop(key, None)
            if opening is None:
                if record.get("opened_at") is not None:
                    raise EvidenceError(f"{label} names an opening that is absent from the ledger")
                if key not in omissions:
                    raise EvidenceError(
                        f"{label} has no opened row and no recorded reasoned opt-out"
                    )
                consumed_omissions.add(key)
            else:
                opened_record, opened_line = opening
                if record.get("opened_at") != opened_record["recorded_at"]:
                    raise EvidenceError(
                        f"{label} does not amend its role-dispatch.jsonl line {opened_line} opening"
                    )
                if record.get("dispatch_candidate_id") != opened_record.get(
                    "dispatch_candidate_id"
                ):
                    raise EvidenceError(
                        f"{label} changes the dispatch-open candidate recorded on "
                        f"line {opened_line}"
                    )
                opened_span = opened_record.get("intelligence_span_id")
                if opened_span is not None and record.get("intelligence_span_id") != opened_span:
                    raise EvidenceError(
                        f"{label} changes the intelligence span recorded on line {opened_line}"
                    )
                if key in omissions:
                    raise EvidenceError(
                        f"{label} has both an opened row and a dispatch-open opt-out"
                    )
            closed[key] = {field: record[field] for field in LEGACY_ROLE_DISPATCH_FIELDS}
            continue
        raise EvidenceError(f"invalid role-dispatch record schema at {label}")
    if opened and not allow_opened:
        key, (_, line_number) = sorted(opened.items())[0]
        raise EvidenceError(
            "interrupted role dispatch remains opened: "
            f"{key[0]}#{key[1]} (role-dispatch.jsonl line {line_number}); "
            "no terminal amendment was recorded, so the run is incomplete"
        )
    orphan_omissions = set(omissions) - consumed_omissions
    if orphan_omissions and not allow_orphan_omissions:
        operation, attempt = sorted(orphan_omissions)[0]
        raise EvidenceError(
            f"dispatch-open omission names no terminal dispatch: {operation}#{attempt}"
        )
    return (
        list(closed.values()),
        {key: record for key, (record, _) in opened.items()},
        omissions,
    )


def load_role_dispatches(run_dir: Path) -> list[dict[str, Any]]:
    return role_dispatch_ledger(run_dir)[0]


def validate_role_record(record: dict[str, Any], run: dict[str, Any]) -> None:
    required = {
        "schema_version",
        "registered_at",
        "telemetry_trace_id",
        "telemetry_root_span_id",
        "operation",
        "attempt",
        "role",
        "harness",
        "model",
        "effort",
        "reason",
    }
    if set(record) != required or record.get("schema_version") != SCHEMA_VERSION:
        raise EvidenceError("invalid role-attempt record schema")
    operation = record.get("operation")
    if operation not in ROLE_OPERATIONS or record.get("role") != ROLE_OPERATIONS[operation]:
        raise EvidenceError("role-attempt operation and role do not agree")
    if record.get("harness") not in ROLE_HARNESSES:
        raise EvidenceError("invalid role-attempt harness")
    if not isinstance(record.get("attempt"), int) or record["attempt"] < 1:
        raise EvidenceError("role-attempt attempt must be a positive integer")
    if record.get("reason") not in ROLE_REASONS:
        raise EvidenceError("invalid role-attempt reason")
    if record["telemetry_trace_id"] != run["telemetry_trace_id"] or (
        record["telemetry_root_span_id"] != run["telemetry_root_span_id"]
    ):
        raise EvidenceError("role-attempt telemetry ownership does not match")
    for field in ("model", "effort"):
        if record[field] is not None and (
            not isinstance(record[field], str) or not record[field].strip()
        ):
            raise EvidenceError(f"role-attempt {field} must be null or nonempty text")


def command_register_role_attempt(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    if arguments.output.resolve().parent != arguments.run_dir.resolve():
        # Name the directory. The constraint is deliberate — a handoff outside
        # the run is a handoff the run cannot vouch for — but the natural
        # reading is to keep role artifacts beside prompts and events in a
        # scratch dir, so the refusal has to say where they belong instead of
        # only that the chosen path is wrong.
        raise EvidenceError(
            "role-attempt handoff must be inside its run directory: expected a "
            f"path directly under {arguments.run_dir.resolve()}, got "
            f"{arguments.output.resolve()}"
        )
    validate_kickoff_context(
        Path(run["repository_root"]),
        run["phase"],
        run["telemetry_trace_id"],
        run["telemetry_root_span_id"],
        open_required=True,
    )
    record = {
        "schema_version": SCHEMA_VERSION,
        "registered_at": now(),
        "telemetry_trace_id": run["telemetry_trace_id"],
        "telemetry_root_span_id": run["telemetry_root_span_id"],
        "operation": arguments.operation,
        "attempt": arguments.attempt,
        "role": arguments.role,
        "harness": arguments.harness,
        "model": arguments.model,
        "effort": arguments.effort,
        "reason": arguments.reason,
    }
    validate_role_record(record, run)
    existing = load_jsonl(arguments.run_dir / "role-attempts.jsonl")
    if any(
        item.get("operation") == record["operation"] and item.get("attempt") == record["attempt"]
        for item in existing
    ):
        raise EvidenceError("duplicate role operation/attempt registration")
    append_jsonl(arguments.run_dir / "role-attempts.jsonl", record)
    atomic_json(arguments.output, record)
    if arguments.harness == "native":
        # An external dispatch gets its spans built by `kickoff-config watch`.
        # A native one leaves the orchestrator to reproduce that recipe by
        # hand, and a single omitted `--model` is unrecoverable once the span
        # closes. Emit the exact argv instead of describing it.
        recipe_path = Path(f"{arguments.output}.span-recipe.json")
        atomic_json(recipe_path, native_span_recipe(record))
        print("registered")
        print(f"native span recipe: {recipe_path}")
        return
    print("registered")


def native_span_recipe(record: dict[str, Any]) -> dict[str, Any]:
    """The exact `execution-telemetry start` argv for a native attempt's spans.

    Both spans carry the registration's routing metadata, because validation
    joins them against it field by field. The wait span's parent is the
    intelligence span, which does not exist until the first command has run, so
    it travels as a named placeholder the caller substitutes.
    """

    def argv(category: str, parent: str) -> list[str]:
        command = [
            "./bin/python",
            "bin/execution-telemetry",
            "start",
            "--trace-id",
            record["telemetry_trace_id"],
            "--parent-span-id",
            parent,
            "--category",
            category,
            "--operation",
            record["operation"],
            "--attempt",
            str(record["attempt"]),
            "--harness",
            record["harness"],
            "--role",
            record["role"],
        ]
        if record["model"] is not None:
            command.extend(["--model", record["model"]])
        if record["effort"] is not None:
            command.extend(["--effort", record["effort"]])
        return command

    return {
        "schema_version": SCHEMA_VERSION,
        "operation": record["operation"],
        "attempt": record["attempt"],
        "intelligence": argv("intelligence", record["telemetry_root_span_id"]),
        "wait": argv("wait", "<INTELLIGENCE_SPAN_ID>"),
        "wait_parent_placeholder": "<INTELLIGENCE_SPAN_ID>",
        "note": (
            "Run `intelligence` first, record `record-role-dispatch --state "
            "opened` before launching the role, then substitute its span id "
            "for <INTELLIGENCE_SPAN_ID> in `wait`. Close wait before "
            "intelligence, then append the accepted or rejected terminal "
            "amendment with `record-role-dispatch`."
        ),
    }


def command_span_recipe(arguments: argparse.Namespace) -> None:
    validate_run_dir(arguments.run_dir)
    record = load_json(arguments.registration)
    if not isinstance(record, dict) or record.get("harness") != "native":
        raise EvidenceError("span recipes exist only for native role attempts")
    recipe = native_span_recipe(record)
    if arguments.intelligence_span_id:
        validate_span_identifier(arguments.intelligence_span_id, "intelligence span id")
        recipe["wait"] = [
            arguments.intelligence_span_id if item == recipe["wait_parent_placeholder"] else item
            for item in recipe["wait"]
        ]
        recipe.pop("wait_parent_placeholder")
    print(json.dumps(recipe, indent=2, sort_keys=True))


def command_record_telemetry_incomplete(arguments: argparse.Namespace) -> None:
    validate_run_dir(arguments.run_dir)
    validate_span_identifier(arguments.span_id, "span id")
    if not arguments.cause.strip():
        raise EvidenceError("a telemetry-incompleteness record requires its cause")
    record = {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": now(),
        "operation": arguments.operation,
        "attempt": arguments.attempt,
        "span_id": arguments.span_id,
        "missing_fields": sorted(set(arguments.missing_field)),
        "cause": arguments.cause.strip(),
    }
    path = arguments.run_dir / "telemetry-incomplete.jsonl"
    existing = load_jsonl(path) if path.exists() else []
    if any(
        item.get("operation") == record["operation"] and item.get("attempt") == record["attempt"]
        for item in existing
    ):
        raise EvidenceError("duplicate telemetry-incompleteness record")
    append_jsonl(path, record)
    print(f"telemetry-incomplete {record['operation']}#{record['attempt']}")


def command_repin_tools(arguments: argparse.Namespace) -> None:
    """Re-pin a run's tool bundle to the current tree.

    The bundle is a same-run snapshot so an active run survives the tree
    changing underneath it. That guarantee cuts the other way when the change
    is a repair the run itself needs: the pinned copy keeps the defect. This
    command is the recorded way across, and it is deliberately explicit — it
    prints both digests so the swap is visible in whatever log invoked it.
    """
    run = load_json(arguments.run_dir / "run.json")
    if not isinstance(run, dict) or run.get("schema_version") != SCHEMA_VERSION:
        raise EvidenceError("invalid run metadata schema")
    previous = run.get("tool_bundle", {}).get("manifest_sha256")
    run["tool_bundle"] = install_tool_bundle(arguments.run_dir)
    atomic_json(arguments.run_dir / "run.json", run)
    print(f"repinned {previous} -> {run['tool_bundle']['manifest_sha256']}")


def command_validate_role_attempt(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    registration = load_json(arguments.registration)
    validate_role_record(registration, run)
    matches = [
        item
        for item in load_jsonl(arguments.run_dir / "role-attempts.jsonl")
        if item == registration
    ]
    if len(matches) != 1:
        raise EvidenceError("role-attempt handoff is not the unique registered record")
    print("ROLE ATTEMPT VALID")


def validate_dispatch_span(
    run: dict[str, Any],
    registration: dict[str, Any],
    span_id: str,
    category: str,
    parent_span_id: str,
) -> None:
    try:
        span = runtime_span_context(
            engine_root=Path(run["repository_root"]),
            trace_id=run["telemetry_trace_id"],
            span_id=span_id,
        )
    except TelemetryError as exc:
        raise EvidenceError(f"{category} span is invalid at dispatch: {exc}") from exc
    expected_shape = {
        "category": category,
        "operation": registration["operation"],
        "attempt": registration["attempt"],
        "parent_span_id": parent_span_id,
    }
    for field, expected in expected_shape.items():
        observed = span.get(field)
        if observed != expected:
            raise EvidenceError(
                f"{category} span {field} does not match dispatch: "
                f"span={observed!r}, expected={expected!r}"
            )
    for field in ("role", "harness", "model", "effort"):
        observed = span.get(field)
        registered = registration[field]
        if observed != registered:
            raise EvidenceError(
                f"{category} span {field} does not match registration: "
                f"span={observed!r}, registration={registered!r}"
            )


def command_record_role_dispatch(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    registration = load_json(arguments.registration)
    validate_role_record(registration, run)
    if (
        sum(item == registration for item in load_jsonl(arguments.run_dir / "role-attempts.jsonl"))
        != 1
    ):
        raise EvidenceError("dispatch registration is not uniquely registered")
    opened_state = arguments.state == "opened"
    accepted = arguments.state == "accepted"
    key = (registration["operation"], registration["attempt"])
    closed, opened, omissions = role_dispatch_ledger(
        arguments.run_dir,
        allow_opened=True,
        allow_orphan_omissions=True,
    )
    if any(item["operation"] == key[0] and item["attempt"] == key[1] for item in closed):
        raise EvidenceError("duplicate role dispatch result")
    if opened_state:
        if key in opened:
            raise EvidenceError("duplicate role dispatch opening")
        if arguments.no_open_row is not None:
            raise EvidenceError("an opened dispatch cannot opt out of its own opening")
        if arguments.idle_telemetry != "not-dispatched":
            raise EvidenceError("an opened dispatch has not accumulated idle telemetry yet")
        if arguments.wait_span_id is not None:
            raise EvidenceError("an opened dispatch cannot name a wait span")
    elif key in omissions and key in opened:
        raise EvidenceError("dispatch has both an opened row and a dispatch-open opt-out")
    if accepted and arguments.wait_span_id is None:
        # Record the truthful accepted topology even when wait telemetry failed.
        pass
    if not opened_state and not accepted and arguments.wait_span_id is not None:
        raise EvidenceError("rejected dispatch cannot name a wait span")
    if not opened_state and accepted and arguments.idle_telemetry == "not-dispatched":
        raise EvidenceError("accepted dispatch must state idle telemetry availability")
    if not opened_state and not accepted and arguments.idle_telemetry != "not-dispatched":
        raise EvidenceError("rejected dispatch idle telemetry must be not-dispatched")
    if not opened_state and arguments.intelligence_span_id is None:
        # Validation requires exactly one closed intelligence span per registered
        # attempt, rejections included: a refused attempt still consumed a
        # registration and still has to be accounted for. Accepting a span-less
        # terminal amendment here writes append-only evidence that `validate`
        # then refuses forever, and the run cannot be repaired afterwards --
        # creating the span late only moves the error to "dispatch and
        # intelligence span ids do not agree". Refuse at write time, where the
        # caller can still fix it.
        raise EvidenceError(
            "dispatch must name an intelligence span. A rejected dispatch opens "
            "one and closes it error 127 at rejection time, with no wait span; "
            "an accepted one names the span it dispatched into."
        )
    if arguments.intelligence_span_id is not None:
        validate_dispatch_span(
            run,
            registration,
            arguments.intelligence_span_id,
            "intelligence",
            run["telemetry_root_span_id"],
        )
    if arguments.wait_span_id is not None:
        if arguments.intelligence_span_id is None:
            raise EvidenceError("wait span requires an intelligence span id")
        validate_dispatch_span(
            run,
            registration,
            arguments.wait_span_id,
            "wait",
            arguments.intelligence_span_id,
        )
    # The freeze convention's executable half. `--dispatch-candidate` is the
    # candidate the role was actually handed; the return candidate is recomputed
    # only in the terminal amendment. A dispatch whose two differ moved under
    # the role, and the folded pair says so instead of leaving it to be
    # discovered at ingest. The open candidate remains optional because a
    # failed capture must not erase the fact that the dispatch happened.
    dispatch_candidate: str | None = None
    if arguments.dispatch_candidate is not None:
        dispatch_candidate = validate_candidate_id(
            arguments.dispatch_candidate, "dispatch candidate"
        )
        if dispatch_candidate not in set(lineage_candidates(arguments.run_dir)):
            raise EvidenceError(
                f"dispatch candidate {dispatch_candidate[:12]}… is not a "
                "candidate this run recorded"
            )
        stored_candidate_manifest(arguments.run_dir, dispatch_candidate, label="dispatch-open")
    if opened_state:
        record = {
            "schema_version": SCHEMA_VERSION,
            "recorded_at": now(),
            "state": "opened",
            "operation": registration["operation"],
            "attempt": registration["attempt"],
            "intelligence_span_id": arguments.intelligence_span_id,
            "dispatch_candidate_id": dispatch_candidate,
        }
        append_jsonl(arguments.run_dir / "role-dispatch.jsonl", record)
        print("dispatch-opened")
        return
    opening = opened.get(key)
    omission_reason = (
        arguments.no_open_row.strip() if isinstance(arguments.no_open_row, str) else None
    )
    if opening is None:
        if arguments.no_open_row is None:
            raise EvidenceError(
                "record-role-dispatch requires an opened row written before "
                "launch: without it, an externally killed watcher leaves no "
                "dispatch evidence and the run can appear complete. Record "
                "--state opened before launch, or pass --no-open-row '<reason>' "
                "for a legitimate exception; the reason is written to "
                "dispatch-open-omitted.jsonl."
            )
        if not omission_reason:
            raise EvidenceError("--no-open-row requires a nonempty reason")
        existing_omission = omissions.get(key)
        if existing_omission is None:
            append_jsonl(
                arguments.run_dir / "dispatch-open-omitted.jsonl",
                {
                    "schema_version": SCHEMA_VERSION,
                    "recorded_at": now(),
                    "operation": registration["operation"],
                    "attempt": registration["attempt"],
                    "reason": omission_reason,
                },
            )
        elif existing_omission["reason"] != omission_reason:
            raise EvidenceError(
                "dispatch-open omission was already recorded with a different reason"
            )
    else:
        if arguments.no_open_row is not None:
            raise EvidenceError("--no-open-row cannot accompany a dispatch that has an opened row")
        opened_candidate = opening.get("dispatch_candidate_id")
        if dispatch_candidate is not None and dispatch_candidate != opened_candidate:
            raise EvidenceError("terminal dispatch candidate does not match its opened row")
        dispatch_candidate = opened_candidate
        opened_span = opening.get("intelligence_span_id")
        if opened_span is not None and arguments.intelligence_span_id != opened_span:
            raise EvidenceError("terminal intelligence span does not match its opened row")
    returned = tree_manifest(Path(run["repository_root"]))
    record_lineage(arguments.run_dir, returned, "dispatch-return")
    record = {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": now(),
        "state": arguments.state,
        "opened_at": opening["recorded_at"] if opening is not None else None,
        "operation": registration["operation"],
        "attempt": registration["attempt"],
        "accepted": accepted,
        "idle_telemetry": arguments.idle_telemetry,
        "intelligence_span_id": arguments.intelligence_span_id,
        "wait_span_id": arguments.wait_span_id,
        "dispatch_candidate_id": dispatch_candidate,
        "return_candidate_id": returned["candidate_id"],
    }
    append_jsonl(arguments.run_dir / "role-dispatch.jsonl", record)
    if dispatch_candidate is not None and dispatch_candidate != returned["candidate_id"]:
        print(
            "kickoff-evidence: the candidate moved under "
            f"{record['operation']}#{record['attempt']}: "
            f"{dispatch_candidate[:12]}… -> {returned['candidate_id'][:12]}…. "
            "Re-run the review against the current candidate, or classify the "
            "drift with `accept-candidate-drift`.",
            file=sys.stderr,
        )
    print("dispatch-recorded")


def manifest_map(manifest: dict[str, Any]) -> dict[str, dict[str, str]]:
    return {entry["path"]: entry for entry in manifest["entries"]}


def changed_entries(reviewed: dict[str, Any], current: dict[str, Any]) -> list[dict[str, Any]]:
    before = manifest_map(reviewed)
    after = manifest_map(current)
    changes: list[dict[str, Any]] = []
    for path in sorted(before.keys() | after.keys(), key=os.fsencode):
        old = before.get(path)
        new = after.get(path)
        if old == new:
            continue
        if old is None:
            change = "added"
        elif new is None or new["mode"] == "missing":
            change = "deleted"
        elif old["mode"] != new["mode"] and old["content_sha256"] == new["content_sha256"]:
            change = "mode-changed"
        else:
            change = "modified"
        changes.append(
            {
                "path": path,
                "change": change,
                "before_mode": old["mode"] if old else None,
                "before_sha256": old["content_sha256"] if old else None,
                "after_mode": new["mode"] if new else None,
                "after_sha256": new["content_sha256"] if new else None,
            }
        )
    return changes


def load_drift_partitions(root: Path) -> tuple[str, ...]:
    """Read the shared policy-owned inert-set vocabulary."""
    try:
        return candidate_boundaries.load_inert_paths(root)
    except candidate_boundaries.BoundaryError as exc:
        raise EvidenceError(str(exc)) from exc


def path_is_inert(path: str, entries: tuple[str, ...]) -> bool:
    return candidate_boundaries.path_is_inert(path, entries)


def classify_candidate_drift(
    run_dir: Path, root: Path, before_id: str, after_id: str
) -> tuple[list[str], list[str]]:
    """Every path that moved between two candidates, and every reason to refuse.

    Three checks, each able to refuse a drift the other two accept:

    1. **Partition** — every drifted path lies in the declared inert set.
    2. **Reviewed surface** — no drifted path is in `change.json`'s
       `changed_files` or in any ledger finding's `affected_paths`.
    3. **Authority** — no drifted path is a declared authority.

    All three are evaluated; none short-circuits. A layered rule whose layers
    are never isolated is one check plus two decorations, and the caller has to
    be able to see which layer spoke. A path the partition cannot place fails
    closed, and so does a drift whose manifests are not both in the store.
    """
    before = stored_candidate_manifest(run_dir, before_id, label="dispatch-open")
    after = stored_candidate_manifest(run_dir, after_id, label="dispatch-return")
    drifted = [item["path"] for item in changed_entries(before, after)]
    refusals: list[str] = []

    partitions = load_drift_partitions(root)
    unplaceable = [path for path in drifted if not path_is_inert(path, partitions)]
    if unplaceable:
        refusals.append(
            "drift-partition: "
            + ", ".join(unplaceable)
            + " lies outside the inert set declared in "
            "policies/orchestration-evidence.md"
        )

    reviewed: dict[str, set[str]] = {}
    change_path = run_dir / "change.json"
    if change_path.exists():
        # Indexed, not `.get(..., [])`: this is an input to a refusal, and a
        # default of "nothing was reviewed" is the one wrong answer a malformed
        # change manifest could give here.
        for item in load_json(change_path)["changed_files"]:
            reviewed.setdefault(item["path"], set()).add("change.json changed_files")
    for item in load_json(run_dir / "findings.json")["findings"]:
        for affected in item["affected_paths"]:
            reviewed.setdefault(affected, set()).add(item["id"])
    examined = [path for path in drifted if path in reviewed]
    if examined:
        refusals.append(
            "drift-reviewed-surface: "
            + ", ".join(f"{path} ({', '.join(sorted(reviewed[path]))})" for path in examined)
            + " is part of what this review examined"
        )

    declared = {item["path"] for item in load_json(run_dir / "authority.json")["authorities"]}
    authorities = [path for path in drifted if path in declared]
    if authorities:
        refusals.append(
            "drift-authority: " + ", ".join(authorities) + " is a declared authority of this review"
        )
    return drifted, refusals


def load_candidate_drift(run_dir: Path) -> dict[tuple[str, int], dict[str, Any]]:
    """Accepted candidate-drift records, keyed by the dispatch each describes."""
    records: dict[tuple[str, int], dict[str, Any]] = {}
    path = run_dir / "candidate-drift.jsonl"
    if not path.exists():
        return records
    for entry in load_jsonl(path):
        if (
            set(entry) != CANDIDATE_DRIFT_FIELDS
            or entry.get("schema_version") != SCHEMA_VERSION
            or entry.get("operation") not in ROLE_OPERATIONS
            or not isinstance(entry.get("attempt"), int)
            or isinstance(entry["attempt"], bool)
            or entry["attempt"] < 1
            or not isinstance(entry.get("cause"), str)
            or not entry["cause"].strip()
        ):
            raise EvidenceError("invalid candidate-drift record")
        validate_candidate_id(
            entry.get("dispatch_candidate_id"), "candidate-drift dispatch candidate"
        )
        validate_candidate_id(entry.get("return_candidate_id"), "candidate-drift return candidate")
        validate_relative_paths(entry.get("drifted_paths"), "candidate-drift drifted_paths")
        key = (entry["operation"], entry["attempt"])
        if key in records:
            raise EvidenceError("duplicate candidate-drift record")
        records[key] = entry
    return records


def drift_record_matches_dispatch(record: dict[str, Any], dispatch: dict[str, Any] | None) -> bool:
    """Whether a drift record describes exactly this accepted dispatch row.

    Both readers of the ledger apply this — `validate` and the `resolved_in`
    relaxation in `ingest-findings` — so a poisoned record refuses at the
    earliest point it is consulted rather than only at the gate.
    """
    return (
        dispatch is not None
        and bool(dispatch.get("accepted"))
        and dispatch.get("dispatch_candidate_id") == record["dispatch_candidate_id"]
        and dispatch.get("return_candidate_id") == record["return_candidate_id"]
    )


def validate_candidate_drift(run_dir: Path, run: dict[str, Any]) -> list[dict[str, Any]]:
    """Re-derive every accepted drift from the stored manifests and re-classify it.

    Recomputed, never trusted — the analogue of the derived-metrics rule, and
    for the same reason: without a reader that can contradict it, the ledger
    would be write-only. Re-*classified* rather than merely re-diffed, because
    the reviewed surface grows as findings are ingested, so a record that was
    disjoint this morning can stop being disjoint — and a validator that went on
    publishing it would be publishing a classification nothing checks.
    """
    records = load_candidate_drift(run_dir)
    if not records:
        return []
    dispatches = {
        (item["operation"], item["attempt"]): item for item in load_role_dispatches(run_dir)
    }
    root = Path(run["repository_root"])
    projected: list[dict[str, Any]] = []
    for key in sorted(records):
        record = records[key]
        if not drift_record_matches_dispatch(record, dispatches.get(key)):
            raise EvidenceError(
                "candidate-drift record does not describe an accepted dispatch of "
                f"this run: {key[0]} attempt {key[1]}"
            )
        drifted, refusals = classify_candidate_drift(
            run_dir,
            root,
            record["dispatch_candidate_id"],
            record["return_candidate_id"],
        )
        if drifted != record["drifted_paths"]:
            raise EvidenceError(
                f"candidate-drift paths do not recompute for {key[0]} attempt "
                f"{key[1]}: recorded {record['drifted_paths']}, recomputed "
                f"{drifted}"
            )
        if refusals:
            # There is deliberately no withdrawal verb: `candidate-drift.jsonl`
            # is append-only, and a record that can be retracted is a record
            # that proves nothing. So the refusal names the way out, which is a
            # fresh evidence run whose review sees the current tree — not an
            # edit to this ledger.
            raise EvidenceError(
                "an accepted candidate drift no longer classifies as disjoint for "
                f"{key[0]} attempt {key[1]}:\n- "
                + "\n- ".join(refusals)
                + "\nA later capture or finding brought the drifted paths inside "
                "the reviewed surface. The record is append-only and cannot be "
                "withdrawn: re-run the review against the current candidate in a "
                "fresh evidence run."
            )
        projected.append(
            {
                "operation": key[0],
                "attempt": key[1],
                "dispatch_candidate_id": record["dispatch_candidate_id"],
                "return_candidate_id": record["return_candidate_id"],
                "drifted_paths": record["drifted_paths"],
                "cause": record["cause"],
            }
        )
    return projected


def command_accept_candidate_drift(arguments: argparse.Namespace) -> None:
    """Record one dispatch's candidate drift as proven disjoint.

    The natural repair for a batch refused on a moved candidate is
    falsification: rewriting `resolved_in` to the ingesting candidate records
    that a reviewer verified a tree it never saw, and hand-reconstructing the
    reviewed tree has been tried and failed to reproduce the candidate
    byte-exactly. This is the other sound recovery — accept the mismatch only
    with a recorded, proven-disjoint classification — and the alternative to it
    is re-running the review, never a looser rule.

    Neither candidate nor the drifted path list is an operator input: both come
    from the dispatch row and the stored manifests. And every check the reader
    applies is applied here, because `candidate-drift.jsonl` is append-only and
    a record accepted against a wrong dispatch would refuse every later
    `validate` permanently, with hand-editing the ledger as the only way out.
    """
    run = validate_run_dir(arguments.run_dir)
    if not arguments.cause.strip():
        raise EvidenceError("a candidate-drift record requires its cause")
    if arguments.attempt < 1:
        raise EvidenceError("attempt must be a positive integer")
    dispatches = [
        item
        for item in load_role_dispatches(arguments.run_dir)
        if item.get("operation") == arguments.operation and item.get("attempt") == arguments.attempt
    ]
    if len(dispatches) != 1 or not dispatches[0].get("accepted"):
        raise EvidenceError(
            "no accepted role dispatch is recorded for "
            f"{arguments.operation} attempt {arguments.attempt}; a drift record "
            "describes movement under a dispatch this run actually made"
        )
    row = dispatches[0]
    dispatch_candidate = row.get("dispatch_candidate_id")
    if dispatch_candidate is None:
        raise EvidenceError(
            f"the dispatch for {arguments.operation} attempt {arguments.attempt} "
            "records no dispatch-open candidate, so the tree the role saw is not "
            "reconstructible; pass --dispatch-candidate to record-role-dispatch. "
            "Re-run the review against the current candidate instead."
        )
    validate_candidate_id(dispatch_candidate, "recorded dispatch candidate")
    return_candidate = validate_candidate_id(
        row.get("return_candidate_id"), "recorded return candidate"
    )
    if dispatch_candidate == return_candidate:
        raise EvidenceError(
            f"{arguments.operation} attempt {arguments.attempt} did not move the "
            "candidate, so there is no drift to classify"
        )
    if (arguments.operation, arguments.attempt) in load_candidate_drift(arguments.run_dir):
        raise EvidenceError("duplicate candidate-drift record")
    drifted, refusals = classify_candidate_drift(
        arguments.run_dir,
        Path(run["repository_root"]),
        dispatch_candidate,
        return_candidate,
    )
    if refusals:
        raise EvidenceError(
            f"the drift under {arguments.operation} attempt {arguments.attempt} "
            "is not proven disjoint:\n- " + "\n- ".join(refusals)
        )
    record = {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": now(),
        "operation": arguments.operation,
        "attempt": arguments.attempt,
        "dispatch_candidate_id": dispatch_candidate,
        "return_candidate_id": return_candidate,
        "drifted_paths": drifted,
        "cause": arguments.cause.strip(),
    }
    append_jsonl(arguments.run_dir / "candidate-drift.jsonl", record)
    print(f"drift accepted {arguments.operation}#{arguments.attempt}: " + ", ".join(drifted))


def authority_drift(run_dir: Path, root: Path) -> list[dict[str, str]]:
    manifest = load_json(run_dir / "authority.json")
    drift: list[dict[str, str]] = []
    for authority in manifest["authorities"]:
        target = root / authority["path"]
        current = hashlib.sha256(target.read_bytes()).hexdigest() if target.is_file() else "missing"
        if current != authority["content_sha256"]:
            drift.append(
                {
                    "path": authority["path"],
                    "captured_sha256": authority["content_sha256"],
                    "current_sha256": current,
                }
            )
    return drift


def command_capture_change(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    reviewed = load_json(arguments.run_dir / "reviewed-candidate.json")
    validate_candidate_manifest(reviewed)
    current = tree_manifest(root)
    reviewed_product = load_json(arguments.run_dir / "reviewed-product-candidate.json")
    validate_candidate_manifest(reviewed_product)
    current_product = product_manifest(root)
    record_lineage(arguments.run_dir, current, "capture-change")
    drift = authority_drift(arguments.run_dir, root)
    metadata = {
        "risk_tags": arguments.risk_tag,
        "selected_tests": arguments.test,
        "selection_reason": arguments.selection_reason,
        "intentionally_unchanged": arguments.unchanged,
        "rebase_reasons": arguments.rebase_reason,
        "failure_analysis": arguments.failure_analysis,
        "falsifiers": [],
        "gate_status": {
            "focused": arguments.gate_status,
            "reason": arguments.gate_reason,
        },
    }
    if arguments.metadata or arguments.metadata_artifact:
        supplied = (
            load_json(arguments.metadata)
            if arguments.metadata
            else extract_json_block(arguments.metadata_artifact, "### Change Evidence")
        )
        expected_fields = set(metadata)
        if not isinstance(supplied, dict) or set(supplied) != expected_fields:
            raise EvidenceError(
                "change metadata must contain exactly: " + ", ".join(sorted(expected_fields))
            )
        metadata = supplied
    for field in (
        "risk_tags",
        "selected_tests",
        "rebase_reasons",
    ):
        validate_string_list(metadata[field], f"change metadata {field}")
    falsifiers = validate_falsifiers(metadata["falsifiers"])
    gate_status = validate_gate_status(metadata["gate_status"])
    validate_relative_paths(
        metadata["intentionally_unchanged"],
        "change metadata intentionally_unchanged",
    )
    if (
        not isinstance(metadata["selection_reason"], str)
        or not metadata["selection_reason"].strip()
    ):
        raise EvidenceError("change metadata selection_reason must be nonempty text")
    if not isinstance(metadata["failure_analysis"], str):
        raise EvidenceError("change metadata failure_analysis must be a string")
    risk_tags = sorted(set(metadata["risk_tags"]))
    invalid_tags = [
        tag for tag in risk_tags if tag not in RISK_TAGS and not tag.startswith("project:")
    ]
    if invalid_tags:
        raise EvidenceError(f"unknown risk tag(s): {', '.join(invalid_tags)}")
    reviewed_change_path = arguments.run_dir / "reviewed-change.json"
    prior_risk_tags = (
        set(load_json(reviewed_change_path).get("risk_tags", []))
        if reviewed_change_path.exists()
        else set()
    )
    if reviewed_change_path.exists() and not metadata["failure_analysis"].strip():
        raise EvidenceError("change metadata failure_analysis must be nonempty on a revision round")
    new_risk_tags = sorted(set(risk_tags) - prior_risk_tags)
    change = {
        "schema_version": SCHEMA_VERSION,
        "captured_at": now(),
        "reviewed_candidate_id": reviewed["candidate_id"],
        "candidate_id": current["candidate_id"],
        "reviewed_product_candidate_id": reviewed_product["candidate_id"],
        "product_candidate_id": current_product["candidate_id"],
        "changed_files": changed_entries(reviewed, current),
        "risk_tags": risk_tags,
        "new_risk_tags": new_risk_tags,
        "selected_tests": sorted(set(metadata["selected_tests"])),
        "selection_reason": metadata["selection_reason"].strip(),
        "intentionally_unchanged": sorted(
            set(metadata["intentionally_unchanged"]), key=os.fsencode
        ),
        "authority_drift": drift,
        "rebase_required": bool(drift)
        or bool(metadata["rebase_reasons"])
        or bool(prior_risk_tags and new_risk_tags),
        "rebase_reasons": sorted(set(metadata["rebase_reasons"])),
        "failure_analysis": metadata["failure_analysis"].strip(),
        "falsifiers": falsifiers,
        "gate_status": gate_status,
    }
    atomic_json(arguments.run_dir / "change.json", change)
    atomic_json(arguments.run_dir / "candidate.json", current)
    atomic_json(arguments.run_dir / "product-candidate.json", current_product)
    print(current["candidate_id"])


def command_mark_reviewed(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    current = tree_manifest(root)
    current_product = product_manifest(root)
    record_lineage(arguments.run_dir, current, "mark-reviewed")
    if arguments.expected_candidate:
        expected = validate_candidate_id(arguments.expected_candidate, "expected candidate")
        if current["candidate_id"] != expected:
            raise EvidenceError(
                f"candidate mismatch: expected {expected}, found {current['candidate_id']}"
            )
    atomic_json(arguments.run_dir / "reviewed-candidate.json", current)
    atomic_json(arguments.run_dir / "reviewed-product-candidate.json", current_product)
    change_path = arguments.run_dir / "change.json"
    if change_path.exists():
        atomic_json(
            arguments.run_dir / "reviewed-change.json",
            load_json(change_path),
        )
    print(current["candidate_id"])


def command_capture_plan(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    if not arguments.plan.is_file():
        raise EvidenceError(f"plan artifact does not exist: {arguments.plan}")
    current_text = arguments.plan.read_text()
    reviewed_path = arguments.run_dir / "reviewed-plan.md"
    reviewed_text = reviewed_path.read_text() if reviewed_path.exists() else current_text
    if not reviewed_path.exists():
        reviewed_path.write_text(current_text)
    delta = "".join(
        difflib.unified_diff(
            reviewed_text.splitlines(keepends=True),
            current_text.splitlines(keepends=True),
            fromfile="reviewed-plan",
            tofile="current-plan",
        )
    )
    delta_path = arguments.run_dir / "plan-change.patch"
    delta_path.write_text(delta)
    candidate = tree_manifest(root)
    product = product_manifest(root)
    drift = authority_drift(arguments.run_dir, root)
    manifest = {
        "schema_version": SCHEMA_VERSION,
        "captured_at": now(),
        "candidate_id": candidate["candidate_id"],
        "product_candidate_id": product["candidate_id"],
        "reviewed_plan_sha256": hashlib.sha256(reviewed_text.encode()).hexdigest(),
        "plan_sha256": hashlib.sha256(current_text.encode()).hexdigest(),
        "changed": reviewed_text != current_text,
        "delta_sha256": hashlib.sha256(delta.encode()).hexdigest(),
        "delta_bytes": len(delta.encode()),
        "authority_drift": drift,
        "rebase_required": bool(drift) or bool(arguments.rebase_reason),
        "rebase_reasons": sorted(set(arguments.rebase_reason)),
    }
    atomic_json(arguments.run_dir / "plan-change.json", manifest)
    atomic_json(arguments.run_dir / "candidate.json", candidate)
    atomic_json(arguments.run_dir / "product-candidate.json", product)
    print(manifest["plan_sha256"])


def command_mark_plan_reviewed(arguments: argparse.Namespace) -> None:
    validate_run_dir(arguments.run_dir)
    if not arguments.plan.is_file():
        raise EvidenceError(f"plan artifact does not exist: {arguments.plan}")
    current_text = arguments.plan.read_text()
    expected = arguments.expected_plan
    actual = hashlib.sha256(current_text.encode()).hexdigest()
    if expected and validate_candidate_id(expected, "expected plan hash") != actual:
        raise EvidenceError(f"plan mismatch: expected {expected}, found {actual}")
    (arguments.run_dir / "reviewed-plan.md").write_text(current_text)
    print(actual)


def require_text(value: Any, finding_label: str, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise EvidenceError(f"{finding_label} field {field} must be nonempty text")
    return value.strip()


def normalize_finding(value: Any, index: int) -> tuple[Any, list[tuple[str, str, str, str]]]:
    if not isinstance(value, dict):
        return value, []
    normalized = dict(value)
    label_value = normalized.get("id")
    label = (
        label_value.strip()
        if isinstance(label_value, str) and label_value.strip()
        else f"finding[{index}]"
    )
    notices: list[tuple[str, str, str, str]] = []
    for field, aliases in FINDING_ALIASES.items():
        original = normalized.get(field)
        if isinstance(original, str) and original in aliases:
            replacement = aliases[original]
            normalized[field] = replacement
            notices.append((label, field, original, replacement))
    return normalized, notices


def validate_finding(value: Any, index: int) -> dict[str, Any]:
    if not isinstance(value, dict):
        raise FindingValidationError([("not-an-object", f"finding[{index}] must be an object")])
    raw_id = value.get("id")
    label = raw_id.strip() if isinstance(raw_id, str) and raw_id.strip() else f"finding[{index}]"
    errors: list[tuple[str, str]] = []

    def text_field(field: str, *, optional: bool = False) -> str | None:
        raw = value.get(field)
        if optional and raw is None:
            return None
        try:
            return require_text(raw, label, field)
        except EvidenceError as exc:
            errors.append(("text-missing", str(exc)))
            return None

    finding_id = text_field("id") or label
    if finding_id != label or isinstance(raw_id, str):
        if not FINDING_ID.fullmatch(finding_id):
            errors.append(("id-format", f"{label} field id is invalid: {finding_id}"))
    severity = text_field("severity")
    state = text_field("state")
    classification = text_field("classification")
    authority = text_field("authority")
    evidence = text_field("evidence")
    required_outcome = text_field("required_outcome")
    disposition = text_field("disposition", optional=True)
    if severity is not None and severity not in SEVERITIES:
        errors.append(("severity-invalid", f"{label} field severity is invalid: {severity}"))
    if evidence is not None and EVIDENCE_PLACEHOLDER.search(evidence):
        # A pass that never saw the prior ledger cannot carry its findings; the
        # orchestrator hands the ledger to the next dispatch instead.
        errors.append(
            (
                "evidence-placeholder",
                f"{label} field evidence is a carry-forward placeholder, not evidence",
            )
        )
    if evidence is not None and severity == "blocking" and SUSPECTED_PREFIX.match(evidence):
        # A read-only reviewer's unexecuted runtime claim is capped below
        # blocking; the orchestrator runs the probe and the next round decides.
        errors.append(
            (
                "suspected-not-blocking",
                f"{label} marks its evidence SUSPECTED and cannot be blocking",
            )
        )
    if state is not None and state not in STATES:
        errors.append(("state-invalid", f"{label} field state is invalid: {state}"))
    if classification is not None and classification not in CLASSIFICATIONS:
        errors.append(
            (
                "classification-invalid",
                f"{label} field classification is invalid: {classification}",
            )
        )
    affected_paths = value.get("affected_paths")
    if not isinstance(affected_paths, list):
        errors.append(("affected-paths-invalid", f"{label} field affected_paths must be an array"))
        affected_paths = []
    elif affected_paths:
        try:
            validate_relative_paths(affected_paths, f"{label} field affected_paths")
        except EvidenceError as exc:
            errors.append(("affected-paths-invalid", str(exc)))
    introduced_in: str | None = None
    try:
        introduced_in = validate_candidate_id(
            value.get("introduced_in"), f"{label} field introduced_in"
        )
    except EvidenceError as exc:
        errors.append(("introduced-in-invalid", str(exc)))
    resolved_value = value.get("resolved_in")
    resolved_in: str | None = None
    if resolved_value is not None:
        try:
            resolved_in = validate_candidate_id(resolved_value, f"{label} field resolved_in")
        except EvidenceError as exc:
            errors.append(("resolved-in-invalid", str(exc)))
    if state in {"verified", "closed", "rejected-with-evidence", "superseded"} and not resolved_in:
        errors.append(
            (
                "resolved-in-required",
                f"{label} field resolved_in is required for state {state}",
            )
        )
    if errors:
        raise FindingValidationError(errors)
    assert (
        severity is not None
        and state is not None
        and classification is not None
        and authority is not None
        and evidence is not None
        and required_outcome is not None
        and introduced_in is not None
    )
    return {
        "id": finding_id,
        "severity": severity,
        "authority": authority,
        "evidence": evidence,
        "affected_paths": sorted(set(affected_paths), key=os.fsencode),
        "required_outcome": required_outcome,
        "introduced_in": introduced_in,
        "resolved_in": resolved_in,
        "state": state,
        "classification": classification,
        "disposition": disposition,
    }


def command_ingest_findings(arguments: argparse.Namespace) -> None:
    # Flag consistency is settled before any work, so a malformed invocation
    # fails immediately rather than after the whole artifact is validated.
    if arguments.review_span_id is not None and arguments.no_review_span is not None:
        raise EvidenceError("--review-span-id and --no-review-span are mutually exclusive")
    if arguments.no_review_span is not None and not arguments.no_review_span.strip():
        raise EvidenceError("--no-review-span requires a nonempty reason")
    run = validate_run_dir(arguments.run_dir)
    current = tree_manifest(Path(run["repository_root"]))
    expected_candidate = validate_candidate_id(arguments.candidate, "finding candidate")
    if current["candidate_id"] != expected_candidate:
        raise EvidenceError(
            f"candidate mismatch: expected {expected_candidate}, found {current['candidate_id']}"
        )
    source_path = arguments.input if arguments.input else arguments.artifact
    incoming_document = (
        load_json(arguments.input) if arguments.input else read_role_artifact(arguments.artifact)
    )
    if not isinstance(incoming_document, dict) or not isinstance(
        incoming_document.get("findings"), list
    ):
        raise EvidenceError("finding input must be an object with a findings array")
    artifact_sha256 = source_digest(source_path)
    reported = len(incoming_document["findings"])
    incoming: list[dict[str, Any]] = []
    validation_errors: list[tuple[str, str]] = []
    normalization_notices: list[tuple[str, str, str, str]] = []
    for index, raw_finding in enumerate(incoming_document["findings"]):
        normalized, notices = normalize_finding(raw_finding, index)
        normalization_notices.extend(notices)
        try:
            incoming.append(validate_finding(normalized, index))
        except FindingValidationError as exc:
            validation_errors.extend(exc.errors)
    for label, field, original, replacement in normalization_notices:
        print(
            f"kickoff-evidence: normalized {label} field {field}: {original} -> {replacement}",
            file=sys.stderr,
        )
    duplicate_ids = sorted(
        {
            item["id"]
            for item in incoming
            if sum(candidate["id"] == item["id"] for candidate in incoming) > 1
        }
    )
    if duplicate_ids:
        validation_errors.append(
            ("duplicate-id", "duplicate field id: " + ", ".join(duplicate_ids))
        )
    ledger = load_json(arguments.run_dir / "findings.json")
    existing = {item["id"]: item for item in ledger["findings"]}
    prefix = f"{arguments.kind.upper()}-"
    # Captured before any mutation: this is what makes the merge replayable
    # after `findings.json` has been rewritten wholesale, and it is the base
    # term `actionable_findings` counts over.
    ledger_before = {
        item["id"]: item["state"] for item in ledger["findings"] if item["id"].startswith(prefix)
    }
    reopened = int(ledger.get("reopened_count", 0))
    relationship_errors: list[tuple[str, str]] = []
    # A new finding's `introduced_in` may name any candidate this run recorded,
    # not only the current head. The tree's identity changes for reasons that
    # have nothing to do with the code under review — the status marker and the
    # START log block are tracked files — so a reviewer that stamped the id it
    # was actually given is telling the truth, and rejecting it discards correct
    # work over the orchestrator's bookkeeping. The set stays closed: an id the
    # run never observed is still refused.
    accepted_lineage = set(lineage_candidates(arguments.run_dir))
    accepted_lineage.add(expected_candidate)
    # A `resolved_in` still names the current candidate, with exactly one
    # recorded exception. When this pass's *own* dispatch carries an accepted,
    # proven-disjoint drift record whose return candidate is the candidate being
    # ingested, the candidate the reviewer was dispatched against is admissible
    # too. Rewriting the stamp instead would record that a reviewer verified a
    # tree it never saw. An ingest with `--no-review-span` names no dispatch and
    # gets nothing, and a drift record for some other pass proves nothing here.
    accepted_resolutions = {expected_candidate}
    admitted_drift: dict[str, Any] | None = None
    if arguments.review_span_id is not None:
        drift_records = load_candidate_drift(arguments.run_dir)
        for item in load_role_dispatches(arguments.run_dir):
            if item.get("intelligence_span_id") != arguments.review_span_id or not item.get(
                "accepted"
            ):
                continue
            drift = drift_records.get((item["operation"], item["attempt"]))
            if drift is None:
                continue
            if not drift_record_matches_dispatch(drift, item):
                # The same check `validate` applies, applied where it is
                # cheapest to fix. An orchestrator error, not a batch defect:
                # nothing is wrong with the review pass's findings.
                raise EvidenceError(
                    "candidate-drift record does not describe the accepted "
                    f"dispatch it names: {item['operation']} attempt "
                    f"{item['attempt']}"
                )
            if drift["return_candidate_id"] == expected_candidate:
                accepted_resolutions.add(drift["dispatch_candidate_id"])
                admitted_drift = drift
    for finding in incoming:
        if not finding["id"].startswith(prefix):
            relationship_errors.append(
                (
                    "namespace-mismatch",
                    f"{finding['id']} field id must use the {prefix}FNNN namespace",
                )
            )
        prior = existing.get(finding["id"])
        if prior is None and finding["introduced_in"] not in accepted_lineage:
            relationship_errors.append(
                (
                    "introduced-in-unrecorded",
                    f"{finding['id']} field introduced_in "
                    f"{finding['introduced_in'][:12]}… "
                    "is not a candidate this run recorded",
                )
            )
        if (
            finding["resolved_in"] is not None
            and finding["resolved_in"] not in accepted_resolutions
        ):
            relationship_errors.append(
                (
                    "resolved-in-not-current",
                    f"{finding['id']} field resolved_in does not match the reviewed candidate",
                )
            )
        if prior:
            for immutable in ("authority", "required_outcome", "introduced_in"):
                if prior[immutable] != finding[immutable]:
                    relationship_errors.append(
                        (
                            "immutable-changed",
                            f"{finding['id']} changes immutable field {immutable}",
                        )
                    )
            # A finding that stays actionable keeps the objection it was
            # opened for. Substituting new evidence under the old id is several
            # findings wearing one label: the ledger then cannot say which
            # round's objection was missed, and one id becomes four rounds.
            # Progress notes belong in `disposition`; a further defect gets a
            # new id classified by how it surfaced.
            if (
                prior["state"] in ACTIONABLE_STATES
                and finding["state"] in ACTIONABLE_STATES
                and prior["evidence"] != finding["evidence"]
            ):
                relationship_errors.append(
                    (
                        "evidence-substituted",
                        f"{finding['id']} substitutes evidence while it remains "
                        "actionable; a new objection is a new finding "
                        "(newly-exposed-by-resolution, introduced-by-revision, or "
                        "missed-in-full-pass) and progress notes go in disposition",
                    )
                )
            if finding["state"] not in ALLOWED_TRANSITIONS[prior["state"]]:
                relationship_errors.append(
                    (
                        "transition-invalid",
                        f"{finding['id']} field state has invalid transition: "
                        f"{prior['state']} -> {finding['state']}",
                    )
                )
            if (
                prior["state"] in {"closed", "verified", "rejected-with-evidence"}
                and finding["state"] == "open"
            ):
                reopened += 1
        existing[finding["id"]] = finding
    all_errors = [*validation_errors, *relationship_errors]
    if all_errors:
        detail = "finding validation failed:\n- " + "\n- ".join(
            message for _, message in all_errors
        )
        # Content refusals only, and only from here: everything above is an
        # orchestrator error — a bad run directory, inconsistent flags, the
        # wrong candidate, an unreadable artifact — not a defect in a review
        # pass's own findings, and a journal that recorded those would be
        # describing something other than a batch.
        append_jsonl(
            arguments.run_dir / "ingest-log.jsonl",
            {
                "schema_version": SCHEMA_VERSION,
                "recorded_at": now(),
                "kind": arguments.kind,
                "candidate_id": expected_candidate,
                "review_span_id": arguments.review_span_id,
                "artifact_sha256": artifact_sha256,
                "findings_reported": reported,
                "ledger_before": ledger_before,
                "outcome": "refused",
                "refusal_codes": sorted({code for code, _ in all_errors}),
                "refusal_detail": detail,
                "actionable_findings": None,
            },
        )
        raise EvidenceError(detail)
    if admitted_drift is not None and any(
        item["resolved_in"] == admitted_drift["dispatch_candidate_id"] for item in incoming
    ):
        print(
            "kickoff-evidence: admitted resolved_in "
            f"{admitted_drift['dispatch_candidate_id'][:12]}… under the accepted "
            f"candidate drift for {admitted_drift['operation']}"
            f"#{admitted_drift['attempt']} "
            f"({', '.join(admitted_drift['drifted_paths'])})",
            file=sys.stderr,
        )
    updated = {
        "schema_version": SCHEMA_VERSION,
        "updated_at": now(),
        "reopened_count": reopened,
        "findings": [existing[key] for key in sorted(existing)],
    }
    # The whole merged ledger, namespace-filtered — the policy's "that
    # namespace's actionable findings remaining after reconciliation". Any
    # replay of this number must reproduce this expression, base term included.
    actionable = sum(
        item["id"].startswith(prefix) and item["state"] in ACTIONABLE_STATES
        for item in updated["findings"]
    )
    # Convergence metrics live on the review pass's own intelligence span, and a
    # span is immutable once its trace is finalized. An omitted --review-span-id
    # is therefore unrepairable after the fact: `timing-summary` refuses for the
    # whole run, and the only way to attach the metrics late would be to
    # re-ingest earlier artifacts, driving `verified -> open` and reopening
    # resolved findings to satisfy a validator. So the flag is required, and the
    # only alternative is to own the omission in writing.
    if arguments.review_span_id is None and not arguments.no_review_span:
        raise EvidenceError(
            "ingest-findings requires --review-span-id: convergence metrics "
            "(findings_reported, actionable_findings) attach to the review "
            "pass's intelligence span, and a finalized trace cannot be repaired "
            "retroactively, so omitting it makes `timing-summary` refuse for the "
            "entire run. Pass the reviewer's or critic's intelligence span id. "
            "If this ingest is not a review pass and no such span exists — an "
            "orchestrator-authored state transition, for instance — pass "
            "--no-review-span '<reason>' to record the omission."
        )
    if arguments.no_review_span:
        omission = {
            "schema_version": SCHEMA_VERSION,
            "recorded_at": now(),
            "kind": arguments.kind,
            "candidate_id": expected_candidate,
            "findings_reported": len(incoming),
            "reason": arguments.no_review_span.strip(),
        }
        append_jsonl(arguments.run_dir / "review-metrics-omitted.jsonl", omission)
        print(
            "kickoff-evidence: recorded WITHOUT review convergence metrics "
            f"({arguments.kind}, {len(incoming)} findings): {omission['reason']}",
            file=sys.stderr,
        )
    if arguments.review_span_id is not None:
        expected_operation = {
            "plan": "role.plan-review",
            "code": "role.code-review",
        }[arguments.kind]
        dispatches = [
            item
            for item in load_role_dispatches(arguments.run_dir)
            if item.get("intelligence_span_id") == arguments.review_span_id
        ]
        if (
            len(dispatches) != 1
            or not dispatches[0].get("accepted")
            or dispatches[0].get("operation") != expected_operation
        ):
            raise EvidenceError(
                "review finding metrics require the matching accepted review dispatch"
            )
        try:
            attach_review_metrics(
                engine_root=Path(run["repository_root"]),
                trace_id=run["telemetry_trace_id"],
                span_id=arguments.review_span_id,
                findings_reported=len(incoming),
                actionable_findings=actionable,
            )
        except TelemetryError as exc:
            raise EvidenceError(f"cannot attach review convergence metrics: {exc}") from exc
    atomic_json(arguments.run_dir / "findings.json", updated)
    # After the merge lands, never before: a journal that claimed a merge which
    # never happened would be exactly the fiction this ledger exists to prevent.
    append_jsonl(
        arguments.run_dir / "ingest-log.jsonl",
        {
            "schema_version": SCHEMA_VERSION,
            "recorded_at": now(),
            "kind": arguments.kind,
            "candidate_id": expected_candidate,
            "review_span_id": arguments.review_span_id,
            "artifact_sha256": artifact_sha256,
            "findings_reported": reported,
            "ledger_before": ledger_before,
            "outcome": "accepted",
            "refusal_codes": [],
            "refusal_detail": None,
            "actionable_findings": actionable,
        },
    )
    print(len(updated["findings"]))


def command_record_gate(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    current = tree_manifest(root)
    product = product_manifest(root)
    expected = validate_candidate_id(arguments.candidate, "gate candidate")
    if current["candidate_id"] != expected:
        raise EvidenceError(
            f"candidate mismatch: expected {expected}, found {current['candidate_id']}"
        )
    artifact_digest = None
    argv = list(arguments.argv)
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv or any(not isinstance(item, str) or not item for item in argv):
        raise EvidenceError("record-gate requires exact argv after --")
    if not arguments.selection_reason.strip():
        raise EvidenceError("gate selection reason must be nonempty")
    if arguments.warning_count < 0:
        raise EvidenceError("gate warning count cannot be negative")
    if arguments.artifact:
        if not arguments.artifact.is_file():
            raise EvidenceError(f"gate artifact does not exist: {arguments.artifact}")
        artifact_digest = hashlib.sha256(arguments.artifact.read_bytes()).hexdigest()
    if arguments.final:
        raise EvidenceError("managed final gates must use run-gate")
    record = {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": now(),
        "candidate_id": expected,
        "candidate_after_id": expected,
        "product_candidate_id": product["candidate_id"],
        "product_candidate_after_id": product["candidate_id"],
        "command_manifest_sha256": None,
        "argv": argv,
        "command": shlex.join(argv),
        "operation": "gate.imported",
        "attempt": 1,
        "selection_reason": arguments.selection_reason.strip(),
        "exit_code": arguments.exit_code,
        "outcome": "success" if arguments.exit_code == 0 else "error",
        "warning_count": arguments.warning_count,
        "artifact_sha256": artifact_digest,
        "final": False,
        "telemetry_trace_id": run["telemetry_trace_id"],
        "telemetry_span_id": None,
        "duration_ns": None,
        "telemetry_complete": False,
    }
    append_jsonl(arguments.run_dir / "gates.jsonl", record)
    print("recorded")


def command_run_gate(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    expected = validate_candidate_id(arguments.candidate, "gate candidate")
    before = tree_manifest(root)
    product_before = product_manifest(root)
    if before["candidate_id"] != expected:
        raise EvidenceError(
            f"candidate mismatch: expected {expected}, found {before['candidate_id']}"
        )
    if arguments.warning_count < 0 or not arguments.selection_reason.strip():
        raise EvidenceError("gate warning count/reason is invalid")
    argv = list(arguments.argv)
    if argv and argv[0] == "--":
        argv = argv[1:]
    if not argv or any(not isinstance(item, str) or not item for item in argv):
        raise EvidenceError("run-gate requires exact argv after --")
    active_manifest = active_gate_manifest(arguments.run_dir)
    if run["evidence_lane"] == "full" and active_manifest is None:
        raise EvidenceError("full evidence lane requires an active gate manifest before run-gate")
    manifest_digest: str | None = None
    if active_manifest is not None:
        manifest, manifest_digest = active_manifest
        if not kickoff_runbook.admitted(
            manifest,
            operation=arguments.operation,
            attempt=arguments.attempt,
            final=arguments.final,
            argv=argv,
        ):
            raise EvidenceError("gate command is absent from the active immutable manifest")
    if arguments.final and run["evidence_lane"] == "full":
        validate_role_preflight_receipt(arguments.run_dir, root)
        validate_preacceptance_topology(run, arguments.run_dir, root)
    # Artifact preconditions are checked BEFORE the command runs. Everything
    # after `run_observed` has opened a span must be recoverable, because a
    # closed span is immutable and a root-parented gate span with no evidence
    # row makes `validate` refuse forever with no supported repair — the
    # artifact check used to raise here and strand exactly that.
    if arguments.artifact:
        if arguments.artifact.is_dir():
            raise EvidenceError(f"gate artifact is a directory: {arguments.artifact}")
        parent = arguments.artifact.parent
        if not parent.is_dir():
            raise EvidenceError(f"gate artifact directory does not exist: {parent}")
    original_directory = Path.cwd()
    try:
        os.chdir(root)
        result = run_observed(
            engine_root=root,
            trace_id=run["telemetry_trace_id"],
            parent_span_id=run["telemetry_root_span_id"],
            category="gate",
            operation=arguments.operation,
            attempt=arguments.attempt,
            timeout_seconds=arguments.timeout_seconds,
            argv=argv,
        )
    finally:
        os.chdir(original_directory)
    after = tree_manifest(root)
    product_after = product_manifest(root)
    artifact_digest = None
    if arguments.artifact:
        if arguments.artifact.is_file():
            artifact_digest = hashlib.sha256(arguments.artifact.read_bytes()).hexdigest()
        else:
            # The command ran and its span is closed. Refusing here would orphan
            # that span permanently, so record the gate truthfully with no
            # digest and say so loudly instead.
            print(
                "kickoff-evidence: gate artifact absent after the command ran: "
                f"{arguments.artifact} (recorded with no digest)",
                file=sys.stderr,
            )
    span = None
    if result.telemetry_complete and result.span_id:
        try:
            span = closed_span(
                engine_root=root,
                trace_id=run["telemetry_trace_id"],
                span_id=result.span_id,
            )
        except TelemetryError:
            span = None
    telemetry_complete = span is not None
    record = {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": now(),
        "candidate_id": expected,
        "candidate_after_id": after["candidate_id"],
        "product_candidate_id": product_before["candidate_id"],
        "product_candidate_after_id": product_after["candidate_id"],
        "command_manifest_sha256": manifest_digest,
        "argv": argv,
        "command": shlex.join(argv),
        "operation": arguments.operation,
        "attempt": arguments.attempt,
        "selection_reason": arguments.selection_reason.strip(),
        "exit_code": result.exit_code,
        "outcome": result.outcome,
        "warning_count": arguments.warning_count,
        "artifact_sha256": artifact_digest,
        "final": arguments.final,
        "telemetry_trace_id": run["telemetry_trace_id"],
        "telemetry_span_id": result.span_id if telemetry_complete else None,
        "duration_ns": span["duration_ns"] if span else None,
        "telemetry_complete": telemetry_complete,
    }
    append_jsonl(arguments.run_dir / "gates.jsonl", record)
    if after["candidate_id"] != expected:
        print("kickoff-evidence: gate changed the candidate", file=sys.stderr)
        raise SystemExit(2)
    if product_after["candidate_id"] != product_before["candidate_id"]:
        print("kickoff-evidence: gate changed the product candidate", file=sys.stderr)
        raise SystemExit(2)
    if not telemetry_complete:
        print("kickoff-evidence: gate telemetry is incomplete", file=sys.stderr)
        raise SystemExit(result.exit_code or 2)
    raise SystemExit(result.exit_code)


TELEMETRY_INCOMPLETE_FIELDS = ("role", "harness", "model", "effort")


def validate_span_identifier(value: Any, label: str) -> str:
    if (
        not isinstance(value, str)
        or len(value) != 32
        or any(character not in "0123456789abcdef" for character in value)
    ):
        raise EvidenceError(f"{label} must be a 32-character lowercase hex span id")
    return value


def load_telemetry_declarations(run_dir: Path) -> dict[tuple[str, int], dict[str, Any]]:
    """Declared wait-join defects, keyed by the attempt that owns each one."""
    declarations: dict[tuple[str, int], dict[str, Any]] = {}
    path = run_dir / "telemetry-incomplete.jsonl"
    # Absent is the ordinary case: a run that declared nothing has nothing to
    # excuse, which is different from a run whose declarations are unreadable.
    if not path.exists():
        return declarations
    for entry in load_jsonl(path):
        required = {
            "schema_version",
            "recorded_at",
            "operation",
            "attempt",
            "span_id",
            "missing_fields",
            "cause",
        }
        if (
            set(entry) != required
            or entry.get("schema_version") != SCHEMA_VERSION
            or not isinstance(entry.get("missing_fields"), list)
            or not entry["missing_fields"]
            or any(field not in TELEMETRY_INCOMPLETE_FIELDS for field in entry["missing_fields"])
            or not isinstance(entry.get("cause"), str)
            or not entry["cause"].strip()
        ):
            raise EvidenceError("invalid telemetry-incompleteness record")
        key = (entry["operation"], entry["attempt"])
        if key in declarations:
            raise EvidenceError("duplicate telemetry-incompleteness record")
        declarations[key] = entry
    return declarations


def accept_incomplete_wait_join(
    declared: dict[str, Any],
    record: dict[str, Any],
    dispatch: dict[str, Any],
    wait: dict[str, Any],
) -> dict[str, Any]:
    """Admit a wait-span join whose exact defect the run has owned in writing.

    A span is immutable once closed, so an orchestrator that opens a native
    wait span without its routing metadata cannot repair it — and a validator
    that can only refuse turns one honest slip into a phase that can never
    close. The declaration is what keeps that from becoming a way to wave
    problems through: it must name the span actually present, and every defect
    it excuses must really be there. Anything it did not declare still fails.
    """
    if declared["span_id"] != wait["span_id"]:
        raise EvidenceError(
            "telemetry-incompleteness record names a span the trace does not "
            f"carry for this attempt: declared {declared['span_id']}, observed "
            f"{wait['span_id']}"
        )
    if dispatch["wait_span_id"] not in (None, wait["span_id"]):
        raise EvidenceError("dispatch and wait span ids do not agree")
    excused = set(declared["missing_fields"])
    for field in TELEMETRY_INCOMPLETE_FIELDS:
        expected = record[field]
        actual = wait.get(field)
        agrees = (field not in wait) if expected is None else (actual == expected)
        if agrees and field in excused:
            raise EvidenceError(
                f"telemetry-incompleteness record excuses {field}, which the "
                "wait span records correctly"
            )
        if not agrees and field not in excused:
            raise EvidenceError(f"wait span {field} does not match registration")
    return {
        "operation": record["operation"],
        "attempt": record["attempt"],
        "span_id": wait["span_id"],
        "missing_fields": sorted(excused),
        "cause": declared["cause"],
        "dispatch_wait_span_id": dispatch["wait_span_id"],
    }


def validate_role_spans(run_dir: Path, run: dict[str, Any]) -> list[dict[str, Any]]:
    declarations = load_telemetry_declarations(run_dir)
    degraded: list[dict[str, Any]] = []
    records = load_jsonl(run_dir / "role-attempts.jsonl")
    keys: set[tuple[str, int]] = set()
    by_operation: dict[str, list[int]] = {}
    for record in records:
        validate_role_record(record, run)
        key = (record["operation"], record["attempt"])
        if key in keys:
            raise EvidenceError("duplicate role-attempt registration")
        keys.add(key)
        by_operation.setdefault(record["operation"], []).append(record["attempt"])
    for operation, attempts in by_operation.items():
        if sorted(attempts) != list(range(1, max(attempts) + 1)):
            raise EvidenceError(f"role attempts are not contiguous for {operation}")
    for operation in run["required_initial_role_operations"]:
        if (operation, 1) not in keys and run.get("evidence_lane") != "light":
            # In the light evidence lane role registration is validated when
            # present, never required; the run metadata records the demotion.
            raise EvidenceError(f"missing required initial role attempt: {operation}")
    dispatches = load_role_dispatches(run_dir)
    dispatch_by_key: dict[tuple[str, int], dict[str, Any]] = {}
    for dispatch in dispatches:
        required_dispatch = {
            "schema_version",
            "recorded_at",
            "operation",
            "attempt",
            "accepted",
            "idle_telemetry",
            "intelligence_span_id",
            "wait_span_id",
            "dispatch_candidate_id",
            "return_candidate_id",
        }
        if (
            set(dispatch) != required_dispatch
            or dispatch.get("schema_version") != SCHEMA_VERSION
            or not isinstance(dispatch.get("accepted"), bool)
            or dispatch.get("idle_telemetry") not in {"available", "unavailable", "not-dispatched"}
        ):
            raise EvidenceError("invalid role-dispatch record")
        validate_candidate_id(dispatch.get("return_candidate_id"), "dispatch return candidate")
        if dispatch["dispatch_candidate_id"] is not None:
            validate_candidate_id(dispatch["dispatch_candidate_id"], "dispatch-open candidate")
        key = (dispatch.get("operation"), dispatch.get("attempt"))
        if key in dispatch_by_key:
            raise EvidenceError("duplicate role-dispatch record")
        dispatch_by_key[key] = dispatch
    if set(dispatch_by_key) != keys:
        raise EvidenceError("role registrations and dispatch results do not agree")
    try:
        spans = closed_spans(
            engine_root=Path(run["repository_root"]), trace_id=run["telemetry_trace_id"]
        )
        context = trace_context(
            engine_root=Path(run["repository_root"]), trace_id=run["telemetry_trace_id"]
        )
    except TelemetryError as exc:
        raise EvidenceError(f"invalid runtime trace: {exc}") from exc
    observed: set[tuple[str, int]] = set()
    for record in records:
        matching = [
            item
            for item in spans
            if item["operation"] == record["operation"] and item["attempt"] == record["attempt"]
        ]
        intelligence = [item for item in matching if item["category"] == "intelligence"]
        waits = [item for item in matching if item["category"] == "wait"]
        dispatch = dispatch_by_key[(record["operation"], record["attempt"])]
        if len(intelligence) != 1:
            raise EvidenceError(
                f"role attempt lacks one closed intelligence span: {record['operation']}"
            )
        item = intelligence[0]
        if dispatch["intelligence_span_id"] != item["span_id"]:
            raise EvidenceError("dispatch and intelligence span ids do not agree")
        for field in ("role", "harness", "model", "effort"):
            expected = record[field]
            if expected is None:
                if field in item:
                    raise EvidenceError(f"role span unexpectedly records {field}")
            elif item.get(field) != expected:
                raise EvidenceError(f"role span {field} does not match registration")
        if item.get("parent_span_id") != context["root_span_id"]:
            raise EvidenceError("role intelligence span is not a root child")
        if not dispatch["accepted"]:
            if waits or dispatch["wait_span_id"] is not None:
                raise EvidenceError("rejected dispatch must not have a wait span")
        elif len(waits) != 1 or waits[0].get("parent_span_id") != item["span_id"]:
            # A wait span that is simply absent is still a refusal. The
            # degradation below covers a span that exists and is malformed, not
            # one nobody can point at.
            raise EvidenceError("role attempt lacks one closed nested wait span")
        else:
            wait = waits[0]
            declared = declarations.get((record["operation"], record["attempt"]))
            if declared is not None:
                degraded.append(accept_incomplete_wait_join(declared, record, dispatch, wait))
            else:
                if dispatch["wait_span_id"] != wait["span_id"]:
                    raise EvidenceError("dispatch and wait span ids do not agree")
                for field in ("role", "harness", "model", "effort"):
                    expected = record[field]
                    if expected is None:
                        if field in wait:
                            raise EvidenceError(f"wait span unexpectedly records {field}")
                    elif wait.get(field) != expected:
                        raise EvidenceError(f"wait span {field} does not match registration")
        observed.add((record["operation"], record["attempt"]))
    if observed != keys:
        raise EvidenceError("registered and observed role attempts do not agree")
    registered_ids = {
        item["span_id"]
        for item in spans
        if item["category"] in {"intelligence", "wait"} and item["operation"].startswith("role.")
    }
    matched_ids = {
        item["span_id"]
        for item in spans
        for record in records
        if item["operation"] == record["operation"]
        and item["attempt"] == record["attempt"]
        and item["category"] in {"intelligence", "wait"}
    }
    if registered_ids != matched_ids:
        raise EvidenceError("trace contains unregistered role spans")
    undeclared = set(declarations) - observed
    if undeclared:
        named = ", ".join(f"{operation}#{attempt}" for operation, attempt in sorted(undeclared))
        raise EvidenceError(f"telemetry-incompleteness records name unregistered attempts: {named}")
    return sorted(degraded, key=lambda item: (item["operation"], item["attempt"]))


def validate_orchestration_spans(
    bundle: dict[str, Any], run: dict[str, Any]
) -> list[dict[str, Any]]:
    root_id = bundle["root_span_id"]
    candidates = [
        item for item in bundle["spans"] if item["operation"].startswith("orchestration.")
    ]
    if not candidates:
        raise EvidenceError("finalized kickoff trace has no orchestration stage spans")
    for span in candidates:
        if span["operation"] not in ORCHESTRATION_OPERATIONS:
            raise EvidenceError(f"unknown orchestration stage: {span['operation']}")
        if span["category"] != "reconciliation" or span["parent_span_id"] != root_id:
            raise EvidenceError(
                "orchestration stages must be reconciliation children of the run root"
            )
    by_operation: dict[str, list[dict[str, Any]]] = {}
    for span in candidates:
        by_operation.setdefault(span["operation"], []).append(span)
    for operation, spans in by_operation.items():
        attempts = sorted(item["attempt"] for item in spans)
        if attempts != list(range(1, len(spans) + 1)):
            raise EvidenceError(f"orchestration attempts are not contiguous for {operation}")
    missing = [
        operation
        for operation in run["required_orchestration_operations"]
        if not any(
            span["operation"] == operation and span["outcome"] == "success" for span in candidates
        )
    ]
    if missing and run.get("evidence_lane") != "light":
        raise EvidenceError("missing successful orchestration stages: " + ", ".join(missing))
    ordered = sorted(candidates, key=lambda item: (item["start_offset_ns"], item["span_id"]))
    if (
        ordered[0]["span_id"] != run["initial_orchestration_span_id"]
        or ordered[0]["operation"] != "orchestration.setup"
    ):
        raise EvidenceError("initial setup orchestration span is not first")
    close_present = any(span["operation"] == "orchestration.close" for span in ordered)
    if ordered[-1]["operation"] != "orchestration.close" and (
        close_present or run.get("evidence_lane") != "light"
    ):
        raise EvidenceError("close preparation must be the final orchestration stage")
    for previous, current in zip(ordered, ordered[1:]):
        if current["start_offset_ns"] < previous["end_offset_ns"]:
            raise EvidenceError("orchestration stage spans must not overlap")
    return ordered


def load_ingest_journal(run_dir: Path) -> list[dict[str, Any]]:
    """Every ingest this run attempted, accepted and refused alike.

    Absent is the ordinary case for a run that has ingested nothing, which is
    different from a journal that is unreadable. There is deliberately **no**
    duplicate-key refusal here: a review pass whose batch was refused is
    normally re-ingested, so repeated rows for one artifact are the expected
    shape rather than a defect.
    """
    path = run_dir / "ingest-log.jsonl"
    if not path.exists():
        return []
    rows = load_jsonl(path)
    for entry in rows:
        if (
            set(entry) != INGEST_JOURNAL_FIELDS
            or entry.get("schema_version") != SCHEMA_VERSION
            or entry.get("kind") not in {"plan", "code"}
            or entry.get("outcome") not in {"accepted", "refused"}
            or not isinstance(entry.get("ledger_before"), dict)
            or any(
                not isinstance(key, str) or value not in STATES
                for key, value in entry["ledger_before"].items()
            )
            or not isinstance(entry.get("refusal_codes"), list)
            or any(not isinstance(code, str) or not code for code in entry["refusal_codes"])
            or not isinstance(entry.get("findings_reported"), int)
            or isinstance(entry["findings_reported"], bool)
            or entry["findings_reported"] < 0
        ):
            raise EvidenceError("invalid ingest journal record")
        validate_candidate_id(entry.get("candidate_id"), "ingest journal candidate")
        validate_candidate_id(entry.get("artifact_sha256"), "ingest journal artifact hash")
        if entry["review_span_id"] is not None:
            validate_span_identifier(entry["review_span_id"], "ingest journal review span id")
        if entry["outcome"] == "accepted":
            if (
                entry["refusal_codes"]
                or entry["refusal_detail"] is not None
                or not isinstance(entry["actionable_findings"], int)
                or isinstance(entry["actionable_findings"], bool)
                or entry["actionable_findings"] < 0
            ):
                raise EvidenceError("invalid accepted ingest journal record")
        elif (
            not entry["refusal_codes"]
            or not isinstance(entry["refusal_detail"], str)
            or not entry["refusal_detail"].strip()
            or entry["actionable_findings"] is not None
        ):
            raise EvidenceError("invalid refused ingest journal record")
    return rows


def matching_refused_ingests(
    journal: list[dict[str, Any]],
    *,
    kind: str,
    artifact_sha256: str,
    refusal_class: str,
    review_span_id: str,
) -> list[dict[str, Any]]:
    """Refused rows for this artifact, span, and exactly this class's codes.

    Extra codes refuse by construction: a batch that also carried a substance
    defect was never a measurable review pass, whatever else was wrong with it.
    The span binding is what stops one refused artifact backing a derivation for
    some other pass — the ingest that was refused named the span it was for.
    """
    expected = sorted(DERIVED_REFUSAL_CLASSES[refusal_class])
    return [
        row
        for row in journal
        if row["outcome"] == "refused"
        and row["kind"] == kind
        and row["artifact_sha256"] == artifact_sha256
        and row["review_span_id"] == review_span_id
        and sorted(set(row["refusal_codes"])) == expected
    ]


def read_review_batch(
    path: Path, *, label: str, id_map: dict[str, str] | None = None
) -> tuple[Any, list[dict[str, Any]]]:
    """Parse one review artifact into its verdict and validated findings."""
    document = read_role_artifact(path)
    if not isinstance(document, dict) or not isinstance(document.get("findings"), list):
        raise EvidenceError(f"{label} must be an object with a findings array")
    findings: list[dict[str, Any]] = []
    errors: list[str] = []
    for index, raw_finding in enumerate(document["findings"]):
        item = raw_finding
        if id_map and isinstance(item, dict) and isinstance(item.get("id"), str):
            replacement = id_map.get(item["id"].strip())
            if replacement is not None:
                item = {**item, "id": replacement}
        normalized, _ = normalize_finding(item, index)
        try:
            findings.append(validate_finding(normalized, index))
        except FindingValidationError as exc:
            errors.extend(message for _, message in exc.errors)
    if errors:
        raise EvidenceError(
            f"{label} does not validate once the declared class is suppressed:\n- "
            + "\n- ".join(errors)
        )
    identifiers = [item["id"] for item in findings]
    if len(set(identifiers)) != len(identifiers):
        raise EvidenceError(f"{label} carries duplicate finding ids")
    return document.get("verdict"), findings


def raw_finding_identifiers(path: Path, *, label: str) -> list[str]:
    """The `id` each finding in an artifact carries, before any substitution."""
    document = read_role_artifact(path)
    if not isinstance(document, dict) or not isinstance(document.get("findings"), list):
        raise EvidenceError(f"{label} must be an object with a findings array")
    identifiers: list[str] = []
    for index, raw_finding in enumerate(document["findings"]):
        value = raw_finding.get("id") if isinstance(raw_finding, dict) else None
        if not isinstance(value, str) or not value.strip():
            raise EvidenceError(f"{label} finding[{index}] has no textual id to map")
        identifiers.append(value.strip())
    return identifiers


def validate_id_bijection(
    id_map: dict[str, str], *, raw_identifiers: list[str], prefix: str
) -> None:
    """A rename is admissible only as a total, injective, legal substitution.

    Total over the ids that actually failed `FINDING_ID`, injective into ids
    that pass it and belong to this namespace, and never onto an id the batch
    already uses. Whether a target may legally land on an existing ledger entry
    is settled downstream by `replay_refused_batch`, which applies
    `ALLOWED_TRANSITIONS` against the recorded prior state.
    """
    malformed = sorted({value for value in raw_identifiers if not FINDING_ID.fullmatch(value)})
    if sorted(id_map) != malformed:
        raise EvidenceError(
            "--id-map must name exactly the artifact's malformed finding ids: "
            f"expected {', '.join(malformed) or 'none'}, got "
            f"{', '.join(sorted(id_map)) or 'none'}"
        )
    targets = list(id_map.values())
    if len(set(targets)) != len(targets):
        raise EvidenceError("--id-map must be injective")
    for target in sorted(targets):
        if not FINDING_ID.fullmatch(target):
            raise EvidenceError(f"--id-map target is not a valid finding id: {target}")
        if not target.startswith(prefix):
            raise EvidenceError(f"--id-map target {target} must use the {prefix}FNNN namespace")
        if target in raw_identifiers:
            raise EvidenceError(
                f"--id-map target {target} already names another finding in the batch"
            )


def replay_refused_batch(
    *,
    findings: list[dict[str, Any]],
    row: dict[str, Any],
    refusal_class: str,
    lineage: set[str],
) -> int:
    """Merge a refused batch into its recorded base with only its class suppressed.

    Replays the four rules the recorded base can answer — namespace prefix,
    `introduced_in` lineage, `resolved_in` currency, and `ALLOWED_TRANSITIONS`
    — skipping only the declared class's own rule.

    The immutable-field check is **not** replayed and cannot be: `ledger_before`
    records `{id: state}`, not the prior `authority`/`required_outcome`/
    `introduced_in` it would compare against. Nothing recorded is wrong for
    want of it — for `immutable-field-restated` it is the suppressed rule, and
    for the other two classes its absence from the recorded refusal codes
    proves it never fired — but the replay is those four rules, not "every rule
    the ingest would have applied".

    The returned count reproduces the expression `ingest-findings` evaluates
    over the whole merged ledger, so the pre-existing actionable entries that
    survive the merge are counted exactly as they are on the accepted path.
    """
    prefix = f"{row['kind'].upper()}-"
    states = dict(row["ledger_before"])
    errors: list[str] = []
    for item in findings:
        identifier = item["id"]
        if not identifier.startswith(prefix):
            errors.append(f"{identifier} field id must use the {prefix}FNNN namespace")
        prior = states.get(identifier)
        if prior is None and item["introduced_in"] not in lineage:
            errors.append(
                f"{identifier} field introduced_in {item['introduced_in'][:12]}… "
                "is not a candidate this run recorded"
            )
        if (
            item["resolved_in"] is not None
            and item["resolved_in"] != row["candidate_id"]
            and refusal_class != "resolved-in-not-current-candidate"
        ):
            errors.append(f"{identifier} field resolved_in does not match the reviewed candidate")
        if prior is not None and item["state"] not in ALLOWED_TRANSITIONS[prior]:
            errors.append(
                f"{identifier} field state has invalid transition: {prior} -> {item['state']}"
            )
        states[identifier] = item["state"]
    if errors:
        raise EvidenceError(
            "the refused batch fails rules the declared class does not cover:\n- "
            + "\n- ".join(errors)
        )
    return sum(
        identifier.startswith(prefix) and state in ACTIONABLE_STATES
        for identifier, state in states.items()
    )


def verify_batch_identity(
    *,
    refused: tuple[Any, list[dict[str, Any]]],
    corroborating: tuple[Any, list[dict[str, Any]]],
    refusal_class: str,
) -> None:
    """Two artifacts are the same review pass, differing only where declared."""
    refused_verdict, refused_findings = refused
    other_verdict, other_findings = corroborating
    if refused_verdict != other_verdict:
        raise EvidenceError("corroborating artifact records a different batch verdict")
    if len(refused_findings) != len(other_findings):
        raise EvidenceError(
            "corroborating artifact reports a different number of findings: "
            f"{len(other_findings)} against {len(refused_findings)}"
        )
    by_id = {item["id"]: item for item in other_findings}
    if set(by_id) != {item["id"] for item in refused_findings}:
        raise EvidenceError("corroborating artifact reports a different finding set")
    permitted = DERIVED_CLASS_DELTAS[refusal_class]
    compared = (
        *DERIVED_IDENTITY_FIELDS,
        *sorted(permitted - set(DERIVED_IDENTITY_FIELDS)),
    )
    observed_deltas: set[str] = set()
    for item in refused_findings:
        other = by_id[item["id"]]
        for field in compared:
            if item[field] == other[field]:
                continue
            if field not in permitted:
                raise EvidenceError(
                    f"corroborating artifact differs from the refused artifact in "
                    f"{item['id']} field {field}, which the declared refusal class "
                    "does not permit"
                )
            observed_deltas.add(field)
    if permitted and not observed_deltas:
        raise EvidenceError(
            f"corroborating artifact shows no {refusal_class} delta, so the "
            "declared refusal class describes nothing the two artifacts disagree on"
        )


def load_derived_metrics(run_dir: Path) -> dict[tuple[str, int], dict[str, Any]]:
    """Derived convergence records, keyed by the review pass that owns each one."""
    records: dict[tuple[str, int], dict[str, Any]] = {}
    path = run_dir / "derived-metrics.jsonl"
    if not path.exists():
        return records
    for entry in load_jsonl(path):
        if (
            set(entry) != DERIVED_METRIC_FIELDS
            or entry.get("schema_version") != SCHEMA_VERSION
            or entry.get("operation") not in REVIEW_OPERATIONS
            or not isinstance(entry.get("attempt"), int)
            or isinstance(entry["attempt"], bool)
            or entry["attempt"] < 1
            or entry.get("refusal_class") not in DERIVED_REFUSAL_CLASSES
            or not isinstance(entry.get("id_map"), dict)
            or any(
                not isinstance(key, str) or not isinstance(value, str)
                for key, value in entry["id_map"].items()
            )
            or not isinstance(entry.get("cause"), str)
            or not entry["cause"].strip()
            or not isinstance(entry.get("journal_recorded_at"), str)
            or not entry["journal_recorded_at"].strip()
            or any(
                not isinstance(entry.get(key), int)
                or isinstance(entry.get(key), bool)
                or entry[key] < 0
                for key in ("findings_reported", "actionable_findings")
            )
        ):
            raise EvidenceError("invalid derived-metrics record")
        validate_span_identifier(entry["span_id"], "derived-metrics span id")
        validate_candidate_id(
            entry["refused_artifact_sha256"], "derived-metrics refused artifact hash"
        )
        if entry["corroborating_artifact_sha256"] is not None:
            validate_candidate_id(
                entry["corroborating_artifact_sha256"],
                "derived-metrics corroborating artifact hash",
            )
        if (entry["refusal_class"] == "finding-id-format") != bool(entry["id_map"]):
            raise EvidenceError(
                "derived-metrics id_map is required exactly for the finding-id-format refusal class"
            )
        key = (entry["operation"], entry["attempt"])
        if key in records:
            raise EvidenceError("duplicate derived-metrics record")
        records[key] = entry
    return records


def derived_artifact_path(run_dir: Path, digest: str) -> Path:
    return run_dir / "derived-artifacts" / f"{digest}.json"


def stored_artifact(run_dir: Path, digest: str, *, label: str) -> Path:
    path = derived_artifact_path(run_dir, digest)
    if not path.is_file() or source_digest(path) != digest:
        raise EvidenceError(f"derived-metrics {label} artifact is absent or altered: {digest}")
    return path


def pinned_refused_ingest(record: dict[str, Any], journal: list[dict[str, Any]]) -> dict[str, Any]:
    """The one journal row this record was derived from, still resolving uniquely.

    The pin is the row's `recorded_at` on top of the ordinary class match, so
    the resolution stays deterministic even though the journal keeps growing:
    repeated ingests of one artifact are the normal shape, and "the latest
    match" would otherwise move under a record that has already been written.
    """
    candidates = [
        row
        for row in matching_refused_ingests(
            journal,
            kind=REVIEW_OPERATIONS[record["operation"]],
            artifact_sha256=record["refused_artifact_sha256"],
            refusal_class=record["refusal_class"],
            review_span_id=record["span_id"],
        )
        if row["recorded_at"] == record["journal_recorded_at"]
    ]
    if len(candidates) != 1:
        raise EvidenceError(
            "derived-metrics record names no unique refused ingest: "
            f"{record['operation']} attempt {record['attempt']}"
        )
    return candidates[0]


def require_stored_artifacts(record: dict[str, Any], run_dir: Path) -> tuple[Path, Path | None]:
    """Both recorded artifacts, still present in the run at their recorded digests."""
    refused = stored_artifact(run_dir, record["refused_artifact_sha256"], label="refused")
    corroborating = (
        stored_artifact(run_dir, record["corroborating_artifact_sha256"], label="corroborating")
        if record["corroborating_artifact_sha256"] is not None
        else None
    )
    return refused, corroborating


def recompute_derived_metrics(record: dict[str, Any], run_dir: Path) -> tuple[int, int]:
    """Re-derive both integers from the artifacts and the journal on disk.

    This is the whole reason the record is a measurement rather than an
    assertion. It is the analogue of the telemetry declaration's "every excused
    field must really be defective": without it the ledger would have no reader
    that could ever contradict it.
    """
    kind = REVIEW_OPERATIONS[record["operation"]]
    journal = load_ingest_journal(run_dir)
    row = pinned_refused_ingest(record, journal)
    # A cross-ledger consistency check, not a duplicate of the span test above:
    # an accepted ingest that named this span must have measured it, so a
    # journal claiming otherwise while the span reads unmeasured means one of
    # the two ledgers has been altered. Supersession is the case where the two
    # legitimately disagree, and it never reaches here.
    if any(
        entry["outcome"] == "accepted" and entry["review_span_id"] == record["span_id"]
        for entry in journal
    ):
        raise EvidenceError("derived-metrics record names a span whose ingest did land")
    refused_path, corroborating_path = require_stored_artifacts(record, run_dir)
    prefix = f"{kind.upper()}-"
    if record["refusal_class"] == "finding-id-format":
        validate_id_bijection(
            record["id_map"],
            raw_identifiers=raw_finding_identifiers(refused_path, label="refused artifact"),
            prefix=prefix,
        )
    refused_batch = read_review_batch(
        refused_path,
        label="refused artifact",
        id_map=record["id_map"] or None,
    )
    lineage = set(lineage_candidates(run_dir)) | {row["candidate_id"]}
    actionable = replay_refused_batch(
        findings=refused_batch[1],
        row=row,
        refusal_class=record["refusal_class"],
        lineage=lineage,
    )
    if corroborating_path is not None:
        verify_batch_identity(
            refused=refused_batch,
            corroborating=read_review_batch(corroborating_path, label="corroborating artifact"),
            refusal_class=record["refusal_class"],
        )
    return len(refused_batch[1]), actionable


def span_metric_count(span: dict[str, Any]) -> int:
    """How many of the two convergence integers this span actually carries."""
    return sum(
        isinstance(span.get(key), int) and not isinstance(span.get(key), bool)
        for key in REVIEW_METRIC_KEYS
    )


def require_derivable_span(span: dict[str, Any], operation: str) -> None:
    """The span a derivation may stand in for: right shape, successful, unmeasured."""
    expected_role = {"role.plan-review": "reviewer", "role.code-review": "critic"}[operation]
    if (
        span.get("category") != "intelligence"
        or span.get("operation") != operation
        or span.get("role") != expected_role
        or span.get("outcome") != "success"
    ):
        raise EvidenceError("derived review metrics require a successful review intelligence span")
    if span_metric_count(span) > 0:
        raise EvidenceError(
            "the review span already carries convergence metrics; an ingest "
            "measured this pass, so there is nothing to derive"
        )


def verify_derived_record(
    record: dict[str, Any], span: dict[str, Any], run_dir: Path
) -> dict[str, Any]:
    """Admit one derived record only if the trace and the disk still agree."""
    if record["span_id"] != span["span_id"]:
        raise EvidenceError(
            "derived-metrics record names a span the dispatch does not: "
            f"declared {record['span_id']}, dispatched {span['span_id']}"
        )
    require_derivable_span(span, record["operation"])
    reported, actionable = recompute_derived_metrics(record, run_dir)
    if (reported, actionable) != (
        record["findings_reported"],
        record["actionable_findings"],
    ):
        raise EvidenceError(
            "derived review metrics do not recompute: recorded "
            f"{record['findings_reported']}/{record['actionable_findings']}, "
            f"recomputed {reported}/{actionable}"
        )
    return {
        "operation": record["operation"],
        "attempt": record["attempt"],
        "span_id": record["span_id"],
        "refusal_class": record["refusal_class"],
        "findings_reported": reported,
        "actionable_findings": actionable,
        "corroborated": record["corroborating_artifact_sha256"] is not None,
        "superseded": False,
        "cause": record["cause"],
    }


def supersede_derived_record(
    record: dict[str, Any], span: dict[str, Any], run_dir: Path
) -> dict[str, Any]:
    """Report a derivation whose span later acquired the real measurement.

    Deriving and then honestly re-ingesting the same pass is the *better*
    outcome, not a defect — but the record would otherwise become an orphan and
    refuse the run forever, so the operator who did the more honest thing would
    be the one blocked.

    The integers are not recomputed, and that is not a shortcut: supersession
    entails both `span_metric_count(span) == 2` and an accepted journal row
    naming the span, so the full path would raise twice over reasons that have
    stopped mattering, reinstating the very deadlock this branch removes. The
    span's own measurement is what is reported; the record's two integers are
    read by nothing.

    What is *not* inert is what this entry still publishes. `refusal_class`,
    `cause`, and the corroboration flag go on being printed in both
    `timing-summary` formats, and after supersession nothing else in the run
    references `derived-artifacts/` — so it is exactly what a cleanup removes
    first, silently, while the entry keeps appearing. So the floor is the middle
    one: the pinned journal row must still resolve uniquely and both recorded
    artifacts must still be on disk at their recorded digests. Whenever a
    record's verification is relaxed, the question is what is still being
    published on the strength of it.
    """
    if record["span_id"] != span["span_id"]:
        raise EvidenceError(
            "derived-metrics record names a span the dispatch does not: "
            f"declared {record['span_id']}, dispatched {span['span_id']}"
        )
    pinned_refused_ingest(record, load_ingest_journal(run_dir))
    require_stored_artifacts(record, run_dir)
    return {
        "operation": record["operation"],
        "attempt": record["attempt"],
        "span_id": record["span_id"],
        "refusal_class": record["refusal_class"],
        "findings_reported": span["findings_reported"],
        "actionable_findings": span["actionable_findings"],
        "corroborated": record["corroborating_artifact_sha256"] is not None,
        "superseded": True,
        "cause": record["cause"],
    }


def review_metric_status(
    spans: list[dict[str, Any]], run_dir: Path
) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:
    """Split accepted review passes into the unmeasured and the derived."""
    by_id = {item["span_id"]: item for item in spans}
    derived = load_derived_metrics(run_dir)
    unmeasured: list[dict[str, Any]] = []
    projected: list[dict[str, Any]] = []
    consumed: set[tuple[str, int]] = set()
    for dispatch in load_role_dispatches(run_dir):
        if not dispatch.get("accepted") or dispatch.get("operation") not in REVIEW_OPERATIONS:
            continue
        span = by_id.get(dispatch.get("intelligence_span_id"))
        if span is None:
            raise EvidenceError("accepted review dispatch span is absent from trace")
        if span.get("outcome") != "success":
            # A dispatch that was accepted and then failed is not a review
            # *pass*. It produced no artifact, so there are no findings to
            # ingest and no convergence integers that could ever exist —
            # demanding them would make a venue failure permanently unclosable
            # rather than merely recorded. The failed attempt keeps its own
            # truthful outcome and exit code in the trace.
            continue
        key = (dispatch["operation"], dispatch["attempt"])
        record = derived.get(key)
        if span_metric_count(span) == len(REVIEW_METRIC_KEYS):
            # Measured natively. A derivation for this pass is not an orphan —
            # it is a record the operator superseded by re-ingesting honestly.
            if record is not None:
                projected.append(supersede_derived_record(record, span, run_dir))
                consumed.add(key)
            continue
        if record is None:
            unmeasured.append(
                {
                    "operation": dispatch["operation"],
                    "attempt": dispatch["attempt"],
                    "span_id": span["span_id"],
                }
            )
            continue
        projected.append(verify_derived_record(record, span, run_dir))
        consumed.add(key)
    orphans = sorted(set(derived) - consumed)
    if orphans:
        named = ", ".join(f"{operation}#{attempt}" for operation, attempt in orphans)
        raise EvidenceError(
            f"derived-metrics records name attempts that are not unmeasured review passes: {named}"
        )
    return (
        sorted(unmeasured, key=lambda item: (item["operation"], item["attempt"])),
        sorted(projected, key=lambda item: (item["operation"], item["attempt"])),
    )


def unmeasured_review_passes(run_dir: Path, run: dict[str, Any]) -> list[dict[str, Any]]:
    """Successful review passes with no metrics anywhere, on an **open** trace.

    Runtime spans, not the finalized bundle: the repair for an unmeasured pass
    is a re-ingest, and a re-ingest is possible only while the trace is still
    open. Checking this at `timing-summary` alone discovered the gap after
    finalization, when nothing could be repaired.
    """
    try:
        spans = closed_spans(
            engine_root=Path(run["repository_root"]),
            trace_id=run["telemetry_trace_id"],
        )
    except TelemetryError as exc:
        raise EvidenceError(f"cannot read review convergence metrics: {exc}") from exc
    return review_metric_status(spans, run_dir)[0]


def validate_review_metrics(bundle: dict[str, Any], run_dir: Path) -> list[dict[str, Any]]:
    unmeasured, derived = review_metric_status(bundle["spans"], run_dir)
    if unmeasured:
        item = unmeasured[0]
        raise EvidenceError(
            f"review pass lacks convergence metrics: {item['operation']} "
            f"attempt {item['attempt']} (span {item['span_id']}). While the trace "
            "is open, re-ingest that pass with --review-span-id; once it is "
            "finalized the span is immutable and the only sanctioned route is "
            "`attach-derived-metrics`, which requires a recorded ingest refusal."
        )
    return derived


def parse_id_map(specifications: list[str]) -> dict[str, str]:
    mapping: dict[str, str] = {}
    for specification in specifications:
        source, separator, target = specification.partition("=")
        if not separator or not source.strip() or not target.strip():
            raise EvidenceError(f"--id-map must be SOURCE=TARGET, got {specification!r}")
        if source.strip() in mapping:
            raise EvidenceError(f"--id-map names {source.strip()} twice")
        mapping[source.strip()] = target.strip()
    return mapping


def command_attach_derived_metrics(arguments: argparse.Namespace) -> None:
    """Derive one review pass's convergence integers from artifacts on disk.

    For the residue the pre-finalization latch cannot reach: a review pass that
    genuinely succeeded and whose batch was structurally refused, discovered
    after the trace closed. The record is an **overlay**, never a span attach —
    a span is immutable once finalized, and laundering a derived number onto a
    span whose ingest never produced it would erase the distinction this record
    exists to keep. Both integers are computed here and recomputed by
    `validate`; neither is ever an operator input.

    Every check the reader applies is applied here as well, because the
    reader's refusal has no undo: `derived-metrics.jsonl` is append-only, so a
    record written with a wrong `--attempt` would pass at write time and then
    refuse every later `validate` and `timing-summary` permanently, with
    hand-editing an append-only ledger as the only way out.
    """
    run = validate_run_dir(arguments.run_dir)
    if run.get("evidence_lane") == "light":
        raise EvidenceError(
            "derived review metrics belong to the full evidence lane; light-lane "
            "reviews record their omission in review-metrics-omitted.jsonl"
        )
    validate_span_identifier(arguments.span_id, "span id")
    if not arguments.cause.strip():
        raise EvidenceError("a derived-metrics record requires its cause")
    if arguments.attempt < 1:
        raise EvidenceError("attempt must be a positive integer")
    id_map = parse_id_map(arguments.id_map)
    if arguments.refusal_class == "finding-id-format" and not id_map:
        raise EvidenceError(
            "--id-map is required for refusal class finding-id-format: the "
            "derivation has to state which valid id each malformed one stands for"
        )
    if arguments.refusal_class != "finding-id-format" and id_map:
        raise EvidenceError("--id-map applies only to refusal class finding-id-format")
    kind = REVIEW_OPERATIONS[arguments.operation]
    dispatches = [
        item
        for item in load_role_dispatches(arguments.run_dir)
        if item.get("operation") == arguments.operation and item.get("attempt") == arguments.attempt
    ]
    if len(dispatches) != 1 or not dispatches[0].get("accepted"):
        raise EvidenceError(
            "no accepted review dispatch is recorded for "
            f"{arguments.operation} attempt {arguments.attempt}; a derivation "
            "stands in for a pass this run actually dispatched"
        )
    if dispatches[0].get("intelligence_span_id") != arguments.span_id:
        raise EvidenceError(
            f"the dispatch for {arguments.operation} attempt {arguments.attempt} "
            f"names intelligence span {dispatches[0].get('intelligence_span_id')}, "
            f"not the declared {arguments.span_id}"
        )
    try:
        dispatched_span = closed_span(
            engine_root=Path(run["repository_root"]),
            trace_id=run["telemetry_trace_id"],
            span_id=arguments.span_id,
        )
    except TelemetryError as exc:
        raise EvidenceError(f"review span is unreadable: {exc}") from exc
    require_derivable_span(dispatched_span, arguments.operation)
    for label, path in (
        ("refused", arguments.refused_artifact),
        ("corroborating", arguments.corroborating_artifact),
    ):
        if path is not None and not path.is_file():
            raise EvidenceError(f"{label} artifact does not exist: {path}")
    refused_digest = source_digest(arguments.refused_artifact)
    corroborating_digest = (
        source_digest(arguments.corroborating_artifact)
        if arguments.corroborating_artifact is not None
        else None
    )
    if corroborating_digest == refused_digest:
        raise EvidenceError(
            "a corroborating artifact must be a different artifact from the refused one"
        )
    journal = load_ingest_journal(arguments.run_dir)
    rows = matching_refused_ingests(
        journal,
        kind=kind,
        artifact_sha256=refused_digest,
        refusal_class=arguments.refusal_class,
        review_span_id=arguments.span_id,
    )
    if not rows:
        attempted = [
            entry
            for entry in journal
            if entry["outcome"] == "refused"
            and entry["kind"] == kind
            and entry["artifact_sha256"] == refused_digest
        ]
        if not attempted:
            raise EvidenceError(
                "no refused ingest of this artifact is recorded: a derivation "
                "stands on an ingest that was attempted and structurally refused, "
                "not on one that was never run"
            )
        for_span = [entry for entry in attempted if entry["review_span_id"] == arguments.span_id]
        if not for_span:
            raise EvidenceError(
                "the recorded refusal of this artifact names a different review "
                "span, so it is evidence about some other pass"
            )
        observed = sorted({code for entry in for_span for code in entry["refusal_codes"]})
        raise EvidenceError(
            "the recorded refusal does not match the declared class "
            f"{arguments.refusal_class}: expected exactly "
            f"{', '.join(DERIVED_REFUSAL_CLASSES[arguments.refusal_class])}, "
            f"observed {', '.join(observed)}. A batch that also carried a "
            "substance defect was never a measurable review pass."
        )
    # Repeated attempts are the normal case, so the journal has no duplicate-key
    # refusal; the most recent attempt is the one whose recorded base is closest
    # to the ledger the pass actually met.
    row = rows[-1]
    if any(
        entry["outcome"] == "accepted" and entry["review_span_id"] == arguments.span_id
        for entry in journal
    ):
        raise EvidenceError(
            "an accepted ingest already attached metrics to this span; there is nothing to derive"
        )
    derived = load_derived_metrics(arguments.run_dir)
    if (arguments.operation, arguments.attempt) in derived:
        raise EvidenceError("duplicate derived-metrics record")
    if corroborating_digest is not None:
        if any(
            record["corroborating_artifact_sha256"] == corroborating_digest
            for record in derived.values()
        ):
            raise EvidenceError(
                "this corroborating artifact already supports another derivation: "
                "one measured pass corroborates one derived pass, never a fan-out"
            )
        if not any(
            entry["outcome"] == "accepted"
            and entry["artifact_sha256"] == corroborating_digest
            and entry["review_span_id"] is not None
            for entry in journal
        ):
            raise EvidenceError(
                "a corroborating artifact must itself have been ingested with "
                "convergence metrics attached to its own review span; a source "
                "that was only ever derived cannot corroborate anything"
            )
    store = arguments.run_dir / "derived-artifacts"
    store.mkdir(parents=True, exist_ok=True)
    shutil.copy2(
        arguments.refused_artifact,
        derived_artifact_path(arguments.run_dir, refused_digest),
    )
    if corroborating_digest is not None:
        shutil.copy2(
            arguments.corroborating_artifact,
            derived_artifact_path(arguments.run_dir, corroborating_digest),
        )
    record = {
        "schema_version": SCHEMA_VERSION,
        "recorded_at": now(),
        "operation": arguments.operation,
        "attempt": arguments.attempt,
        "span_id": arguments.span_id,
        "refusal_class": arguments.refusal_class,
        "refused_artifact_sha256": refused_digest,
        "corroborating_artifact_sha256": corroborating_digest,
        "id_map": id_map,
        "findings_reported": 0,
        "actionable_findings": 0,
        "journal_recorded_at": row["recorded_at"],
        "cause": arguments.cause.strip(),
    }
    reported, actionable = recompute_derived_metrics(record, arguments.run_dir)
    record["findings_reported"] = reported
    record["actionable_findings"] = actionable
    append_jsonl(arguments.run_dir / "derived-metrics.jsonl", record)
    print(
        f"derived {arguments.operation}#{arguments.attempt}: "
        f"findings_reported={reported}, actionable_findings={actionable}"
    )


def validate_preacceptance_topology(
    run: dict[str, Any], run_dir: Path, root: Path
) -> list[dict[str, Any]]:
    """Refuse malformed stage composition while the run is still repairable."""
    try:
        spans = closed_spans(
            engine_root=root,
            trace_id=run["telemetry_trace_id"],
        )
    except TelemetryError as exc:
        raise EvidenceError(f"cannot validate pre-close telemetry: {exc}") from exc
    stage_spans = [span for span in spans if span["operation"].startswith("orchestration.")]
    for span in stage_spans:
        if (
            span["operation"] not in ORCHESTRATION_OPERATIONS
            or span["category"] != "reconciliation"
            or span["parent_span_id"] != run["telemetry_root_span_id"]
        ):
            raise EvidenceError("pre-close orchestration stage is invalid")
    required_before_acceptance = set(run["required_orchestration_operations"]) - {
        "orchestration.acceptance",
        "orchestration.close",
    }
    missing = [
        operation
        for operation in sorted(required_before_acceptance)
        if not any(
            span["operation"] == operation and span["outcome"] == "success" for span in stage_spans
        )
    ]
    if missing and run.get("evidence_lane") != "light":
        raise EvidenceError(
            "missing successful pre-acceptance orchestration stages: " + ", ".join(missing)
        )
    ordered = sorted(stage_spans, key=lambda item: (item["start_offset_ns"], item["span_id"]))
    if (
        not ordered
        or ordered[0]["span_id"] != run["initial_orchestration_span_id"]
        or ordered[0]["operation"] != "orchestration.setup"
    ):
        raise EvidenceError("pre-close orchestration does not begin with setup")
    for previous, current in zip(ordered, ordered[1:]):
        if current["start_offset_ns"] < previous["end_offset_ns"]:
            raise EvidenceError("orchestration stage spans must not overlap")
    return spans


def validate_preclose_telemetry(run: dict[str, Any], run_dir: Path, root: Path) -> None:
    spans = validate_preacceptance_topology(run, run_dir, root)
    # Light-lane review metrics ride the omission ledger instead of the span
    # (`review-metrics-omitted.jsonl`); the join requirement is full-lane only.
    if run.get("evidence_lane") != "light":
        validate_review_metrics({"spans": spans}, run_dir)


def validate_gate_record(
    gate: dict[str, Any],
    run: dict[str, Any],
    root: Path,
    *,
    label: str = "gate record",
) -> None:
    required = {
        "schema_version",
        "recorded_at",
        "candidate_id",
        "candidate_after_id",
        "product_candidate_id",
        "product_candidate_after_id",
        "command_manifest_sha256",
        "argv",
        "command",
        "operation",
        "attempt",
        "selection_reason",
        "exit_code",
        "outcome",
        "warning_count",
        "artifact_sha256",
        "final",
        "telemetry_trace_id",
        "telemetry_span_id",
        "duration_ns",
        "telemetry_complete",
    }
    if set(gate) != required or gate.get("schema_version") != SCHEMA_VERSION:
        raise EvidenceError(f"invalid {label} schema")
    validate_candidate_id(gate.get("candidate_id"), "gate candidate")
    validate_candidate_id(gate.get("candidate_after_id"), "gate candidate after")
    validate_candidate_id(gate.get("product_candidate_id"), "gate product candidate")
    validate_candidate_id(gate.get("product_candidate_after_id"), "gate product candidate after")
    manifest_digest = gate.get("command_manifest_sha256")
    if manifest_digest is not None:
        try:
            kickoff_runbook.validate_digest(manifest_digest, "gate manifest digest")
        except kickoff_runbook.RunbookError as exc:
            raise EvidenceError(str(exc)) from exc
    argv = validate_string_list(gate.get("argv"), "gate argv")
    if gate.get("command") != shlex.join(argv):
        legacy_detail = (
            " This is the legacy record-gate encoding that stored a whole "
            "multi-word command as one argv element."
            if len(argv) == 1 and argv[0] == gate.get("command") and " " in argv[0]
            else ""
        )
        raise EvidenceError(
            f"{label} has non-canonical argv: command={gate.get('command')!r}, "
            f"argv={argv!r}, canonical={shlex.join(argv)!r}.{legacy_detail}"
        )
    if not isinstance(gate.get("attempt"), int) or gate["attempt"] < 1:
        raise EvidenceError("invalid gate attempt")
    if gate["telemetry_trace_id"] != run["telemetry_trace_id"]:
        raise EvidenceError("gate belongs to a foreign trace")
    if gate["telemetry_complete"]:
        if not isinstance(gate.get("duration_ns"), int) or gate["duration_ns"] < 0:
            raise EvidenceError("complete gate lacks duration")
        try:
            span = closed_span(
                engine_root=root,
                trace_id=run["telemetry_trace_id"],
                span_id=gate["telemetry_span_id"],
            )
        except TelemetryError as exc:
            raise EvidenceError(f"gate span is invalid: {exc}") from exc
        expected = {
            "parent_span_id": run["telemetry_root_span_id"],
            "category": "gate",
            "operation": gate["operation"],
            "attempt": gate["attempt"],
            "outcome": gate["outcome"],
            "exit_code": gate["exit_code"],
            "duration_ns": gate["duration_ns"],
        }
        if any(span.get(key) != value for key, value in expected.items()):
            raise EvidenceError("gate evidence and telemetry span do not agree")
    elif gate["telemetry_span_id"] is not None or gate["duration_ns"] is not None:
        raise EvidenceError("incomplete gate cannot claim span or duration")


def validate_gate_span_join(gates: list[dict[str, Any]], run: dict[str, Any], root: Path) -> None:
    evidence_ids = [gate["telemetry_span_id"] for gate in gates if gate["telemetry_complete"]]
    if len(evidence_ids) != len(set(evidence_ids)):
        raise EvidenceError("multiple gate evidence rows reference one span")
    try:
        spans = closed_spans(engine_root=root, trace_id=run["telemetry_trace_id"])
    except TelemetryError as exc:
        raise EvidenceError(f"invalid runtime trace: {exc}") from exc
    # Only gates the orchestrator ran are evidence-bearing. A gate span nested
    # under another gate is the observed command's own instrumentation —
    # `bin/check` opens one per named sub-gate beneath its enclosing acceptance
    # span, by the `AGENTIC_STARTER_EXECUTION_*` contract in
    # `policies/execution-telemetry.md`. Those children have no `run-gate` row
    # by design, so demanding one made a complete acceptance close (159 spans
    # for 11 gates) fail as if 148 spans were unregistered.
    observed_ids = {
        span["span_id"]
        for span in spans
        if span["category"] == "gate"
        and span.get("parent_span_id") == run["telemetry_root_span_id"]
    }
    if set(evidence_ids) != observed_ids:
        missing = sorted(observed_ids - set(evidence_ids))
        foreign = sorted(set(evidence_ids) - observed_ids)
        detail = []
        if missing:
            detail.append("unregistered=" + ",".join(missing))
        if foreign:
            detail.append("unmatched=" + ",".join(foreign))
        raise EvidenceError(
            "gate evidence and closed gate spans do not agree"
            + (": " + "; ".join(detail) if detail else "")
        )


def timing_projection(bundle: dict[str, Any]) -> dict[str, Any]:
    root = next(item for item in bundle["spans"] if item["parent_span_id"] is None)
    children = [item for item in bundle["spans"] if item["parent_span_id"] is not None]

    def union(category: str | None = None, predicate: Any = None) -> int:
        intervals = [
            (item["start_offset_ns"], item["end_offset_ns"])
            for item in children
            if (category is None or item["category"] == category)
            and (predicate is None or predicate(item))
        ]
        total = 0
        end = -1
        for start, stop in sorted(intervals):
            if stop <= end:
                continue
            total += stop - max(start, end)
            end = stop
        return total

    covered = union()
    return {
        "trace_id": bundle["trace_id"],
        "outcome": root["outcome"],
        "makespan_ns": root["duration_ns"],
        "intelligence_ns": union("intelligence"),
        "gate_ns": union("gate"),
        "reconciliation_ns": union("reconciliation"),
        "wait_ns": union("wait"),
        "retry_ns": union(predicate=lambda item: item["attempt"] > 1),
        "failed_ns": union(predicate=lambda item: item["outcome"] != "success"),
        "unattributed_ns": max(0, root["duration_ns"] - covered),
        "slowest_spans": [
            {
                "category": item["category"],
                "operation": item["operation"],
                "attempt": item["attempt"],
                "duration_ns": item["duration_ns"],
                "outcome": item["outcome"],
            }
            for item in sorted(
                children, key=lambda value: (-value["duration_ns"], value["span_id"])
            )[:5]
        ],
        "overlap_note": "Category totals are interval unions and may overlap.",
    }


def command_timing_summary(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    try:
        bundle = finalized_trace(
            engine_root=Path(run["repository_root"]), trace_id=run["telemetry_trace_id"]
        )
    except TelemetryError as exc:
        raise EvidenceError(f"trace is not durably finalized: {exc}") from exc
    degraded = validate_role_spans(arguments.run_dir, run)
    validate_orchestration_spans(bundle, run)
    derived_metrics: list[dict[str, Any]] = []
    if run.get("evidence_lane") != "light":
        derived_metrics = validate_review_metrics(bundle, arguments.run_dir)
    gates = load_jsonl(arguments.run_dir / "gates.jsonl")
    for line_number, gate in enumerate(gates, 1):
        validate_gate_record(
            gate,
            run,
            Path(run["repository_root"]),
            label=f"gates.jsonl line {line_number}",
        )
    validate_gate_span_join(gates, run, Path(run["repository_root"]))
    projection = timing_projection(bundle)
    # Carried in the projection rather than only printed: a consumer that reads
    # the JSON must be able to see that an attempt's measurement is partial.
    projection["telemetry_incomplete"] = degraded
    # Same reason as telemetry_incomplete: a consumer reading the JSON must be
    # able to see that a pass's integers were recomputed rather than measured.
    projection["derived_review_metrics"] = derived_metrics
    # And that a review pass was admitted against a tree the ingest did not
    # hold. A run that accepted drift says so where anyone reading its close
    # will see it.
    projection["candidate_drift"] = validate_candidate_drift(arguments.run_dir, run)
    if arguments.format == "json":
        print(json.dumps(projection, sort_keys=True, separators=(",", ":")))
        return
    labels = (
        ("Makespan", "makespan_ns"),
        ("Intelligence", "intelligence_ns"),
        ("Gates", "gate_ns"),
        ("Orchestration", "reconciliation_ns"),
        ("Wait", "wait_ns"),
        ("Retry/rework", "retry_ns"),
        ("Failed work", "failed_ns"),
        ("Unattributed", "unattributed_ns"),
    )
    print("### Execution timing")
    print()
    print(f"- Trace: `{projection['trace_id']}`")
    print(f"- Outcome: `{projection['outcome']}`")
    for label, key in labels:
        value = projection[key]
        print(f"- {label}: {value} ns ({value / 1_000_000_000:.9f} s)")
    print(f"- {projection['overlap_note']}")
    print()
    print("#### Slowest material spans")
    print()
    if not projection["slowest_spans"]:
        print("- None.")
    for span in projection["slowest_spans"]:
        duration = span["duration_ns"]
        print(
            f"- `{span['operation']}` — category `{span['category']}`, "
            f"attempt {span['attempt']}, outcome `{span['outcome']}`: "
            f"{duration} ns ({duration / 1_000_000_000:.9f} s)"
        )
    if degraded:
        print()
        print("#### Telemetry-incomplete role attempts")
        print()
        for item in degraded:
            fields = ", ".join(f"`{field}`" for field in item["missing_fields"])
            print(
                f"- `{item['operation']}` attempt {item['attempt']} — wait span "
                f"`{item['span_id']}` is missing {fields}. {item['cause']}"
            )
        print()
        print(
            "These attempts are measured, not omitted: their intelligence spans "
            "and durations are exact, and only the named wait-span metadata is "
            "absent. The defect is recorded rather than repaired because a "
            "closed span is immutable."
        )
    if derived_metrics:
        print()
        print("#### Derived review convergence metrics")
        print()
        for item in derived_metrics:
            corroboration = (
                "corroborated by a natively measured re-ingest"
                if item["corroborated"]
                else "uncorroborated"
            )
            standing = (
                "superseded by a later ingest that measured the span natively"
                if item["superseded"]
                else corroboration
            )
            print(
                f"- `{item['operation']}` attempt {item['attempt']} — review span "
                f"`{item['span_id']}`, refusal class `{item['refusal_class']}`, "
                f"{standing}: findings_reported {item['findings_reported']}, "
                f"actionable_findings {item['actionable_findings']}. "
                f"{item['cause']}"
            )
        print()
        print(
            "These integers were recomputed from the refused artifact and the "
            "ingest journal's recorded pre-merge ledger, not produced by an "
            "ingest. They are an overlay on a span whose ingest was structurally "
            "refused; the span itself carries no metrics, and validation "
            "re-derives every value above rather than trusting the record."
        )
        if any(item["superseded"] for item in derived_metrics):
            print()
            print(
                "An entry marked superseded is the exception: its pass was later "
                "re-ingested honestly, so the integers shown are the span's own "
                "measurement and the derivation is retained only for the trail."
            )
    if projection["candidate_drift"]:
        print()
        print("#### Accepted candidate drift")
        print()
        for item in projection["candidate_drift"]:
            print(
                f"- `{item['operation']}` attempt {item['attempt']} — the tree "
                f"moved from `{item['dispatch_candidate_id'][:12]}…` to "
                f"`{item['return_candidate_id'][:12]}…` under the dispatch: "
                + ", ".join(f"`{path}`" for path in item["drifted_paths"])
                + f". {item['cause']}"
            )
        print()
        print(
            "Each drift above was proven disjoint from the review it ran under: "
            "every path lies in the inert partition declared in "
            "policies/orchestration-evidence.md, none appears in the reviewed "
            "change surface or any finding's affected paths, and none is a "
            "declared authority. Validation re-derives the path set from the "
            "stored candidate manifests and re-runs all three checks rather than "
            "trusting the record. The relaxation is `resolved_in` only; the "
            "candidate-bound final gate is untouched."
        )


def source_digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def command_packet(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    authority = load_json(arguments.run_dir / "authority.json")
    findings = load_json(arguments.run_dir / "findings.json")
    gates_path = arguments.run_dir / "gates.jsonl"
    gates = [json.loads(line) for line in gates_path.read_text().splitlines() if line.strip()]
    unresolved = [item for item in findings["findings"] if item["state"] in UNRESOLVED_STATES]
    if arguments.kind == "plan":
        plan_change = load_json(arguments.run_dir / "plan-change.json")
        candidate_id = plan_change["candidate_id"]
        lines = [
            f"# Plan Revision Packet — {run['phase']}",
            "",
            "## Plan snapshot",
            "",
            f"- Candidate: `{candidate_id}`",
            f"- Reviewed plan: `{plan_change['reviewed_plan_sha256']}`",
            f"- Current plan: `{plan_change['plan_sha256']}`",
            f"- Rebase required: `{'yes' if plan_change['rebase_required'] else 'no'}`",
            "",
            "## Authority",
            "",
        ]
        authority_change = plan_change["authority_drift"]
        causal_lines = [
            "",
            "## Causal plan change",
            "",
            (arguments.run_dir / "plan-change.patch").read_text() or "No plan-text change.",
        ]
        risk_lines: list[str] = []
        source_change_path = arguments.run_dir / "plan-change.json"
    else:
        change = load_json(arguments.run_dir / "change.json")
        candidate_id = change["candidate_id"]
        lines = [
            f"# Code Revision Packet — {run['phase']}",
            "",
            "## Candidate",
            "",
            f"- Reviewed: `{change['reviewed_candidate_id']}`",
            f"- Current: `{candidate_id}`",
            f"- Rebase required: `{'yes' if change['rebase_required'] else 'no'}`",
            "",
            "## Authority",
            "",
        ]
        authority_change = change["authority_drift"]
        causal_lines = ["", "## Causal change", ""]
        if change["changed_files"]:
            for item in change["changed_files"]:
                causal_lines.append(
                    f"- `{item['path']}` — {item['change']} "
                    f"(`{item['before_sha256'] or 'absent'}` → "
                    f"`{item['after_sha256'] or 'absent'}`)"
                )
        else:
            causal_lines.append("- None.")
        risk_lines = [
            "",
            f"- Risk tags: {', '.join(change['risk_tags']) or 'none declared'}",
            f"- New risk tags: {', '.join(change['new_risk_tags']) or 'none'}",
            f"- Selected tests: {', '.join(change['selected_tests']) or 'none recorded'}",
            f"- Selection reason: {change['selection_reason']}",
            "- Focused gate: "
            f"{change['gate_status']['focused']}"
            + (f" ({change['gate_status']['reason']})" if change["gate_status"]["reason"] else ""),
            "- Falsifiers: "
            + (
                "; ".join(f"{item['test']} ← {item['mutation']}" for item in change["falsifiers"])
                or "none named"
            ),
        ]
        source_change_path = arguments.run_dir / "change.json"
    for item in authority["authorities"]:
        locator = f" — {item['locator']}" if item["locator"] else ""
        lines.append(f"- `{item['path']}` @ `{item['content_sha256']}`{locator}")
    if authority_change:
        lines.extend(["", "### Authority drift"])
        for item in authority_change:
            lines.append(
                f"- `{item['path']}`: `{item['captured_sha256']}` → `{item['current_sha256']}`"
            )
    lines.extend(causal_lines)
    lines.extend(risk_lines)
    lines.extend(["", "## Unresolved findings", ""])
    if unresolved:
        for item in unresolved:
            lines.extend(
                [
                    f"### {item['id']} — {item['severity']} / {item['state']}",
                    "",
                    f"- Authority: {item['authority']}",
                    f"- Evidence: {item['evidence']}",
                    f"- Required outcome: {item['required_outcome']}",
                    f"- Affected paths: {', '.join(item['affected_paths']) or 'none'}",
                    f"- Classification: {item['classification']}",
                    "",
                ]
            )
    else:
        lines.append("- None.")
    if arguments.kind == "code":
        change = load_json(arguments.run_dir / "change.json")
        lines.extend(
            [
                "",
                "## Failure analysis",
                "",
                change["failure_analysis"] or "- None (initial implementation).",
            ]
        )
    lines.extend(["", "## Gate evidence", ""])
    if gates:
        for gate in gates:
            lines.append(
                f"- `{gate['command']}` @ `{gate['candidate_id']}`: "
                f"exit {gate['exit_code']}, warnings {gate['warning_count']}"
            )
    else:
        lines.append("- None recorded.")
    lines.extend(
        [
            "",
            "## Omission rules",
            "",
            "- Closed, rejected-with-evidence, and superseded findings are omitted.",
            "- Unchanged authority content is referenced by path, locator, and hash.",
            "- Unchanged candidate files are omitted.",
            "- Original repository files remain authoritative and may be read on demand.",
            "",
        ]
    )
    text = "\n".join(lines)
    arguments.output.parent.mkdir(parents=True, exist_ok=True)
    arguments.output.write_text(text)
    packet_record = {
        "schema_version": SCHEMA_VERSION,
        "created_at": now(),
        "kind": arguments.kind,
        "candidate_id": candidate_id,
        "product_candidate_id": (
            plan_change["product_candidate_id"]
            if arguments.kind == "plan"
            else change["product_candidate_id"]
        ),
        "bytes": len(text.encode()),
        "sha256": hashlib.sha256(text.encode()).hexdigest(),
        "source_sha256": {
            "authority": source_digest(arguments.run_dir / "authority.json"),
            "change": source_digest(source_change_path),
            "findings": source_digest(arguments.run_dir / "findings.json"),
            "gates": source_digest(gates_path),
        },
        "unresolved_findings": len(unresolved),
    }
    append_jsonl(arguments.run_dir / "packets.jsonl", packet_record)
    print(packet_record["sha256"])


def command_validate(arguments: argparse.Namespace) -> None:
    run = validate_run_dir(arguments.run_dir)
    root = Path(run["repository_root"])
    authority = load_json(arguments.run_dir / "authority.json")
    if (
        not isinstance(authority, dict)
        or authority.get("schema_version") != SCHEMA_VERSION
        or not isinstance(authority.get("authorities"), list)
    ):
        raise EvidenceError("invalid authority manifest schema")
    for priority, item in enumerate(authority["authorities"], 1):
        if not isinstance(item, dict) or item.get("priority") != priority:
            raise EvidenceError("authority entries must have contiguous priority")
        authority_path = item.get("path")
        if (
            not isinstance(authority_path, str)
            or not authority_path
            or Path(authority_path).is_absolute()
            or ".." in Path(authority_path).parts
        ):
            raise EvidenceError("authority path must be repository-relative")
        validate_candidate_id(item.get("content_sha256"), f"authority hash for {authority_path}")
    validate_candidate_manifest(load_json(arguments.run_dir / "reviewed-candidate.json"))
    validate_candidate_manifest(load_json(arguments.run_dir / "reviewed-product-candidate.json"))
    findings = load_json(arguments.run_dir / "findings.json")
    if (
        not isinstance(findings, dict)
        or findings.get("schema_version") != SCHEMA_VERSION
        or not isinstance(findings.get("findings"), list)
        or not isinstance(findings.get("reopened_count"), int)
        or findings["reopened_count"] < 0
    ):
        raise EvidenceError("invalid finding ledger schema")
    for index, item in enumerate(findings.get("findings", [])):
        validate_finding(item, index)
    validate_kickoff_context(
        root,
        run["phase"],
        run["telemetry_trace_id"],
        run["telemetry_root_span_id"],
        open_required=arguments.require_final,
    )
    validate_role_spans(arguments.run_dir, run)
    # Unconditional, not `--require-final`. Convergence metrics are repairable
    # only while the trace is open, and checking them at `timing-summary` alone
    # let a run pass validation all night with unmeasured passes and discover
    # the gap after finalization, when the only "repair" left was re-ingesting
    # earlier artifacts and driving `verified -> open`.
    if run.get("evidence_lane") != "light":
        unmeasured = unmeasured_review_passes(arguments.run_dir, run)
        if unmeasured:
            named = ", ".join(
                f"{item['operation']}#{item['attempt']} (span {item['span_id']})"
                for item in unmeasured
            )
            raise EvidenceError(
                "review passes lack convergence metrics: "
                + named
                + ". Re-ingest each pass's findings with --review-span-id now, "
                "while this trace is still open. A span is immutable once the "
                "trace is finalized, after which the only sanctioned route is "
                "`attach-derived-metrics`, and that requires a recorded ingest "
                "refusal."
            )
    # Lane-independent, and unconditional for the same reason as the latch
    # above: a drift classification that has stopped holding must stop being
    # published while the run can still re-review, not at close.
    validate_candidate_drift(arguments.run_dir, run)
    change_path = arguments.run_dir / "change.json"
    if change_path.exists():
        change = load_json(change_path)
        if (
            not isinstance(change, dict)
            or change.get("schema_version") != SCHEMA_VERSION
            or not isinstance(change.get("changed_files"), list)
            or not isinstance(change.get("rebase_required"), bool)
        ):
            raise EvidenceError("invalid change manifest schema")
        validate_candidate_id(change.get("reviewed_candidate_id"), "reviewed candidate")
        validate_candidate_id(change.get("candidate_id"), "candidate")
        validate_candidate_id(
            change.get("reviewed_product_candidate_id"), "reviewed product candidate"
        )
        validate_candidate_id(change.get("product_candidate_id"), "product candidate")
        validate_string_list(change.get("risk_tags"), "change risk_tags")
        validate_string_list(change.get("new_risk_tags"), "change new_risk_tags")
        validate_string_list(change.get("selected_tests"), "change selected_tests")
        validate_relative_paths(
            change.get("intentionally_unchanged"),
            "change intentionally_unchanged",
        )
        if (
            not isinstance(change.get("selection_reason"), str)
            or not change["selection_reason"].strip()
        ):
            raise EvidenceError("change selection_reason must be nonempty text")
        if not isinstance(change.get("failure_analysis"), str):
            raise EvidenceError("change failure_analysis must be a string")
        for changed_file in change["changed_files"]:
            if not isinstance(changed_file, dict) or changed_file.get("change") not in {
                "added",
                "modified",
                "mode-changed",
                "deleted",
            }:
                raise EvidenceError("invalid changed-file record")
            validate_relative_paths([changed_file.get("path")], "changed-file path")
    plan_change_path = arguments.run_dir / "plan-change.json"
    if plan_change_path.exists():
        plan_change = load_json(plan_change_path)
        if plan_change.get("schema_version") != SCHEMA_VERSION:
            raise EvidenceError("invalid plan-change schema")
        validate_candidate_id(plan_change.get("candidate_id"), "plan candidate")
        validate_candidate_id(plan_change.get("product_candidate_id"), "plan product candidate")
        validate_candidate_id(plan_change.get("reviewed_plan_sha256"), "reviewed plan hash")
        validate_candidate_id(plan_change.get("plan_sha256"), "plan hash")
        validate_candidate_id(plan_change.get("delta_sha256"), "plan delta hash")
    ledgers: dict[str, list[dict[str, Any]]] = {}
    for ledger_name in ("gates.jsonl", "packets.jsonl"):
        records: list[dict[str, Any]] = []
        for line_number, line in enumerate(
            (arguments.run_dir / ledger_name).read_text().splitlines(), 1
        ):
            try:
                record = json.loads(line)
            except json.JSONDecodeError as exc:
                raise EvidenceError(
                    f"invalid JSON in {ledger_name} line {line_number}: {exc}"
                ) from exc
            if not isinstance(record, dict) or record.get("schema_version") != SCHEMA_VERSION:
                raise EvidenceError(f"invalid record schema in {ledger_name} line {line_number}")
            validate_candidate_id(
                record.get("candidate_id"),
                f"candidate in {ledger_name} line {line_number}",
            )
            if ledger_name == "packets.jsonl":
                validate_candidate_id(
                    record.get("product_candidate_id"),
                    f"product candidate in {ledger_name} line {line_number}",
                )
            records.append(record)
        ledgers[ledger_name] = records
    for line_number, gate in enumerate(ledgers["gates.jsonl"], 1):
        validate_gate_record(gate, run, root, label=f"gates.jsonl line {line_number}")
        artifact_hash = gate.get("artifact_sha256")
        if artifact_hash is not None:
            validate_candidate_id(artifact_hash, f"artifact hash in gates.jsonl line {line_number}")
    validate_gate_span_join(ledgers["gates.jsonl"], run, root)
    active_manifest = active_gate_manifest(arguments.run_dir)
    if run["evidence_lane"] == "full":
        for gate in ledgers["gates.jsonl"]:
            if gate["operation"] != "gate.imported" and gate["command_manifest_sha256"] is None:
                raise EvidenceError("managed full-lane gate lacks an admitting command manifest")
    for line_number, packet in enumerate(ledgers["packets.jsonl"], 1):
        if (
            packet.get("kind") not in {"plan", "code"}
            or not isinstance(packet.get("bytes"), int)
            or packet["bytes"] < 0
            or not isinstance(packet.get("unresolved_findings"), int)
            or packet["unresolved_findings"] < 0
        ):
            raise EvidenceError(f"invalid packet record in packets.jsonl line {line_number}")
        validate_candidate_id(packet.get("sha256"), "packet hash")
        source_hashes = packet.get("source_sha256")
        if not isinstance(source_hashes, dict):
            raise EvidenceError(f"invalid packet sources in packets.jsonl line {line_number}")
        for label, source_hash in source_hashes.items():
            validate_candidate_id(source_hash, f"packet source hash {label}")
    if root != git_root(root):
        raise EvidenceError("recorded repository root no longer resolves to itself")
    if arguments.require_final:
        if run["evidence_lane"] == "full" and active_manifest is None:
            raise EvidenceError("full-lane final validation requires a gate manifest")
        validate_role_preflight_receipt(arguments.run_dir, root)
        validate_preclose_telemetry(run, arguments.run_dir, root)
        blocking_states = {"open", "addressed", "blocked-owner"}
        blocking_findings = [
            item["id"] for item in findings["findings"] if item["state"] in blocking_states
        ]
        if blocking_findings:
            raise EvidenceError(
                "phase-close findings remain unresolved: " + ", ".join(blocking_findings)
            )
        current_id = tree_manifest(root)["candidate_id"]
        successful_final = [
            gate
            for gate in ledgers["gates.jsonl"]
            if gate["final"]
            and gate["telemetry_complete"]
            and gate["candidate_id"] == current_id
            and gate["candidate_after_id"] == current_id
            and gate["product_candidate_id"] == gate["product_candidate_after_id"]
            and gate["exit_code"] == 0
            and gate["outcome"] == "success"
        ]
        if not successful_final:
            raise EvidenceError("no successful final gate is recorded for the current candidate")
        if arguments.required_final_command and not any(
            gate["command"] == arguments.required_final_command for gate in successful_final
        ):
            raise EvidenceError(
                "required final command is not recorded successfully for the current candidate"
            )
        if active_manifest is not None and not any(
            gate["command_manifest_sha256"] == active_manifest[1] for gate in successful_final
        ):
            raise EvidenceError(
                "current successful final gate is not bound to the active command manifest"
            )
    print("EVIDENCE VALID")


def add_run_dir(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--run-dir", type=Path, required=True)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="action", required=True)

    init = subparsers.add_parser("init")
    init.add_argument("--run-dir", type=Path, required=True)
    init.add_argument("--root", type=Path, default=Path.cwd())
    init.add_argument("--phase", required=True)
    init.add_argument("--authority", action="append", default=[])
    init.add_argument("--telemetry-trace-id", required=True)
    init.add_argument("--telemetry-root-span-id", required=True)
    init.add_argument("--initial-orchestration-span-id", required=True)
    init.add_argument("--preflight-receipt", type=Path, required=True)
    init.add_argument("--review-lane", choices=sorted(REVIEW_LANES), required=True)
    init.add_argument("--evidence-lane", choices=sorted(EVIDENCE_LANES), required=True)
    init.add_argument("--follow-up-route", choices=sorted(FOLLOW_UP_ROUTES), required=True)
    init.set_defaults(handler=command_init)

    register = subparsers.add_parser("register-role-attempt")
    add_run_dir(register)
    register.add_argument("--operation", choices=sorted(ROLE_OPERATIONS), required=True)
    register.add_argument("--attempt", type=int, required=True)
    register.add_argument("--role", choices=sorted(ROLE_OPERATIONS.values()), required=True)
    register.add_argument("--harness", choices=sorted(ROLE_HARNESSES), required=True)
    register.add_argument("--model")
    register.add_argument("--effort")
    register.add_argument("--reason", choices=sorted(ROLE_REASONS), required=True)
    register.add_argument("--output", type=Path, required=True)
    register.set_defaults(handler=command_register_role_attempt)

    role_validate = subparsers.add_parser("validate-role-attempt")
    add_run_dir(role_validate)
    role_validate.add_argument("--registration", type=Path, required=True)
    role_validate.set_defaults(handler=command_validate_role_attempt)

    recipe = subparsers.add_parser(
        "span-recipe",
        description=(
            "Print the exact execution-telemetry start argv for a native role "
            "attempt's intelligence and wait spans, so the pair cannot be "
            "hand-built with mismatched routing metadata."
        ),
    )
    add_run_dir(recipe)
    recipe.add_argument("--registration", type=Path, required=True)
    recipe.add_argument("--intelligence-span-id")
    recipe.set_defaults(handler=command_span_recipe)

    incomplete = subparsers.add_parser(
        "record-telemetry-incomplete",
        description=(
            "Own a wait-span join defect in writing. A closed span is "
            "immutable, so a malformed one cannot be repaired; declaring the "
            "exact span and the exact missing fields lets validation report "
            "the attempt as telemetry-incomplete instead of refusing forever. "
            "An undeclared or absent join still fails."
        ),
    )
    add_run_dir(incomplete)
    incomplete.add_argument("--operation", choices=sorted(ROLE_OPERATIONS), required=True)
    incomplete.add_argument("--attempt", type=int, required=True)
    incomplete.add_argument("--span-id", required=True)
    incomplete.add_argument(
        "--missing-field",
        action="append",
        choices=TELEMETRY_INCOMPLETE_FIELDS,
        required=True,
    )
    incomplete.add_argument("--cause", required=True)
    incomplete.set_defaults(handler=command_record_telemetry_incomplete)

    derived = subparsers.add_parser(
        "attach-derived-metrics",
        description=(
            "Record convergence metrics for a review pass that succeeded and "
            "whose finding batch was then structurally refused. The record is "
            "an overlay in derived-metrics.jsonl, never a span attach: a "
            "finalized span is immutable, and a derived number must stay "
            "visibly derived. Both integers are computed from the refused "
            "artifact and the ingest journal's recorded pre-merge ledger, and "
            "`validate` recomputes and compares them — they are never operator "
            "inputs."
        ),
    )
    add_run_dir(derived)
    derived.add_argument("--operation", choices=sorted(REVIEW_OPERATIONS), required=True)
    derived.add_argument("--attempt", type=int, required=True)
    derived.add_argument("--span-id", required=True)
    derived.add_argument("--refusal-class", choices=sorted(DERIVED_REFUSAL_CLASSES), required=True)
    derived.add_argument("--refused-artifact", type=Path, required=True)
    derived.add_argument("--corroborating-artifact", type=Path)
    derived.add_argument(
        "--id-map",
        action="append",
        default=[],
        metavar="SOURCE=TARGET",
        help=(
            "required exactly for --refusal-class finding-id-format: the valid "
            "finding id each malformed one stands for"
        ),
    )
    derived.add_argument("--cause", required=True)
    derived.set_defaults(handler=command_attach_derived_metrics)

    repin = subparsers.add_parser(
        "repin-tools",
        description=(
            "Re-pin a run's tool bundle to the current tree. For a repair the "
            "active run itself needs; prints both manifest digests."
        ),
    )
    add_run_dir(repin)
    repin.set_defaults(handler=command_repin_tools)

    dispatch = subparsers.add_parser("record-role-dispatch")
    add_run_dir(dispatch)
    dispatch.add_argument("--registration", type=Path, required=True)
    dispatch.add_argument("--state", choices=("opened", "accepted", "rejected"), required=True)
    dispatch.add_argument(
        "--idle-telemetry",
        choices=("available", "unavailable", "not-dispatched"),
        required=True,
    )
    dispatch.add_argument("--intelligence-span-id")
    dispatch.add_argument("--wait-span-id")
    dispatch.add_argument(
        "--no-open-row",
        metavar="REASON",
        help=(
            "record a terminal dispatch without a preceding opened row only "
            "for a legitimate exception; the omission and reason are appended "
            "to dispatch-open-omitted.jsonl"
        ),
    )
    dispatch.add_argument(
        "--dispatch-candidate",
        help=(
            "the candidate the role was actually dispatched against, as printed "
            "by `current-candidate` immediately before the dispatch. Recording "
            "it is what makes a candidate that moves mid-dispatch detectable at "
            "the seam, and it is the precondition for `accept-candidate-drift`."
        ),
    )
    dispatch.set_defaults(handler=command_record_role_dispatch)

    drift = subparsers.add_parser(
        "accept-candidate-drift",
        description=(
            "Record one dispatch's candidate drift as proven disjoint from the "
            "review it ran under. Requires the dispatch to have recorded both "
            "candidates; classifies the paths that moved against the partition "
            "declared in policies/orchestration-evidence.md, the reviewed "
            "surface, and the declared authorities, all three independently and "
            "all fail-closed. It relaxes `resolved_in` and nothing else."
        ),
    )
    add_run_dir(drift)
    drift.add_argument("--operation", choices=sorted(ROLE_OPERATIONS), required=True)
    drift.add_argument("--attempt", type=int, required=True)
    drift.add_argument("--cause", required=True)
    drift.set_defaults(handler=command_accept_candidate_drift)

    capture = subparsers.add_parser("capture-change")
    add_run_dir(capture)
    capture.add_argument("--risk-tag", action="append", default=[])
    capture.add_argument("--test", action="append", default=[])
    capture.add_argument("--unchanged", action="append", default=[])
    capture.add_argument("--rebase-reason", action="append", default=[])
    capture.add_argument("--selection-reason")
    capture.add_argument("--failure-analysis", default="")
    capture.add_argument("--gate-status", choices=sorted(GATE_STATUSES), default="not-run")
    capture.add_argument("--gate-reason", default="gate status not supplied on the command line")
    capture_metadata = capture.add_mutually_exclusive_group()
    capture_metadata.add_argument("--metadata", type=Path)
    capture_metadata.add_argument("--metadata-artifact", type=Path)
    capture.set_defaults(handler=command_capture_change)

    reviewed = subparsers.add_parser("mark-reviewed")
    add_run_dir(reviewed)
    reviewed.add_argument("--expected-candidate")
    reviewed.set_defaults(handler=command_mark_reviewed)

    plan = subparsers.add_parser("capture-plan")
    add_run_dir(plan)
    plan.add_argument("--plan", type=Path, required=True)
    plan.add_argument("--rebase-reason", action="append", default=[])
    plan.set_defaults(handler=command_capture_plan)

    plan_reviewed = subparsers.add_parser("mark-plan-reviewed")
    add_run_dir(plan_reviewed)
    plan_reviewed.add_argument("--plan", type=Path, required=True)
    plan_reviewed.add_argument("--expected-plan")
    plan_reviewed.set_defaults(handler=command_mark_plan_reviewed)

    current_candidate = subparsers.add_parser(
        "current-candidate",
        description=(
            "Recompute the candidate now, record it in the run's lineage, and "
            "print it. Call this immediately before a role dispatch: the "
            "init-time id is stale by construction, because the marker flip and "
            "the START log block both change the tree."
        ),
    )
    add_run_dir(current_candidate)
    current_candidate.add_argument("--reason", default="dispatch")
    current_candidate.set_defaults(handler=command_current_candidate)

    schema = subparsers.add_parser(
        "schema",
        description=(
            "Print the review-artifact JSON Schema derived from this tool's own "
            "closed sets. The venue boundary constrains generation with it; this "
            "validator still checks what a strict schema subset cannot express."
        ),
    )
    schema.add_argument("--kind", choices=sorted(REVIEW_KINDS), required=True)
    schema.add_argument("--output", type=Path)
    schema.set_defaults(handler=command_schema)

    findings = subparsers.add_parser("ingest-findings")
    add_run_dir(findings)
    findings.add_argument("--kind", choices=("plan", "code"), required=True)
    findings.add_argument("--candidate", required=True)
    findings.add_argument("--review-span-id")
    findings.add_argument(
        "--no-review-span",
        metavar="REASON",
        help=(
            "record this ingest WITHOUT review convergence metrics, for an "
            "ingest that is not a review pass and has no intelligence span. "
            "The omission and its reason are appended to "
            "review-metrics-omitted.jsonl."
        ),
    )
    finding_source = findings.add_mutually_exclusive_group(required=True)
    finding_source.add_argument("--input", type=Path)
    finding_source.add_argument("--artifact", type=Path)
    findings.set_defaults(handler=command_ingest_findings)

    gate = subparsers.add_parser("record-gate")
    add_run_dir(gate)
    gate.add_argument("--candidate", required=True)
    gate.add_argument("--selection-reason", required=True)
    gate.add_argument("--exit-code", type=int, required=True)
    gate.add_argument("--warning-count", type=int, required=True)
    gate.add_argument("--artifact", type=Path)
    gate.add_argument("--final", action="store_true")
    gate.add_argument("argv", nargs=argparse.REMAINDER)
    gate.set_defaults(handler=command_record_gate)

    run_gate = subparsers.add_parser("run-gate")
    add_run_dir(run_gate)
    run_gate.add_argument("--candidate", required=True)
    run_gate.add_argument("--operation", required=True)
    run_gate.add_argument("--attempt", type=int, default=1)
    run_gate.add_argument("--selection-reason", required=True)
    run_gate.add_argument("--warning-count", type=int, required=True)
    run_gate.add_argument("--artifact", type=Path)
    run_gate.add_argument("--timeout-seconds", type=float)
    run_gate.add_argument("--final", action="store_true")
    run_gate.add_argument("argv", nargs=argparse.REMAINDER)
    run_gate.set_defaults(handler=command_run_gate)

    activate_manifest = subparsers.add_parser(
        "activate-gate-manifest",
        description="Validate and activate one immutable hash-bound command manifest.",
    )
    add_run_dir(activate_manifest)
    activate_manifest.add_argument("--manifest", type=Path, required=True)
    activate_manifest.add_argument("--supersedes")
    activate_manifest.set_defaults(handler=command_activate_gate_manifest)

    validate_preflight = subparsers.add_parser(
        "validate-preflight",
        description="Validate manifest, venue receipt, and pre-acceptance topology.",
    )
    add_run_dir(validate_preflight)
    validate_preflight.set_defaults(handler=command_validate_preflight)

    packet = subparsers.add_parser("packet")
    add_run_dir(packet)
    packet.add_argument("--kind", choices=("plan", "code"), required=True)
    packet.add_argument("--output", type=Path, required=True)
    packet.set_defaults(handler=command_packet)

    validate = subparsers.add_parser("validate")
    add_run_dir(validate)
    validate.add_argument("--require-final", action="store_true")
    validate.add_argument("--required-final-command")
    validate.set_defaults(handler=command_validate)

    timing = subparsers.add_parser("timing-summary")
    add_run_dir(timing)
    timing.add_argument("--format", choices=("markdown", "json"), default="markdown")
    timing.set_defaults(handler=command_timing_summary)
    return parser


def main() -> int:
    arguments = build_parser().parse_args()
    try:
        arguments.handler(arguments)
    except (AttributeError, EvidenceError, KeyError, OSError, TypeError) as exc:
        print(f"kickoff-evidence: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
