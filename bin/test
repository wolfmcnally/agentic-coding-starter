#!/usr/bin/env bash
# Canonical repository test entry point.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
project_root="$repo_root/project"

usage() {
  cat <<'EOF'
Usage: ./bin/test [pytest arguments...]

Run the full repository test suite. When arguments are supplied, forward them
to pytest for focused testing; paths are interpreted relative to the repo root.
EOF
}

if [[ $# -eq 1 && ( "$1" == "--help" || "$1" == "-h" ) ]]; then
  usage
  exit 0
fi

if ! command -v uv >/dev/null 2>&1; then
  echo "TEST ERROR missing prerequisite: uv" >&2
  exit 1
fi

for required_path in \
  "$project_root/.python-version" \
  "$project_root/pyproject.toml" \
  "$project_root/uv.lock"; do
  if [[ ! -f "$required_path" ]]; then
    echo "TEST ERROR missing required file: ${required_path#"$repo_root/"}" >&2
    exit 1
  fi
done

cd "$repo_root"
if [[ $# -eq 0 ]]; then
  exec uv run --project "$project_root" --locked --managed-python \
    python -m pytest -q project/tests tests
fi

exec uv run --project "$project_root" --locked --managed-python \
  python -m pytest "$@"
